{
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/pvgis-proxy",
      "destination": "/api/pvgis-proxy"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}