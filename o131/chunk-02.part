<style id="fve-k5aa-full-width-protocol-preview">
body.print-preview-open #pdfPreviewModal{padding:12px!important;}
body.print-preview-open #pdfPreviewModal > .modal{width:calc(100vw - 24px)!important;max-width:calc(100vw - 24px)!important;height:calc(100vh - 24px)!important;max-height:calc(100vh - 24px)!important;margin:0!important;padding:12px!important;overflow:auto!important;}
body.print-preview-open #printPreviewContent{display:block!important;width:100%!important;max-width:none!important;min-width:0!important;margin:0!important;padding:12px!important;overflow-x:auto!important;}
body.print-preview-open #printPreviewContent #fveK5RProtocol{width:100%!important;max-width:none!important;margin:0!important;}
@media(max-width:700px){body.print-preview-open #pdfPreviewModal{padding:6px!important;}body.print-preview-open #pdfPreviewModal > .modal{width:calc(100vw - 12px)!important;max-width:calc(100vw - 12px)!important;height:calc(100vh - 12px)!important;max-height:calc(100vh - 12px)!important;padding:8px!important;}body.print-preview-open #printPreviewContent{padding:6px!important;}}
@media print{#fveK5RProtocol{width:196mm!important;max-width:100%!important;margin:0 auto!important;}}
</style>
<style id="fve-k5bu-user-guide-css">
#fveUserGuideModal{z-index:12050!important;padding:10px!important;}
#fveUserGuideModal .fve-user-guide-window{
  width:calc(100vw - 20px)!important;
  max-width:1400px!important;
  height:calc(100vh - 20px)!important;
  max-height:none!important;
  padding:10px!important;
  display:flex!important;
  flex-direction:column!important;
  overflow:hidden!important;
}
#fveUserGuideModal .fve-user-guide-header{
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  gap:12px!important;
  margin-bottom:8px!important;
}
#fveUserGuideModal .fve-user-guide-title{font-size:20px!important;font-weight:900!important;color:#14532d!important;}
#fveUserGuideModal .fve-user-guide-actions{display:flex!important;gap:8px!important;flex-wrap:wrap!important;justify-content:flex-end!important;}
#fveUserGuideFrame{display:block!important;width:100%!important;min-height:0!important;flex:1 1 auto!important;border:1px solid #cbd5e1!important;border-radius:8px!important;background:#fff!important;}
@media(max-width:700px){
  #fveUserGuideModal{padding:4px!important;}
