</style>
<script id="fve-regulator-auto-fields-neutral-classer">
(function(){
  const pairs = [
    ['regCurrentMode','regulatorCurrentA'],
    ['maxVocMode','maxVoc'],
    ['regMaxPvWpMode','regMaxPvWp'],
    ['mpptMinMode','mpptMinV'],
    ['mpptMaxMode','mpptMaxV']
  ];
  function isEmptyInput(el){
    return !el || String(el.value || '').trim() === '';
  }
  function syncRegAutoWaitingFields(){
    pairs.forEach(function(pair){
      const mode = document.getElementById(pair[0]);
      const field = document.getElementById(pair[1]);
      if(!field) return;
      const auto = !mode || String(mode.value || 'auto').toLowerCase() === 'auto';
      const waiting = auto && isEmptyInput(field);
      field.classList.toggle('fve-reg-auto-waiting', waiting);
      if(waiting){
        field.classList.remove('ok','good','warn','bad','valid','invalid','warning','error');
      }
    });
  }
  window.fveSyncRegulatorAutoWaitingFields = syncRegAutoWaitingFields;
  function bind(){
    syncRegAutoWaitingFields();
    pairs.forEach(function(pair){
      pair.forEach(function(id){
        const el = document.getElementById(id);
        if(!el || el.dataset.fveRegAutoNeutralBound === '1') return;
        el.dataset.fveRegAutoNeutralBound = '1';
        ['input','change','blur'].forEach(function(evt){ el.addEventListener(evt, syncRegAutoWaitingFields, true); });
      });
    });
    document.addEventListener('input', syncRegAutoWaitingFields, true);
    document.addEventListener('change', syncRegAutoWaitingFields, true);
    setTimeout(syncRegAutoWaitingFields, 0);
    setTimeout(syncRegAutoWaitingFields, 250);
    setTimeout(syncRegAutoWaitingFields, 900);
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind, {once:true});
  else bind();
})();
</script>
<!-- OPRAVA 22: přepínač nápověd jako malé pole vedle ikony menu; mimo rozbalovací menu, bez podbarvení. -->
