<style id="fve-k16c359-pdf-alignment-css">
/* K16C359: pouze PDF/Tisk protokol, základ K16C357. */

/* Vysvětlující věta pod stavem začíná ve stejné ose jako text spodních odrážek. */
#fveK5RProtocol .r-offgrid-status > span,
#fveK5RProtocol .r-offgrid-status > div,
#fveK5RProtocol .r-customer-status > span,
#fveK5RProtocol .r-customer-status > div{
  display:block!important;
  padding-left:5mm!important;
  box-sizing:border-box!important;
}

/* Ceny: pravý okraj je autorita; tabulkové číslice drží poslední číslo v jedné svislici. */
#fveK5RProtocol .r-price,
#fveK5RProtocol .r-product-price,
#fveK5RProtocol .r-product-price-row,
#fveK5RProtocol [class*="price"]{
  font-variant-numeric:tabular-nums lining-nums!important;
}
#fveK5RProtocol .r-product-price-row{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) max-content!important;
  column-gap:3mm!important;
  align-items:baseline!important;
  width:100%!important;
}
#fveK5RProtocol .r-product-price-row > :last-child,
#fveK5RProtocol .r-price,
#fveK5RProtocol .r-product-price{
  text-align:right!important;
  justify-self:end!important;
  white-space:nowrap!important;
  min-width:26mm!important;
}

/* Stejné pravidlo i pro cenu vytvořenou jako běžný řádek/tabulku v produktové kartě. */
#fveK5RProtocol table td:last-child{
  font-variant-numeric:tabular-nums lining-nums!important;
}
#fveK5RProtocol tr.r-price-row td:last-child,
#fveK5RProtocol tr[class*="price"] td:last-child{
  text-align:right!important;
  white-space:nowrap!important;
}
@media print{
  body.print-protocol #fveK5RProtocol .r-offgrid-status > span,
  body.print-protocol #fveK5RProtocol .r-offgrid-status > div,
  body.print-protocol #fveK5RProtocol .r-customer-status > span,
  body.print-protocol #fveK5RProtocol .r-customer-status > div{
    padding-left:5mm!important;
  }
}
