}
.battery-diagnostics-end-panel .battery-bms-check.ok{color:#4f5f55!important}
.battery-diagnostics-end-panel .battery-bms-check.info{color:#526274!important}
.battery-diagnostics-end-panel .battery-bms-check.warn{color:#8a5a16!important}
