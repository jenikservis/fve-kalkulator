<style id="fve-k5f-mobile-layout-audit">
@media (max-width:520px){
  html,body{max-width:100%!important;overflow-x:hidden!important;}
  html body:not(.print-protocol) h1{font-size:19px!important;line-height:1.15!important;padding-right:112px!important;}
  html body:not(.print-protocol) .orientation-visual,
