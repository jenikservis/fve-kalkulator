<style id="fve-k16c811-water-energy-cables-unify">
/* K16C811: OHŘEV – Energetická bilance + Kabely a jištění sjednoceny do stejného výsledkového systému jako Ostrov,
   bez změny gridu celé výsledkové stránky. */
