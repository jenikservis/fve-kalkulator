#fveK6RWater .k10w-energy-grid span{min-width:0;color:#334155}
#fveK6RWater .k10w-energy-grid b{min-width:0;text-align:right;color:#111827;word-break:normal;overflow-wrap:break-word}
#fveK6RWater .k10w-coverage-note{margin-top:10px;padding:10px;border-radius:8px;background:#f8fafc;color:#475569;font-size:11px;line-height:1.5}
@media(max-width:700px){
  #fveK6RWater .k10w-energy-grid>div{grid-template-columns:minmax(0,55%) minmax(0,45%)!important}
  #fveK6RWater .k10w-energy-grid b{display:block!important;visibility:visible!important;opacity:1!important;-webkit-text-fill-color:#111827!important}
  #fveK6RWater #wK10NCharts{display:block!important}
  #fveK6RWater #wK10NCharts .k10n-chart-grid{grid-template-columns:1fr!important}
}
</style>
<style id="fve-k10y-table-alignment">
/* K10Y: jednotné tabulky – text vlevo, hodnoty vpravo, bez zalamování. */
#fveK6RWater table,
#fveK6RWater .k8s-result-table,
#fveK6RWater .k8r-water-param-table{
  width:100%!important;
  table-layout:fixed!important;
  border-collapse:collapse!important;
}
#fveK6RWater table tr,
#fveK6RWater .k8s-result-table tr,
#fveK6RWater .k8r-water-param-table tr{
  min-height:42px!important;
}
#fveK6RWater table td,
#fveK6RWater table th,
#fveK6RWater .k8s-result-table td,
#fveK6RWater .k8r-water-param-table td{
  vertical-align:middle!important;
  box-sizing:border-box!important;
  white-space:nowrap!important;
  word-break:normal!important;
  overflow-wrap:normal!important;
  hyphens:none!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
}
#fveK6RWater table td:first-child,
#fveK6RWater .k8s-result-table td:first-child,
#fveK6RWater .k8r-water-param-table td.k8r-water-label{
  width:56%!important;
  text-align:left!important;
}
#fveK6RWater table td:last-child,
#fveK6RWater .k8s-result-table td:last-child,
#fveK6RWater .k8r-water-param-table td.k8r-water-value-cell{
  width:44%!important;
  text-align:right!important;
  font-weight:700!important;
}
#fveK6RWater .k8r-water-value{
  display:block!important;
  width:100%!important;
  white-space:nowrap!important;
  word-break:normal!important;
  overflow-wrap:normal!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
  text-align:right!important;
}

/* Energetická bilance používá vlastní grid. */
#fveK6RWater .k10w-energy-grid>div{
  display:grid!important;
  grid-template-columns:minmax(0,56%) minmax(0,44%)!important;
  align-items:center!important;
  gap:10px!important;
}
#fveK6RWater .k10w-energy-grid span,
#fveK6RWater .k10w-energy-grid b{
  white-space:nowrap!important;
  word-break:normal!important;
  overflow-wrap:normal!important;
  hyphens:none!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
}
#fveK6RWater .k10w-energy-grid span{text-align:left!important}
#fveK6RWater .k10w-energy-grid b{text-align:right!important}

/* Mobil: pořád dva sloupce, bez rozsekávání slov. */
@media(max-width:700px){
  #fveK6RWater table,
  #fveK6RWater .k8s-result-table,
  #fveK6RWater .k8r-water-param-table{
    display:table!important;
    width:100%!important;
    table-layout:fixed!important;
  }
  #fveK6RWater table tbody,
  #fveK6RWater .k8s-result-table tbody,
  #fveK6RWater .k8r-water-param-table tbody{
    display:table-row-group!important;
  }
  #fveK6RWater table tr,
  #fveK6RWater .k8s-result-table tr,
  #fveK6RWater .k8r-water-param-table tr{
    display:table-row!important;
  }
  #fveK6RWater table td,
  #fveK6RWater .k8s-result-table td,
  #fveK6RWater .k8r-water-param-table td{
    display:table-cell!important;
    padding:9px 8px!important;
    white-space:nowrap!important;
    word-break:normal!important;
    overflow-wrap:normal!important;
    hyphens:none!important;
    overflow:hidden!important;
    text-overflow:ellipsis!important;
  }
  #fveK6RWater table td:first-child,
  #fveK6RWater .k8s-result-table td:first-child,
  #fveK6RWater .k8r-water-param-table td.k8r-water-label{
    width:58%!important;
    text-align:left!important;
  }
  #fveK6RWater table td:last-child,
  #fveK6RWater .k8s-result-table td:last-child,
  #fveK6RWater .k8r-water-param-table td.k8r-water-value-cell{
    width:42%!important;
    text-align:right!important;
  }
  #fveK6RWater .k10w-energy-grid>div{
    grid-template-columns:minmax(0,58%) minmax(0,42%)!important;
  }
}
</style>
<style id="fve-k11a-xml-info-position">
#fveK6RWater #k10oXmlInfo{
  margin:2px 0 0!important;
  max-width:none!important;
  width:100%!important;
}
#fveK6RWater #k10oXmlInfo + .fve-water-card{
  margin-top:-2px!important;
}
@media(max-width:700px){
  #fveK6RWater #k10oXmlInfo{
    margin:2px 0 0!important;
  }
}
</style>
<style id="fve-k12a-engine-css">
#fveK6RWater.k12a-engine-active #wWaterResultsTitle{display:block!important}
#fveK6RWater.k12a-engine-active #wWaterResultsGrid{display:grid!important;visibility:visible!important;opacity:1!important}
#fveK6RWater .k12a-expert{margin:10px 0;border:1px solid #d7dee8;border-radius:10px;background:#fbfcfd}
#fveK6RWater .k12a-expert>summary{padding:10px 12px;font-weight:700;cursor:pointer}
#fveK6RWater .k12a-expert-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:0 12px 12px}
#fveK6RWater .k12a-row{display:grid;grid-template-columns:minmax(0,58%) minmax(0,42%);gap:10px;align-items:center;padding:8px 6px;border-bottom:1px solid #e5e7eb}
#fveK6RWater .k12a-row span,#fveK6RWater .k12a-row b{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;word-break:normal;overflow-wrap:normal}
#fveK6RWater .k12a-row b{text-align:right;color:#111827}
#fveK6RWater .k12a-state{padding:8px 10px;border-radius:8px;margin:5px 0;font-size:12px}
#fveK6RWater .k12a-state.ok{background:#eef8f1;border:1px solid #8fc4a2;color:#166534}
#fveK6RWater .k12a-state.warn{background:#fff8e8;border:1px solid #e2bb67;color:#854d0e}
#fveK6RWater .k12a-state.bad{background:#fff1f2;border:1px solid #e79aa4;color:#991b1b}
#fveK6RWater .k12a-summary{display:grid;gap:3px;padding:10px;border-radius:9px}
#fveK6RWater .k12a-summary.ok{background:#eef8f1}.k12a-summary.warn{background:#fff8e8}.k12a-summary.bad{background:#fff1f2}
#fveK6RWater .k12a-chart-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
#fveK6RWater .k12a-chart-grid>div{border:1px solid #d7dee8;border-radius:10px;padding:10px;min-width:0}
#fveK6RWater .k12a-chart-grid svg{display:block;width:100%;height:auto;min-height:210px}
#fveK6RWater .k12a-model-note{padding:10px;margin-top:10px;background:#f8fafc;border-radius:8px;color:#475569;font-size:11px}
#fveK6RWater .fve-fill-done:not(.fve-input-area-state){background:#eef8f1!important;border-color:#79b38e!important}
#fveK6RWater .fve-fill-active:not(.fve-input-area-state){background:#eef6ff!important;border-color:#72a8d8!important}
#fveK6RWater .fve-fill-empty:not(.fve-input-area-state){background:#fff!important}
@media(max-width:700px){
  #fveK6RWater .k12a-expert-grid,#fveK6RWater .k12a-chart-grid{grid-template-columns:1fr}
  #fveK6RWater .k12a-row{grid-template-columns:minmax(0,58%) minmax(0,42%)}
  #fveK6RWater .k12a-row span,#fveK6RWater .k12a-row b{white-space:nowrap!important;word-break:normal!important;overflow-wrap:normal!important}
}
</style>
<style id="fve-k12c-mobile-performance">
@media(max-width:700px){
  #fveK6RWater input:not(#k13eTimeRange):not(#k13eDate),
  #fveK6RWater select,
  #fveK6RWater textarea,
  #fveK6RWater .fve-water-card,
  #fveK6RWater .fve-water-field{
    transition:none!important;
    animation:none!important;
  }
  #fveK6RWater select{height:42px!important;min-height:42px!important;padding-top:0!important;padding-bottom:0!important}
#fveK6RWater input:not(#k13eTimeRange):not(#k13eDate):focus,
  #fveK6RWater select:focus,
  #fveK6RWater textarea:focus{
    transform:none!important;
  }
}
</style>
<style id="fve-k12g-auto-value-style">
#fveK6RWater .k12g-auto-value{
