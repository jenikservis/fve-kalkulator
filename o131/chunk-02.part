  line-height:1.25!important;
  font-weight:400!important;
  box-shadow:none!important;
  outline:none!important;
}

/* automatická pole, která ještě čekají na výpočet/vložení, nejsou zvýrazněná jako hotová ani jako chyba */
#regulatorCurrentA.fve-reg-auto-waiting,
#maxVoc.fve-reg-auto-waiting,
#regMaxPvWp.fve-reg-auto-waiting,
#mpptMinV.fve-reg-auto-waiting,
#mpptMaxV.fve-reg-auto-waiting,
#regulatorCurrentA:placeholder-shown,
