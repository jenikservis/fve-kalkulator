  background:#ffffff!important;
  background-color:#ffffff!important;
  color:#6b7280!important;
  -webkit-text-fill-color:#6b7280!important;
  border:1px solid #d1d5db!important;
  border-color:#d1d5db!important;
  opacity:1!important;
  filter:none!important;
  text-shadow:none!important;
}

/* readonly/disabled automatická pole musí zůstat vizuálně stejná jako ostatní bílá pole */
#regulatorCurrentA[readonly],
#maxVoc[readonly],
#regMaxPvWp[readonly],
#mpptMinV[readonly],
#mpptMaxV[readonly],
#regulatorCurrentA:disabled,
#maxVoc:disabled,
#regMaxPvWp:disabled,
#mpptMinV:disabled,
#mpptMaxV:disabled{
  background:#ffffff!important;
  background-color:#ffffff!important;
  opacity:1!important;
  cursor:pointer!important;
}

/* režimové selecty regulátoru sjednocené s ostatními selecty */
#regType,
#regDesignVariant,
#regCurrentMode,
#maxVocMode,
#regMaxPvWpMode,
#mpptMinMode,
#mpptMaxMode{
  background:#f8fafc!important;
  background-color:#f8fafc!important;
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
  border:1px solid #d1d5db!important;
  border-color:#d1d5db!important;
  border-radius:12px!important;
}

/* po skutečném vyplnění automatickou hodnotou zůstává bílé pozadí, další validace smí měnit jen rámeček/text */
#regulatorCurrentA:not(.fve-reg-auto-waiting),
#maxVoc:not(.fve-reg-auto-waiting),
#regMaxPvWp:not(.fve-reg-auto-waiting),
#mpptMinV:not(.fve-reg-auto-waiting),
#mpptMaxV:not(.fve-reg-auto-waiting){
  background:#ffffff!important;
  background-color:#ffffff!important;
  opacity:1!important;
}
</style>
