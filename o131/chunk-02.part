<style id="fve-k2ue-mobile-feed-items-full-height">
@media (max-width:700px){
  html body:not(.print-protocol) #fveV82FeedModal .fve-v82-modal{
    width:calc(100vw - 16px)!important;
    max-width:calc(100vw - 16px)!important;
    max-height:calc(100dvh - 16px)!important;
    margin:8px!important;
  }
  html body:not(.print-protocol) #fveV82FeedList{
    width:100%!important;
    max-width:100%!important;
    max-height:calc(100dvh - 120px)!important;
    padding:8px!important;
    gap:10px!important;
    overflow-y:auto!important;
    overflow-x:hidden!important;
    box-sizing:border-box!important;
  }
  html body:not(.print-protocol) #fveV82FeedList > .fve-v82-row,
  html body:not(.print-protocol) #fveV82FeedList > .fve-v82-row.fve-k2ex-feed-row,
  html body:not(.print-protocol) #fveV82FeedList > .fve-v82-row[data-fve-k2ex-card="1"]{
    display:grid!important;
    grid-template-columns:72px minmax(0,1fr)!important;
    grid-template-rows:auto auto!important;
    gap:8px 10px!important;
    width:100%!important;
    height:auto!important;
    min-height:0!important;
    max-height:none!important;
    padding:10px!important;
    overflow:visible!important;
    align-items:start!important;
    align-content:start!important;
    box-sizing:border-box!important;
  }
  html body:not(.print-protocol) #fveV82FeedList > .fve-v82-row .fve-k2ex-imgbox{
    grid-column:1!important;
    grid-row:1!important;
    width:64px!important;
    height:64px!important;
    min-width:64px!important;
    max-width:64px!important;
    min-height:64px!important;
    max-height:64px!important;
    align-self:start!important;
  }
  html body:not(.print-protocol) #fveV82FeedList > .fve-v82-row .fve-k2ex-imgbox img{
    max-width:58px!important;
    max-height:58px!important;
  }
  html body:not(.print-protocol) #fveV82FeedList > .fve-v82-row .fve-k2ex-main{
    grid-column:2!important;
    grid-row:1!important;
    min-width:0!important;
    width:100%!important;
    align-self:start!important;
  }
  html body:not(.print-protocol) #fveV82FeedList > .fve-v82-row .fve-k2ex-title{
    white-space:normal!important;
    overflow:visible!important;
    text-overflow:clip!important;
    max-height:none!important;
    line-height:1.3!important;
    margin:0 0 7px!important;
    overflow-wrap:anywhere!important;
  }
  html body:not(.print-protocol) #fveV82FeedList > .fve-v82-row .fve-k2ex-meta{
    display:flex!important;
    flex-wrap:wrap!important;
    max-height:none!important;
    overflow:visible!important;
    gap:5px!important;
  }
  html body:not(.print-protocol) #fveV82FeedList > .fve-v82-row .fve-k2ex-chip{
    height:auto!important;
    min-height:0!important;
    max-height:none!important;
    white-space:normal!important;
    overflow-wrap:anywhere!important;
  }
  html body:not(.print-protocol) #fveV82FeedList > .fve-v82-row .fve-k2ex-values{
    grid-column:1 / -1!important;
    grid-row:2!important;
    display:grid!important;
    grid-template-columns:1fr!important;
    grid-auto-rows:auto!important;
    width:100%!important;
    max-width:none!important;
    height:auto!important;
    min-height:0!important;
    max-height:none!important;
    overflow:visible!important;
    gap:6px!important;
  }
  html body:not(.print-protocol) #fveV82FeedList > .fve-v82-row .fve-k2ex-value,
  html body:not(.print-protocol) #fveV82FeedList > .fve-v82-row .fve-k2ex-value *{
    white-space:normal!important;
    overflow:visible!important;
    text-overflow:clip!important;
    overflow-wrap:anywhere!important;
  }
}
</style>
<style id="k2ui-neutral-empty-design-css">
