<style id="k2ps-battery-bms-style">
.battery-bms-professional-box{margin-top:12px;border:1px solid rgba(15,23,42,.16);border-radius:10px;background:rgba(255,255,255,.34);overflow:hidden}
.battery-bms-professional-box>summary,.battery-life-box>summary{cursor:pointer;font-weight:700;padding:12px 14px;list-style:none}
.battery-bms-professional-box>summary::-webkit-details-marker,.battery-life-box>summary::-webkit-details-marker{display:none}
.battery-bms-professional-grid{display:grid;grid-template-columns:minmax(220px,1fr) minmax(150px,.72fr);gap:8px 12px;padding:4px 14px 12px;align-items:center}
.battery-bms-professional-grid label{margin:0}
.battery-bms-current-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding:0 14px 12px}
.battery-bms-current-summary>div{display:flex;justify-content:space-between;gap:10px;padding:9px 10px;border:1px solid rgba(15,23,42,.12);border-radius:8px;background:rgba(255,255,255,.55)}
.battery-bms-professional-results{display:grid;gap:7px;padding:0 14px 12px}
.battery-bms-check{padding:9px 10px;border-radius:8px;border:1px solid rgba(15,23,42,.12);background:rgba(255,255,255,.55)}
.battery-bms-check.ok{background:#ecfdf5}.battery-bms-check.warn{background:#fff7ed}.battery-bms-check.bad{background:#fef2f2}
.battery-life-box{margin:0 14px 12px;border:1px solid rgba(15,23,42,.12);border-radius:8px;background:rgba(255,255,255,.35)}
.battery-life-result{margin:0 14px 14px;padding:10px;border-radius:8px;background:rgba(255,255,255,.6)}
@media(max-width:720px){.battery-bms-professional-grid{grid-template-columns:1fr}.battery-bms-current-summary{grid-template-columns:1fr}}
</style>
<style id="k2pu-battery-layout-style">
.battery-inline-card .component-main-panel,
.battery-inline-card .component-main-panel *,
.battery-settings-box,
.battery-settings-box *,
.battery-bms-professional-box,
.battery-bms-professional-box *{
  font-family:inherit !important;
  font-size:inherit;
  font-weight:inherit;
  line-height:inherit;
}
.battery-primary-section{display:grid;gap:8px}
.battery-capacity-row{display:grid;grid-template-columns:minmax(0,1fr) 90px;gap:8px}
.battery-summary-section{display:grid;gap:8px;margin-top:10px}
.battery-summary-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(120px,42%);gap:10px;align-items:center}
.battery-summary-row>span{font-weight:inherit}
.battery-summary-row input{margin:0}
.battery-settings-box,.battery-bms-professional-box,.battery-datasheet-box,.battery-life-box{margin-top:10px}
.battery-settings-box>summary,.battery-bms-professional-box>summary,.battery-datasheet-box>summary,.battery-life-box>summary{
  font-family:inherit!important;font-size:inherit!important;font-weight:inherit!important;line-height:inherit!important;
}
.battery-compact-grid,.battery-bank-layout{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.battery-compact-grid{grid-template-columns:minmax(0,1fr) minmax(0,1.2fr)}
.battery-bank-layout>div{display:grid;gap:5px}
.battery-bms-professional-grid{font-family:inherit!important;font-size:inherit!important;font-weight:inherit!important}
.battery-bms-current-summary span,.battery-bms-current-summary b,.battery-bms-check,.battery-life-result{font-family:inherit!important;font-size:inherit!important;font-weight:inherit!important}
@media(max-width:700px){.battery-summary-row,.battery-compact-grid,.battery-bank-layout{grid-template-columns:1fr}.battery-capacity-row{grid-template-columns:minmax(0,1fr) 82px}}
</style>
<style id="k2pv-battery-typography-final">
/* K2PV: Baterie používá přesně základní typografii vstupních tabulek. */
html body:not(.print-protocol) .battery-inline-card .component-main-panel,
html body:not(.print-protocol) .battery-inline-card .component-main-panel div,
html body:not(.print-protocol) .battery-inline-card .component-main-panel span,
html body:not(.print-protocol) .battery-inline-card .component-main-panel b,
html body:not(.print-protocol) .battery-inline-card .component-main-panel strong,
html body:not(.print-protocol) .battery-inline-card .component-main-panel summary,
html body:not(.print-protocol) .battery-inline-card .component-main-panel .small,
html body:not(.print-protocol) .battery-inline-card .battery-bms-check,
html body:not(.print-protocol) .battery-inline-card .battery-life-result{
  font-family:Arial,sans-serif!important;
  font-size:13px!important;
  font-weight:400!important;
  line-height:normal!important;
  letter-spacing:normal!important;
  text-shadow:none!important;
}
