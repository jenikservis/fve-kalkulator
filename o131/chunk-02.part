}
</style>
<style id="fve-k2qr-unified-detail-windows">
:root{
  --fve-detail-width:980px;
  --fve-detail-wide-width:1180px;
  --fve-detail-radius:18px;
  --fve-detail-border:#cbd5e1;
  --fve-detail-header:#f8fafc;
  --fve-detail-bg:#ffffff;
  --fve-detail-text:#0f172a;
  --fve-detail-muted:#475569;
  --fve-detail-shadow:0 24px 70px rgba(15,23,42,.28);
  --fve-detail-overlay:rgba(15,23,42,.55);
}

/* Společná překryvná plocha – posouvá se celé okno, nikoli vnořený obsah. */
#batteryDetailsModal,
#regVoltageDetailsModal,
#cablePage,
#pdfPreviewModal{
  position:fixed!important;
  inset:0!important;
  z-index:100000!important;
  box-sizing:border-box!important;
  padding:28px 18px!important;
  overflow-y:auto!important;
  overflow-x:hidden!important;
  overscroll-behavior:contain!important;
  background:var(--fve-detail-overlay)!important;
  align-items:flex-start!important;
  justify-content:center!important;
}
#batteryDetailsModal.is-open,
#regVoltageDetailsModal.is-open,
#cablePage.open,
#pdfPreviewModal.show,
body.print-preview-open #pdfPreviewModal{
  display:flex!important;
}

/* Vlastní panely detailních oken. */
#batteryDetailsModal .battery-details-modal-panel,
#regVoltageDetailsModal .reg-voltage-details-modal-panel,
#cablePage > .subpage,
#pdfPreviewModal > .modal{
  position:relative!important;
  inset:auto!important;
  width:min(var(--fve-detail-width), calc(100vw - 36px))!important;
  max-width:var(--fve-detail-width)!important;
  min-height:0!important;
  height:auto!important;
  max-height:none!important;
  margin:0 auto 28px!important;
  padding:0!important;
  overflow:visible!important;
  box-sizing:border-box!important;
  border:1px solid var(--fve-detail-border)!important;
  border-radius:var(--fve-detail-radius)!important;
  background:var(--fve-detail-bg)!important;
  color:var(--fve-detail-text)!important;
  box-shadow:var(--fve-detail-shadow)!important;
}
#pdfPreviewModal > .modal{
  width:min(var(--fve-detail-wide-width), calc(100vw - 36px))!important;
  max-width:var(--fve-detail-wide-width)!important;
}

/* Původní samostatné backdrop prvky jsou nahrazené společnou překryvnou plochou. */
#batteryDetailsModal .battery-details-modal-backdrop,
#regVoltageDetailsModal .reg-voltage-details-modal-backdrop{
  position:fixed!important;
  inset:0!important;
  background:transparent!important;
  z-index:-1!important;
}

/* Jednotné záhlaví. */
#batteryDetailsModal .battery-details-modal-header,
#regVoltageDetailsModal .reg-voltage-details-modal-header,
#cablePage .subpage-header,
#pdfPreviewModal .pdf-preview-top-actions{
  position:sticky!important;
  top:-28px!important;
  z-index:20!important;
  min-height:62px!important;
  box-sizing:border-box!important;
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  gap:14px!important;
  margin:0!important;
  padding:14px 16px 14px 20px!important;
  border:0!important;
  border-bottom:1px solid var(--fve-detail-border)!important;
  border-radius:var(--fve-detail-radius) var(--fve-detail-radius) 0 0!important;
  background:var(--fve-detail-header)!important;
  color:var(--fve-detail-text)!important;
  box-shadow:none!important;
}
#batteryDetailsModal .battery-details-modal-header h2,
#regVoltageDetailsModal .reg-voltage-details-modal-header h2,
#cablePage .subpage-header h2,
#pdfPreviewModal .fve-detail-protocol-title{
  flex:1 1 auto!important;
  margin:0!important;
  padding:0!important;
  font:700 18px/1.25 Arial,sans-serif!important;
  color:var(--fve-detail-text)!important;
  text-align:left!important;
}

/* Jednotné malé zavírací tlačítko. */
#batteryDetailsModal .battery-details-close,
#regVoltageDetailsModal .reg-voltage-details-close,
#cablePage .fve-detail-close,
#pdfPreviewModal .fve-detail-close{
  flex:0 0 34px!important;
  width:34px!important;
  height:34px!important;
  min-width:34px!important;
  min-height:34px!important;
  margin:0!important;
  padding:0!important;
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  border:1px solid #cbd5e1!important;
  border-radius:9px!important;
  background:#ffffff!important;
  color:#334155!important;
  font:400 24px/1 Arial,sans-serif!important;
  box-shadow:none!important;
  cursor:pointer!important;
}
#batteryDetailsModal .battery-details-close:hover,
#regVoltageDetailsModal .reg-voltage-details-close:hover,
#cablePage .fve-detail-close:hover,
#pdfPreviewModal .fve-detail-close:hover{
  background:#eef2f7!important;
  border-color:#94a3b8!important;
  color:#0f172a!important;
}

/* Jednotný obsah. */
#batteryDetailsModal .battery-details-modal-content,
#regVoltageDetailsModal .reg-voltage-details-modal-content,
#cablePage #cableDetails{
  box-sizing:border-box!important;
  width:100%!important;
  max-height:none!important;
  overflow:visible!important;
  margin:0!important;
  padding:20px!important;
  background:#ffffff!important;
  color:var(--fve-detail-text)!important;
  border-radius:0 0 var(--fve-detail-radius) var(--fve-detail-radius)!important;
}
#pdfPreviewModal #printCustomerStep{
  margin:0!important;
  padding:20px 20px 14px!important;
  background:#ffffff!important;
}
#pdfPreviewModal #printPreviewContent{
  box-sizing:border-box!important;
  width:100%!important;
  max-width:100%!important;
  max-height:none!important;
  overflow:visible!important;
  margin:0!important;
  padding:20px!important;
  border:0!important;
  border-top:1px solid #e2e8f0!important;
  border-radius:0 0 var(--fve-detail-radius) var(--fve-detail-radius)!important;
  background:#ffffff!important;
}

/* V protokolu je Tisk/PDF sekundární akce v jednotném záhlaví; staré Zavřít se nahradí křížkem. */
#pdfPreviewModal .pdf-preview-top-actions{
  justify-content:flex-start!important;
}
#pdfPreviewModal .pdf-preview-top-actions > button:not(.fve-detail-close){
  width:auto!important;
  min-width:92px!important;
  height:36px!important;
  margin:0!important;
  padding:0 14px!important;
  border:1px solid #2563eb!important;
  border-radius:9px!important;
  background:#2563eb!important;
  color:#ffffff!important;
  font:600 13px/1 Arial,sans-serif!important;
  box-shadow:none!important;
}
#pdfPreviewModal .pdf-preview-top-actions .fve-detail-protocol-title{order:-2!important;}
#pdfPreviewModal .pdf-preview-top-actions > button:not(.fve-detail-close){order:-1!important;}
#pdfPreviewModal .pdf-preview-top-actions .fve-detail-close{margin-left:auto!important;order:3!important;}

/* Společná typografie technických detailů. */
#batteryDetailsModal,
#regVoltageDetailsModal,
#cablePage,
#pdfPreviewModal{
  font-family:Arial,sans-serif!important;
}
#batteryDetailsModal h3,
#regVoltageDetailsModal h3,
#cablePage h3,
#pdfPreviewModal #printCustomerStep h3{
  margin:0 0 12px!important;
  color:#0f172a!important;
  font:700 15px/1.35 Arial,sans-serif!important;
}

@media(max-width:700px){
  #batteryDetailsModal,
  #regVoltageDetailsModal,
  #cablePage,
  #pdfPreviewModal{
    padding:8px!important;
  }
  #batteryDetailsModal .battery-details-modal-panel,
  #regVoltageDetailsModal .reg-voltage-details-modal-panel,
  #cablePage > .subpage,
  #pdfPreviewModal > .modal{
    width:100%!important;
    max-width:100%!important;
    margin:0 auto 12px!important;
    border-radius:14px!important;
  }
  #batteryDetailsModal .battery-details-modal-header,
  #regVoltageDetailsModal .reg-voltage-details-modal-header,
  #cablePage .subpage-header,
  #pdfPreviewModal .pdf-preview-top-actions{
    top:-8px!important;
    min-height:56px!important;
    padding:11px 10px 11px 14px!important;
    border-radius:14px 14px 0 0!important;
  }
  #batteryDetailsModal .battery-details-modal-header h2,
  #regVoltageDetailsModal .reg-voltage-details-modal-header h2,
  #cablePage .subpage-header h2,
  #pdfPreviewModal .fve-detail-protocol-title{
    font-size:16px!important;
  }
  #batteryDetailsModal .battery-details-modal-content,
  #regVoltageDetailsModal .reg-voltage-details-modal-content,
  #cablePage #cableDetails,
  #pdfPreviewModal #printCustomerStep,
  #pdfPreviewModal #printPreviewContent{
    padding:14px!important;
  }
}

@media print{
  #pdfPreviewModal .pdf-preview-top-actions,
  #batteryDetailsModal,
  #regVoltageDetailsModal,
  #cablePage{
    display:none!important;
  }
}
</style>
<style id="k2qs-advanced-settings-font-unification">
/* K2QS: Pokročilé nastavení systému používá stejné písmo jako zbytek konfigurátoru. */
.advanced-losses-details,
.advanced-losses-details *,
.advanced-losses-details summary,
.advanced-losses-details input,
.advanced-losses-details select,
.advanced-losses-details textarea,
.advanced-losses-details button,
.advanced-losses-details label,
.advanced-losses-details table,
.advanced-losses-details th,
.advanced-losses-details td {
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif !important;
  letter-spacing:0 !important;
  text-rendering:optimizeLegibility !important;
  -webkit-font-smoothing:antialiased !important;
  -moz-osx-font-smoothing:grayscale !important;
}

/* Běžný obsah odpovídá standardnímu textu konfigurátoru. */
.advanced-losses-details,
.advanced-losses-details label,
.advanced-losses-details .small,
.advanced-losses-details .advanced-losses-note,
.advanced-losses-details .workflow-inline-note,
.advanced-losses-details td,
.advanced-losses-details input,
.advanced-losses-details select,
.advanced-losses-details textarea,
.advanced-losses-details button {
  font-weight:500 !important;
}

/* Nadpis rozbalovacího pole a nadpisy sekcí zůstávají pouze zvýrazněné. */
.advanced-losses-details summary,
.advanced-losses-details .advanced-toggle-btn,
.advanced-losses-details .advanced-toggle-btn::before,
.advanced-losses-details .advanced-subtitle,
.advanced-losses-details th,
.advanced-losses-details h1,
.advanced-losses-details h2,
.advanced-losses-details h3 {
  font-weight:700 !important;
}
</style>
<style id="k2qu-unified-advanced-expert-typography">
/* K2QU: typografie obou technických rozbalovacích sekcí odpovídá konfigurátoru. */
.advanced-losses-details,
.advanced-losses-details *,
.fve-regulator-expert-limit,
.fve-regulator-expert-limit * {
  font-family:Arial,sans-serif !important;
  letter-spacing:normal !important;
  font-style:normal !important;
  text-transform:none !important;
}

/* Hlavní nadpis Pokročilé nastavení systému – stejný charakter jako ostatní nadpisy rozbalovacích polí. */
.advanced-losses-details > summary,
.advanced-losses-details > summary .advanced-toggle-btn,
.advanced-losses-details > summary .advanced-toggle-btn::before {
  font-size:16px !important;
  font-weight:600 !important;
  line-height:1.35 !important;
}

/* Běžné texty, vysvětlivky a názvy polí. */
.advanced-losses-details label,
.advanced-losses-details .small,
.advanced-losses-details .advanced-losses-note,
.advanced-losses-details .workflow-inline-note,
.advanced-losses-details p,
.advanced-losses-details li,
.advanced-losses-details td,
.advanced-losses-details th,
.fve-regulator-expert-limit > summary,
.fve-regulator-expert-limit .small,
.fve-regulator-expert-limit label,
.fve-regulator-expert-limit p,
.fve-regulator-expert-limit li {
  font-size:13px !important;
  line-height:1.4 !important;
}

.advanced-losses-details label,
.advanced-losses-details .small,
.advanced-losses-details .advanced-losses-note,
.advanced-losses-details .workflow-inline-note,
.advanced-losses-details p,
.advanced-losses-details li,
.advanced-losses-details td,
.fve-regulator-expert-limit .small,
.fve-regulator-expert-limit label,
.fve-regulator-expert-limit p,
.fve-regulator-expert-limit li {
  font-weight:400 !important;
}

/* Nadpis Odborné nastavení limitu FV výkonu je zvýrazněný stejně jako jiné menší technické nadpisy. */
.fve-regulator-expert-limit > summary,
.advanced-losses-details th,
.advanced-losses-details .advanced-subtitle,
.advanced-losses-details h3 {
  font-weight:600 !important;
}

/* Ovládací prvky uvnitř obou sekcí. */
.advanced-losses-details input,
.advanced-losses-details select,
.advanced-losses-details textarea,
.advanced-losses-details button,
.fve-regulator-expert-limit input,
.fve-regulator-expert-limit select,
.fve-regulator-expert-limit textarea,
.fve-regulator-expert-limit button {
  font-size:13px !important;
  font-weight:400 !important;
  line-height:1.35 !important;
}

@media print {
  .advanced-losses-details > summary,
  .advanced-losses-details > summary .advanced-toggle-btn,
  .advanced-losses-details > summary .advanced-toggle-btn::before {
    font-size:9px !important;
  }
  .advanced-losses-details label,
  .advanced-losses-details .small,
  .advanced-losses-details .advanced-losses-note,
  .advanced-losses-details .workflow-inline-note,
  .advanced-losses-details p,
  .advanced-losses-details li,
  .advanced-losses-details td,
  .advanced-losses-details th,
  .fve-regulator-expert-limit > summary,
  .fve-regulator-expert-limit .small,
  .fve-regulator-expert-limit label {
    font-size:8px !important;
  }
}
</style>
