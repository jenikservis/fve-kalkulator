<style id="k13s-mustr-sun-integration">
.k13e-dyn3d-scene{
  aspect-ratio:1620/971!important;
  background:#fff!important;
  border-radius:0!important;
}
#k13ePanelSvg{width:100%!important;height:100%!important;background:#fff!important}
#k13ePanelSvg>rect,#k13ePanelSvg>ellipse,
#k13ePanelSvg .po-ticks,#k13ePanelSvg .po-axis,#k13ePanelSvg .po-cardinal,
#poPanelGroup,#poPanelHit,#poTiltFill,#poTiltBase,#poTiltRay,#poTiltArc,#poTiltText,
#poAzCenter,#poAzGuide,#poAzLine,#poAzText,#poPanelFoot,#poSunGuide{display:none!important}
#k13eMustrBackground{display:none!important}
#poSummer,#poEquinox,#poWinter{display:block!important;visibility:visible!important;opacity:1!important;fill:none!important;stroke-linecap:round!important}
#poSummer{stroke:#f28c00!important;stroke-width:3.2!important;stroke-dasharray:11 7!important}
#poEquinox{stroke:#d5a900!important;stroke-width:3.2!important;stroke-dasharray:11 7!important}
#poWinter{stroke:#247fce!important;stroke-width:3.2!important;stroke-dasharray:11 7!important}
#poSelected{
  display:block!important;fill:none!important;stroke:#24272b!important;
  stroke-width:2.8!important;stroke-dasharray:8 7!important;stroke-linecap:round!important
}
#poSun{display:block;fill:#f01f1f!important;stroke:#111316!important;stroke-width:2.3!important;filter:drop-shadow(0 2px 2px rgba(0,0,0,.32))!important}
#poSunGuide{
  display:block!important;
  fill:none!important;
  stroke:#5d6873!important;
  stroke-width:1.45!important;
  stroke-dasharray:7 7!important;
  stroke-linecap:round!important;
  opacity:.58!important;
  marker-end:url(#sunPanelArrow)!important;
  pointer-events:none!important;
}
#poSunTime{display:none!important}
.k13e-scene-drag-help{display:none!important}
.k13e-dyn3d-legend{
  display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;align-items:center!important;gap:8px 10px!important;
  width:100%!important;box-sizing:border-box!important;
  padding:10px 14px 12px!important;border-top:1px solid #e3e7eb!important;background:#fff!important;
  font-size:11px!important;font-weight:700!important
}
.k13e-dyn3d-legend span{display:inline-flex!important;align-items:center!important;gap:7px!important;color:#343a40!important}
.k13e-dyn3d-legend i{display:inline-block!important;width:34px!important;height:0!important;background:none!important;border-radius:0!important;border-top:3px dashed currentColor!important}
.k13e-dyn3d-legend .actual{color:#24272b!important}
.k13e-dyn3d-legend .summer{color:#f28c00!important}
.k13e-dyn3d-legend .equinox{color:#b58e00!important}
.k13e-dyn3d-legend .winter{color:#247fce!important}
#k13ePanelSvg #poPanelGroup{display:block!important;visibility:visible!important;opacity:1!important}
#k13ePanelSvg #poPanelHit{display:block!important;visibility:visible!important}
#k13ePanelSvg #poPanelPoly{fill:url(#panelBlue)!important;stroke:#10283d!important;stroke-width:3!important}
#k13ePanelSvg #poBottomEdge{display:block!important;stroke:#0b1f31!important;stroke-width:3!important}
#k13ePanelSvg #poPanelGrid{display:block!important}
#k13ePanelSvg #poPanelGrid line{stroke:rgba(220,237,248,.78)!important;stroke-width:1.15!important}
#k13eCleanCompass .clean-horizon{fill:none;stroke:#7d838a;stroke-width:1.7}
#k13eCleanCompass .clean-tick{stroke:#a0a5ab;stroke-width:1.05}
#k13eCleanCompass .clean-tick.major{stroke:#747a81;stroke-width:1.8}
#k13eCleanCompass .clean-degree{fill:#777d84;font-size:16px;font-weight:500;text-anchor:middle;dominant-baseline:middle}
#k13eCleanCompass .clean-cardinal{fill:#4f555b;font-size:23px;font-weight:700;text-anchor:middle;dominant-baseline:middle}
#k13eCleanCompass .clean-axis{fill:none;stroke-width:1.35;opacity:.8}
#k13eCleanCompass .axis-ns{stroke:#2d45aa}
#k13eCleanCompass .axis-ew{stroke:#d14b4b}
#k13eCleanCompass .axis-aux{stroke:#4a9b54}
.k13s-azimuth-help{display:block;margin-top:5px;color:#64707c;font-size:10.5px;line-height:1.3;font-weight:600}
