}
#fveK6RWater #wWaterResultsGrid td:last-child,
#fveK6RWater #wWaterResultsGrid .k10w-energy-grid > div > b,
#fveK6RWater #wWaterResultsGrid .k12a-row > b{
  font-weight:700!important;
}
@media(max-width:700px){
  #fveK6RWater #wWaterResultsGrid td,
  #fveK6RWater #wWaterResultsGrid th,
  #fveK6RWater #wWaterResultsGrid .k10w-energy-grid > div > span,
  #fveK6RWater #wWaterResultsGrid .k10w-energy-grid > div > b,
  #fveK6RWater #wWaterResultsGrid .k12a-row > span,
  #fveK6RWater #wWaterResultsGrid .k12a-row > b,
  #fveK6RWater #wWaterEvaluation td,
  #fveK6RWater #wWaterEvaluation th,
  #fveK6RWater #wWaterEvaluation span,
  #fveK6RWater #wWaterEvaluation b,
  #fveK6RWater #wWaterEvaluation li,
  #fveK6RWater #wStatus p,
  #fveK6RWater #wStatus li{
    font-size:11px!important;
    line-height:1.25!important;
  }
}
</style>
<style id="fve-water-preview-same-as-island-css">
#pdfPreviewModal.fve-water-preview-mode{
  overflow:auto!important;
  align-items:flex-start!important;
}
#pdfPreviewModal.fve-water-preview-mode>.modal{
  width:min(1100px,96vw)!important;
  max-width:none!important;
  max-height:none!important;
  min-height:0!important;
  overflow:visible!important;
}
#pdfPreviewModal.fve-water-preview-mode #fveWaterProtocolSettings{
  display:block;
}
#pdfPreviewModal.fve-water-preview-mode .fve-water-settings-grid>div{
  display:flex;align-items:center;min-height:32px
}
#pdfPreviewModal.fve-water-preview-mode .fve-water-settings-grid label{
  display:flex!important;align-items:center;gap:8px!important;font-weight:600!important
}
#pdfPreviewModal.fve-water-preview-mode .fve-water-settings-grid input[type="checkbox"]{
  width:16px!important;height:16px!important;min-height:16px!important;margin:0!important
}
#pdfPreviewModal.fve-water-preview-mode #printPreviewContent{
  display:block!important;
  min-height:220px!important;
  overflow:visible!important;
}
#pdfPreviewModal.fve-water-preview-mode #fveWaterK5RProtocol{
  display:block!important;
  margin:0 auto!important;
  width:196mm!important;
  max-width:100%!important;
  background:#fff!important;
}
@media(max-width:700px){
  #pdfPreviewModal.fve-water-preview-mode{padding:6px!important;align-items:flex-start!important}
  #pdfPreviewModal.fve-water-preview-mode>.modal{width:calc(100vw - 12px)!important;max-width:calc(100vw - 12px)!important;margin:0!important}
  #pdfPreviewModal.fve-water-preview-mode #printPreviewContent{overflow:visible!important;width:196mm!important;min-width:196mm!important;max-width:none!important;box-sizing:border-box!important;transform-origin:top left!important}
  /* K16C882: stejně jako Ostrov se zmenšuje celý preview host přes zoom. */
  #pdfPreviewModal.fve-water-preview-mode #fveWaterK5RProtocol{width:196mm!important;max-width:none!important;margin:0!important}
  #pdfPreviewModal.fve-water-preview-mode .fve-water-settings-grid{grid-template-columns:1fr!important}
  #pdfPreviewModal.fve-water-preview-mode .modal-actions{position:sticky!important;bottom:0!important;z-index:50!important;background:#fff!important;padding-top:8px!important}
}
</style>
<style id="k13eDyn3DStyle">
.k13e-dyn3d{margin:12px 0 16px;border:1px solid #d9e2ec;border-radius:14px;background:#fff;overflow:hidden}
.k13e-dyn3d-tabs{display:flex;padding:10px 10px 0;background:#f8fafc}
.k13e-dyn3d-tab{border:1px solid #cfd8e3;background:#fff;padding:10px 20px;font:inherit;font-weight:800;color:#243248;cursor:pointer}
.k13e-dyn3d-tab:first-child{border-radius:8px 0 0 8px}.k13e-dyn3d-tab:last-child{border-radius:0 8px 8px 0}
.k13e-dyn3d-tab.is-active{background:#1672df;color:#fff;border-color:#1672df}
.k13e-dyn3d-panel{display:none}.k13e-dyn3d-panel.is-active{display:block}

.k13e-dyn3d-scene{position:relative;aspect-ratio:1140/601;overflow:hidden;background:#dbe7f2}
.k13e-dyn3d-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.k13e-dyn3d-svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.k13e-dyn3d-svg .ring{fill:none;stroke:rgba(255,255,255,.94);stroke-width:3}
.k13e-dyn3d-svg .compass-ticks line{stroke:rgba(255,255,255,.88)}
.k13e-dyn3d-svg .compass-ticks .minor{stroke-width:1.2}.k13e-dyn3d-svg .compass-ticks .major{stroke-width:2}
.k13e-dyn3d-svg .degree-labels text{fill:#fff;font-size:15px;font-weight:800;text-anchor:middle;paint-order:stroke;stroke:rgba(0,0,0,.55);stroke-width:3}
.k13e-dyn3d-svg .mini-bg{fill:rgba(9,24,39,.88);stroke:rgba(255,255,255,.3);stroke-width:1}
.k13e-dyn3d-svg .mini-ring{fill:none;stroke:rgba(255,255,255,.22);stroke-width:1}
.k13e-dyn3d-svg .mini-compass text{fill:#fff;font-size:16px;font-weight:900;text-anchor:middle}
.k13e-dyn3d-svg .mini-north{fill:#ef2b2d}.k13e-dyn3d-svg .mini-south{fill:#fff}

.k13e-dyn3d-svg .cardinals text{fill:#fff;font-size:26px;font-weight:900;text-anchor:middle;paint-order:stroke;stroke:rgba(0,0,0,.45);stroke-width:3}
.k13e-dyn3d-svg .sunpath{fill:none;stroke-width:3;stroke-dasharray:10 7}.k13e-dyn3d-svg .summer{stroke:#ff8a00}.k13e-dyn3d-svg .equinox{stroke:#ffd21a}.k13e-dyn3d-svg .winter{stroke:#1f80df}.k13e-dyn3d-svg .currentday{stroke:#ef3340;stroke-width:4;stroke-dasharray:none}
.k13e-dyn3d-svg .sunguide{stroke:#ffe21a;stroke-width:2;stroke-dasharray:9 7}.k13e-dyn3d-svg .sundot{fill:#ffe51f;stroke:#ff7a00;stroke-width:3;filter:drop-shadow(0 0 9px #ffd91a)}
.k13e-dyn3d-svg .azline{stroke:#ffd51f;stroke-width:5}.k13e-dyn3d-svg .azhead{fill:#ffd51f}.k13e-dyn3d-svg .tiltline{fill:none;stroke:#59a1ff;stroke-width:4}
.k13e-dyn3d-info{position:absolute;left:16px;top:16px;min-width:285px;background:rgba(14,29,47,.84);color:#fff;border-radius:9px;padding:10px 14px}
.k13e-dyn3d-info div{display:flex;justify-content:space-between;gap:22px;padding:4px 0;font-size:13px}.k13e-dyn3d-info span{color:#dce8f5}
.k13e-dyn3d-badge{
 position:absolute;z-index:24;padding:0;background:transparent!important;
 border:0!important;box-shadow:none!important;border-radius:0;
 font-weight:900;text-align:center;text-shadow:0 1px 3px rgba(255,255,255,.9);
 pointer-events:none
}
.k13e-scene-drag-surface{
  position:absolute;inset:0;z-index:12;
  background:transparent;
  cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none;
}
.k13e-scene-drag-surface:active{cursor:grabbing}
.k13e-orientation-status-clean{
 position:absolute;left:10px;top:10px;z-index:28;
 display:flex;gap:5px;pointer-events:none
}
.k13e-orientation-box{
 min-width:72px;padding:4px 6px;border-radius:6px;
 background:rgba(255,255,255,.90);
 border:1px solid rgba(148,163,184,.55);
 box-shadow:0 1px 4px rgba(15,23,42,.16);
 color:#1e293b;font-size:10px;font-weight:800
}
.k13e-orientation-box b{display:block;margin-top:1px;font-size:14px}
.k13e-orientation-box.az b{color:#b88900}
.k13e-orientation-box.tilt b{color:#1672df}
.k13e-dyn3d-scene:fullscreen .k13e-orientation-status-clean,
.k13e-dyn3d-scene.k13e-fallback-fullscreen .k13e-orientation-status-clean{left:20px;top:20px}
.k13e-dyn3d-scene:fullscreen .k13e-orientation-box,
.k13e-dyn3d-scene.k13e-fallback-fullscreen .k13e-orientation-box{
 min-width:82px;font-size:11px;padding:5px 7px
}
.k13e-dyn3d-scene:fullscreen .k13e-orientation-box b,
.k13e-dyn3d-scene.k13e-fallback-fullscreen .k13e-orientation-box b{font-size:16px}
.k13e-dyn3d-scene:fullscreen .k13e-dyn3d-badge,
.k13e-dyn3d-scene.k13e-fallback-fullscreen .k13e-dyn3d-badge{font-size:20px}

.k13e-fullscreen-btn{
  position:absolute;right:12px;bottom:12px;z-index:30;
  width:44px;height:44px;border:1px solid rgba(148,163,184,.8);
  border-radius:9px;background:rgba(255,255,255,.94);color:#0f172a;
  font-size:24px;font-weight:800;line-height:1;cursor:pointer;
  box-shadow:0 2px 8px rgba(0,0,0,.22)
}
.k13e-fullscreen-btn:hover{background:#fff}
.k13e-fullscreen-btn:active{transform:scale(.96)}
.k13e-dyn3d-scene.k13e-fallback-fullscreen{
  position:fixed!important;inset:0!important;z-index:999999!important;
  width:100vw!important;height:100vh!important;max-width:none!important;
  aspect-ratio:auto!important;background:#000!important
}
.k13e-dyn3d-scene.k13e-fallback-fullscreen .k13e-dyn3d-bg{
  object-fit:contain!important;background:#000
}
.k13e-dyn3d-scene.k13e-fallback-fullscreen + .k13e-dyn3d-controls{display:none!important}
body.k13e-no-scroll{overflow:hidden!important}
@media(max-width:760px){
  .k13e-fullscreen-btn{width:50px;height:50px;font-size:27px;right:10px;bottom:10px}
}

.k13e-scene-drag-help{
  padding:8px 12px 10px;background:#fff;border-top:1px solid #eef2f6;
  color:#475569;font-size:12px
}
.k13e-dyn3d-badge.tilt{left:43%;bottom:27%;color:#6bb4ff}.k13e-dyn3d-badge.az{left:49%;bottom:7%;color:#ffd91f}
.k13e-dyn3d-controls{display:grid;grid-template-columns:auto 1fr auto 78px 145px 44px;gap:9px;align-items:center;padding:10px 12px;border-top:1px solid #dbe3ec}
.k13e-dyn3d-controls input[type=range]{width:100%}.k13e-dyn3d-controls input[type=date]{min-width:0;padding:7px;border:1px solid #cbd5e1;border-radius:7px}.k13e-dyn3d-controls output{padding:7px;border:1px solid #cbd5e1;border-radius:7px;text-align:center;color:#0d6ee8;font-weight:800}.k13e-dyn3d-controls button{height:36px;border:1px solid #cbd5e1;background:#fff;border-radius:7px;color:#0d6ee8;font-weight:900}.k13e-dyn3d-legend{display:flex;gap:16px;flex-wrap:wrap;padding:8px 12px 10px;border-top:1px solid #eef2f6;background:#fff;font-size:12px;font-weight:700}.k13e-dyn3d-legend span{display:inline-flex;align-items:center;gap:6px;color:#334155}.k13e-dyn3d-legend i{display:inline-block;width:28px;height:4px;border-radius:2px}.k13e-dyn3d-legend .actual i{background:#ef3340}.k13e-dyn3d-legend .summer i{background:#ff8a00}.k13e-dyn3d-legend .equinox i{background:#ffd21a}.k13e-dyn3d-legend .winter i{background:#1f80df}
.k13e-dyn3d-sun-only{height:320px;background:linear-gradient(#83bced,#e9f3fb);padding:10px}.k13e-dyn3d-sun-only svg{width:100%;height:100%}.k13e-dyn3d-sun-only path{fill:none;stroke-width:3;stroke-dasharray:10 7}.k13e-dyn3d-sun-only .summer{stroke:#ff8a00}.k13e-dyn3d-sun-only .equinox{stroke:#ffd21a}.k13e-dyn3d-sun-only .winter{stroke:#1f80df}.k13e-dyn3d-sun-only .currentday{fill:none;stroke:#ef3340;stroke-width:4;stroke-dasharray:none}#k13eSunOnlyGuide{stroke:#e11d48;stroke-width:2}#k13eSunOnlyDot{fill:#ffe51f;stroke:#ff7a00;stroke-width:3}#k13eSunOnly text{font-size:18px;font-weight:800;fill:#1e293b}
@media(max-width:760px){.k13e-dyn3d-controls{grid-template-columns:auto 1fr auto 72px}.k13e-dyn3d-controls input[type=date]{grid-column:1/4}.k13e-dyn3d-scene{aspect-ratio:16/10}}
</style>
<style id="k13e-exact-mustr-visual">
.k13e-dyn3d-scene{aspect-ratio:1280/910!important;background:#eef3f8!important;overflow:hidden!important}
.k13e-dyn3d-bg{width:100%!important;height:100%!important;object-fit:contain!important;object-position:center center!important}
#k13eDynSvg,.k13e-dyn3d-badge,.k13e-orientation-status,.k13e-dyn3d-scene .k13e-html-handle,.k13e-dyn3d-scene .k13e-image-control{display:none!important}
</style>
<style id="k13e-panel-only-css">
.k13e-dyn3d-scene{
  position:relative!important;
  width:100%!important;
  max-width:100%!important;
  aspect-ratio:1280/650!important;
  height:auto!important;
  min-height:0!important;
  overflow:hidden!important;
  border-radius:8px!important;
  background:#fff!important;
}
#k13ePanelSvg{position:absolute;inset:0;width:100%;height:100%;display:block}
.po-ring{fill:none;stroke:#263746;stroke-width:1.8}
.po-ticks line{stroke:#263746}.po-ticks .minor{stroke-width:.8}.po-ticks .medium{stroke-width:1.1}.po-ticks .major{stroke-width:1.7}
.po-axis{stroke:#475569;stroke-width:1;opacity:.6}
.po-cardinal text{fill:#111;font:900 25px Arial,sans-serif;text-anchor:middle;paint-order:stroke;stroke:#fff;stroke-width:3}
.po-sunpath{fill:none;stroke-width:3}
.po-sunpath.summer{stroke:#ff8a00;stroke-dasharray:9 7}
.po-sunpath.equinox{stroke:#ffd21a;stroke-dasharray:9 7}
.po-sunpath.winter{stroke:#258ee8;stroke-dasharray:9 7}
.po-sunpath.selected{stroke:#ef3340;stroke-width:3.5}
.po-sun-guide{stroke:#ffe21b;stroke-width:2;stroke-dasharray:8 6}
.po-sun{fill:#ffe21b;stroke:#d69b00;stroke-width:2.5;filter:drop-shadow(0 0 5px rgba(255,226,27,.8))}
.po-sun-time{fill:#ffe21b;font:900 18px Arial,sans-serif;text-anchor:middle;paint-order:stroke;stroke:#fff;stroke-width:2}
.po-panel{fill:url(#panelBlue);stroke:#dce9f4;stroke-width:3}
.po-panel-frame{fill:none;stroke:#1d2d3c;stroke-width:4}
#poPanelGrid line{stroke:rgba(220,237,248,.65);stroke-width:1.15}
.po-foot{fill:#64748b;opacity:.14}
.po-tilt{fill:none;stroke:#258ee8;stroke-width:4}
.po-tilt-fill{fill:rgba(37,142,232,.18);stroke:#258ee8;stroke-width:1.4}
.po-tilt-text{fill:#258ee8;font:900 20px Arial,sans-serif;paint-order:stroke;stroke:#fff;stroke-width:2}
.po-az{stroke:#ff8a00;stroke-width:5}
.po-az-text{fill:#ff8a00;font:900 21px Arial,sans-serif;paint-order:stroke;stroke:#fff;stroke-width:2}
.po-hint{
  position:absolute;left:12px;bottom:10px;z-index:5;
  padding:5px 9px;border-radius:6px;background:rgba(255,255,255,.88);
  font-size:12px;color:#334155;pointer-events:none
}
.po-fs{
  position:absolute;right:12px;bottom:12px;z-index:8;
  width:42px;height:42px;border:1px solid #cbd5e1;border-radius:8px;
  background:#fff;font-size:22px;cursor:pointer
}
.po-drag{position:absolute;left:28%;top:33%;width:44%;height:44%;z-index:7;cursor:grab;background:transparent}
.po-drag:active{cursor:grabbing}
#k13eDynSvg,.k13e-dyn3d-bg,.k13e-dyn3d-badge,.k13e-orientation-status,.k13e-orientation-status-clean,.k13e-scene-drag-surface,.k13e-html-handle,.k13e-image-control{display:none!important}
@media(max-width:720px){
  .po-hint{font-size:10px;left:7px;bottom:6px}
}
</style>
<style id="k13e-panel-only-v2-css">
#poPanelGroup{
  pointer-events:all!important;
  cursor:grab!important;
  touch-action:none!important;
}
#poPanelGroup:active{cursor:grabbing!important}
#poPanelPoly{pointer-events:all!important}
#poDrag{display:none!important}
.po-panel{stroke-width:4!important}
.po-az{stroke-width:6!important}
.po-tilt{stroke-width:5!important}
</style>
<style id="k13e-panel-only-v3-css">
/* Main 3D view: one clear selected-day solar path only */
#poSummer,#poEquinox,#poWinter{display:none!important}
#poSelected{
  display:block!important;
  stroke:#ffe21b!important;
  stroke-width:3.2!important;
  stroke-dasharray:10 7!important;
}
