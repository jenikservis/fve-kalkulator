<style id="k2vg-responsive-action-buttons">
/* Jednotná responzivní mřížka pro spodní akční skupiny */
.open-panel-actions,
.project-actions,
.feed-actions,
.project-export-actions,
.design-guide-actions,
.modal-actions,
.pdf-preview-top-actions {
  display:grid!important;
  grid-template-columns:repeat(auto-fit,minmax(min(190px,100%),1fr))!important;
  gap:8px!important;
  align-items:stretch!important;
  width:100%!important;
  max-width:100%!important;
  box-sizing:border-box!important;
}

.open-panel-actions > *,
.project-actions > *,
.feed-actions > *,
.project-export-actions > *,
.design-guide-actions > *,
.modal-actions > *,
.pdf-preview-top-actions > * {
  width:100%!important;
  max-width:100%!important;
  min-width:0!important;
  margin-left:0!important;
  margin-right:0!important;
  box-sizing:border-box!important;
}

/* Menší karta: dovolí dvě tlačítka vedle sebe jen když se skutečně vejdou */
@media (max-width:900px){
  .open-panel-actions,
  .project-actions,
  .feed-actions,
  .project-export-actions,
  .design-guide-actions,
  .modal-actions,
  .pdf-preview-top-actions {
    grid-template-columns:repeat(auto-fit,minmax(min(165px,100%),1fr))!important;
  }
}

/* Mobil: všechna spodní tlačítka pod sebou a přes celou šířku */
@media (max-width:700px){
  .open-panel-actions,
  .project-actions,
  .feed-actions,
  .project-export-actions,
  .design-guide-actions,
  .modal-actions,
  .pdf-preview-top-actions,
  body.mobile-mode .open-panel-actions,
  body.mobile-mode .project-actions,
  body.mobile-mode .feed-actions,
  body.mobile-mode .project-export-actions,
  body.mobile-mode .design-guide-actions,
  body.mobile-mode .modal-actions,
  body.mobile-mode .pdf-preview-top-actions {
    grid-template-columns:minmax(0,1fr)!important;
  }
}
</style>
<style id="fve-k2wk-validation-authority-css">
/* K2WK – jediná finální vizuální vrstva validací. */
:root{--fve-warn:#d97706;--fve-warn-bg:#fff7ed;--fve-bad:#c62828;--fve-bad-bg:#fff1f2;--fve-ok:#2e7d32;--fve-active:#1976d2}
/* BAD/WARN mají přednost před aktivním/fokusovým modrým stavem. */
input.fve-input-bad,select.fve-input-bad,textarea.fve-input-bad,
input.fve-input-bad:focus,select.fve-input-bad:focus,textarea.fve-input-bad:focus{
 border-color:var(--fve-bad)!important;background:var(--fve-bad-bg)!important;box-shadow:0 0 0 2px rgba(198,40,40,.15)!important}
input.fve-input-warm,select.fve-input-warm,textarea.fve-input-warm,
input.fve-input-warm:focus,select.fve-input-warm:focus,textarea.fve-input-warm:focus{
 border-color:var(--fve-warn)!important;background:var(--fve-warn-bg)!important;box-shadow:0 0 0 2px rgba(217,119,6,.16)!important}
.card.fve-input-area-bad{border-color:var(--fve-bad)!important;background:var(--fve-bad-bg)!important}
.card.fve-input-area-warm{border-color:var(--fve-warn)!important;background:var(--fve-warn-bg)!important}
/* Nápověda je vždy neutrální a nikdy nepřebírá stav rodiče. */
.fve-help-box,.field-help,.help-box,[data-fve-help],.fve-inline-help{
 border-color:#d7dee7!important;background:#f4f6f8!important;color:inherit!important;box-shadow:none!important}
/* Jednotná sazba všech validačních hlášek. */
.fve-input-field-message{display:block!important;width:100%!important;max-width:none!important;box-sizing:border-box!important;
 margin:5px 0 8px!important;padding:0 2px!important;font:600 11px/15px Arial,sans-serif!important;letter-spacing:0!important;text-align:left!important}
.fve-input-field-message-warm{color:#9a5b00!important}.fve-input-field-message-bad{color:#b42318!important}

<style id="fve-k2wl-field-specific-validation-css">
/* K2WL: konkrétní problém musí být vidět přímo na poli, nejen na kartě. */
#backupDays.fve-autonomy-linked-warm.fve-autonomy-linked-warm,
#batteryManual.fve-autonomy-linked-warm.fve-autonomy-linked-warm{
 border-color:#d97706!important;background:#fff7ed!important;box-shadow:0 0 0 2px rgba(217,119,6,.16)!important;
}
.card.basic-input-card.fve-autonomy-linked-card-warm.fve-autonomy-linked-card-warm{
 border-color:#d97706!important;background:#fff7ed!important;box-shadow:0 0 0 2px rgba(217,119,6,.10)!important;
}
/* Obecná priorita lokálního pole: BAD > WARN > aktivní/fokus. */
input.fve-input-bad.fve-input-bad,select.fve-input-bad.fve-input-bad,textarea.fve-input-bad.fve-input-bad,
input.fve-input-bad.fve-input-bad:focus,select.fve-input-bad.fve-input-bad:focus,textarea.fve-input-bad.fve-input-bad:focus{
 border-color:#c62828!important;background:#fff1f2!important;box-shadow:0 0 0 2px rgba(198,40,40,.15)!important;
}
input.fve-input-warm.fve-input-warm,select.fve-input-warm.fve-input-warm,textarea.fve-input-warm.fve-input-warm,
input.fve-input-warm.fve-input-warm:focus,select.fve-input-warm.fve-input-warm:focus,textarea.fve-input-warm.fve-input-warm:focus{
 border-color:#d97706!important;background:#fff7ed!important;box-shadow:0 0 0 2px rgba(217,119,6,.16)!important;
}
</style>
<style id="fve-k2wm-feed-field-validation-css">
/* K2WM: produktová neshoda je vidět přímo u konkrétního vstupu, ale zůstává
   oddělená od vlastní technické validace konfigurátoru. */
.fve-feed-field-message{
  display:block!important;
  width:100%!important;
  box-sizing:border-box!important;
  margin:4px 0 2px!important;
  padding:0!important;
  border:0!important;
  background:transparent!important;
  font-family:Arial,sans-serif!important;
  font-size:11px!important;
  line-height:15px!important;
  font-weight:600!important;
  text-align:left!important;
  box-shadow:none!important;
}
.fve-feed-field-message-warn{color:#b45309!important;-webkit-text-fill-color:#b45309!important;}
.fve-feed-field-message-bad{color:#b91c1c!important;-webkit-text-fill-color:#b91c1c!important;}
html body:not(.print-protocol) input[data-feed-validation-state="warn"],
html body:not(.print-protocol) select[data-feed-validation-state="warn"],
html body:not(.print-protocol) textarea[data-feed-validation-state="warn"]{
  background:#fff7ed!important;border-color:#f59e0b!important;box-shadow:0 0 0 1px rgba(245,158,11,.18)!important;
}
html body:not(.print-protocol) input[data-feed-validation-state="bad"],
html body:not(.print-protocol) select[data-feed-validation-state="bad"],
html body:not(.print-protocol) textarea[data-feed-validation-state="bad"]{
  background:#fef2f2!important;border-color:#ef4444!important;box-shadow:0 0 0 1px rgba(239,68,68,.18)!important;
}
html body:not(.print-protocol) input[data-feed-validation-state="ok"]:not([aria-invalid="true"]),
html body:not(.print-protocol) select[data-feed-validation-state="ok"]:not([aria-invalid="true"]),
html body:not(.print-protocol) textarea[data-feed-validation-state="ok"]:not([aria-invalid="true"]){
  background:#ecfdf5!important;border-color:#22c55e!important;
}
.fve-help-box + .fve-feed-field-message,
.field-help + .fve-feed-field-message{margin-top:4px!important;}
@media print{.fve-feed-field-message{display:none!important;}}
</style>
<style id="fve-k3b-central-validation-visuals">
html body:not(.print-protocol) input.fve-input-bad,html body:not(.print-protocol) select.fve-input-bad,html body:not(.print-protocol) textarea.fve-input-bad{background:#fdecec!important;border:2px solid #b91c1c!important;box-shadow:0 0 0 1px rgba(185,28,28,.12)!important}
html body:not(.print-protocol) input.fve-input-warm,html body:not(.print-protocol) select.fve-input-warm,html body:not(.print-protocol) textarea.fve-input-warm{background:#fff4e5!important;border:2px solid #b45309!important;box-shadow:0 0 0 1px rgba(180,83,9,.12)!important}
html body:not(.print-protocol) .card.fve-input-area-state.fve-input-area-bad{border:2px solid #b91c1c!important;background:linear-gradient(180deg,rgba(185,28,28,.12),rgba(255,255,255,.97))!important}
