  #fveUserGuideModal .fve-user-guide-header{align-items:flex-start!important;}
  #fveUserGuideModal .fve-user-guide-title{font-size:15px!important;line-height:1.2!important;}
}
@media print{#fveUserGuideModal{display:none!important;}}
</style>
