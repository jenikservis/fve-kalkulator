\n<style id="k16c746-water-xml-visual-parity-offgrid">\n/* K16C746 – pouze vizuál XML karet Ohřevu; logika beze změny.\n   Mustr: ostrovní selected product card / fve-feed-visual-authority-v81. */\nhtml body:not(.print-protocol) #fveK6RWater .k7y-feed-row{\n  grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;\n  gap:14px!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-feed-side{\n  padding:14px!important;\n  border:1px solid #d1d5db!important;\n  border-radius:14px!important;\n  background:#fff!important;\n  box-shadow:0 2px 8px rgba(0,0,0,.06)!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .component-feed-card{\n  border:1px solid #d7dde5!important;\n  border-radius:8px!important;\n  background:#fff!important;\n  color:#111827!important;\n  -webkit-text-fill-color:#111827!important;\n  box-shadow:none!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .component-feed-body{\n  padding:12px!important;\n  color:#111827!important;\n  -webkit-text-fill-color:#111827!important;\n  font-weight:400!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .component-feed-body *{\n  text-shadow:none!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .fve-k2kn-product-name{\n  font-size:14px!important;\n  line-height:1.25!important;\n  font-weight:600!important;\n  color:#111827!important;\n  -webkit-text-fill-color:#111827!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .feed-badges,\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .feed-badges *{\n  font-size:12px!important;\n  line-height:1.45!important;\n  font-weight:500!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .product-stock-badge{\n  display:inline-flex!important;\n  align-items:center!important;\n  min-height:auto!important;\n  border:1px solid #d7dde5!important;\n  border-radius:999px!important;\n  padding:3px 7px!important;\n  background:#f8fafc!important;\n  color:#111827!important;\n  -webkit-text-fill-color:#111827!important;\n  font-size:12px!important;\n  font-weight:500!important;\n  line-height:1.45!important;\n}\n/* Technická tabulka produktu – stejná čitelnost jako Ostrov. */\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected table{\n  width:100%!important;\n  table-layout:fixed!important;\n  border-collapse:collapse!important;\n  font-size:12px!important;\n  color:#111827!important;\n  -webkit-text-fill-color:#111827!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected table th,\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected table td{\n  padding:7px 8px!important;\n  vertical-align:top!important;\n  font-weight:400!important;\n  line-height:1.35!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected table th{\n  font-size:11px!important;\n  font-weight:600!important;\n  color:#475569!important;\n  -webkit-text-fill-color:#475569!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected table td b{\n  font-weight:600!important;\n}\n/* Kontrola proti návrhu – Result header musí zůstat celý na jednom řádku. */\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .fve-feed-compare-table{\n  width:100%!important;\n  table-layout:fixed!important;\n  font-size:12px!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .fve-feed-compare-table thead th{\n  font-size:11px!important;\n  font-weight:600!important;\n  white-space:nowrap!important;\n  word-break:keep-all!important;\n  overflow-wrap:normal!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .fve-feed-compare-table thead th:nth-child(1){width:27%!important;}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .fve-feed-compare-table thead th:nth-child(2){width:25%!important;}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .fve-feed-compare-table thead th:nth-child(3){width:31%!important;}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .fve-feed-compare-table thead th:nth-child(4){width:17%!important;}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .fve-feed-compare-table .fve-feed-compare-result,\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .fve-feed-compare-table .fve-feed-compare-result *{\n  white-space:nowrap!important;\n  word-break:keep-all!important;\n  overflow-wrap:normal!important;\n  font-weight:600!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-check-title,\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .fve-feed-compare-title{\n  font-size:12px!important;\n  font-weight:600!important;\n  color:#334155!important;\n  -webkit-text-fill-color:#334155!important;\n}\n/* Akce pod Kontrolou proti návrhu – vizuálně stejně jako Ostrov. */\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .feed-actions{\n  display:flex!important;\n  flex-wrap:wrap!important;\n  gap:8px!important;\n  align-items:center!important;\n  justify-content:flex-start!important;\n  margin:8px 0 0!important;\n  width:100%!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .feed-actions>a,\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .feed-actions>button{\n  display:inline-flex!important;\n  align-items:center!important;\n  justify-content:center!important;\n  width:auto!important;\n  max-width:max-content!important;\n  min-width:0!important;\n  min-height:34px!important;\n  padding:7px 10px!important;\n  border:1px solid #aab4c2!important;\n  border-radius:8px!important;\n  background:#fff!important;\n  background-image:none!important;\n  box-shadow:none!important;\n  font-size:13px!important;\n  line-height:1.2!important;\n  font-weight:500!important;\n  text-shadow:none!important;\n  opacity:1!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .feed-actions>a{\n  color:#0b5f59!important;\n  -webkit-text-fill-color:#0b5f59!important;\n  text-decoration:none!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .feed-actions>button{\n  color:#111827!important;\n  -webkit-text-fill-color:#111827!important;\n}\nhtml body:not(.print-protocol) #fveK6RWater .k7y-selected .fve-datasheet-locked:disabled{\n  color:#64748b!important;\n  -webkit-text-fill-color:#64748b!important;\n  background:#f8fafc!important;\n}\n@media(max-width:900px){\n  html body:not(.print-protocol) #fveK6RWater .k7y-feed-row{grid-template-columns:1fr!important;}\n}\n@media(max-width:700px){\n  html body:not(.print-protocol) #fveK6RWater .k7y-selected .feed-actions{display:grid!important;grid-template-columns:1fr!important;}\n  html body:not(.print-protocol) #fveK6RWater .k7y-selected .feed-actions>a,\n  html body:not(.print-protocol) #fveK6RWater .k7y-selected .feed-actions>button{width:100%!important;max-width:100%!important;}\n}\n</style>\n

