<script id="fve-k16c703-shared-cold-monthly">
window.FVEWaterColdMonthly=window.FVEWaterColdMonthly||function(lat){
  lat=Math.abs(Number(lat)||50);
  var amp=(lat>=48&&lat<=52)?4.5:5.5,avg=10;
  return Array.from({length:12},function(_,m){
    var x=avg+amp*Math.sin(2*Math.PI*(m-4)/12);
    return Math.max(4,Math.min(18,x));
  });
};
</script>

