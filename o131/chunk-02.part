  width:100%!important;
  height:auto!important;
  min-height:210px!important;
}

@media(max-width:700px){
  #fveK6RWater .k10n-chart-grid{
    grid-template-columns:1fr!important;
  }

  /* Android/Chrome fallback:
     hodnota je současně v data-k10n-value a vykreslí se přímo v řádku.
     Tím nemůže zmizet mimo viewport ani při problematickém table layoutu. */
  #fveK6RWater .k8s-result-table,
  #fveK6RWater .k8s-result-table tbody{
    display:block!important;
    width:100%!important;
  }
  #fveK6RWater .k8s-result-table tr{
    display:grid!important;
    grid-template-columns:minmax(0,1fr) minmax(120px,42%)!important;
    width:100%!important;
    min-width:0!important;
    align-items:start!important;
    border-bottom:1px solid #e5e7eb!important;
  }
  #fveK6RWater .k8s-result-table td{
    min-width:0!important;
    width:auto!important;
    max-width:none!important;
    display:block!important;
    border:0!important;
  }
  #fveK6RWater .k8s-result-table td:last-child{
    display:none!important;
  }
  #fveK6RWater .k8s-result-table tr::after{
    content:attr(data-k10n-value)!important;
    display:block!important;
    min-width:0!important;
    padding:8px 6px!important;
    box-sizing:border-box!important;
    text-align:right!important;
    color:#111827!important;
    -webkit-text-fill-color:#111827!important;
    font-weight:700!important;
    line-height:1.35!important;
    white-space:normal!important;
    overflow-wrap:anywhere!important;
    visibility:visible!important;
    opacity:1!important;
  }
}
@media(max-width:390px){
  #fveK6RWater .k8s-result-table tr{
    grid-template-columns:1fr!important;
  }
  #fveK6RWater .k8s-result-table tr::after{
    text-align:left!important;
    padding-top:0!important;
  }
}
</style>
