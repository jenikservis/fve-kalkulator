  font-family:Arial,sans-serif!important;
  font-size:13px!important;
  font-weight:400!important;
  line-height:normal!important;
  color:var(--muted,#4b5563)!important;
  -webkit-text-fill-color:var(--muted,#4b5563)!important;
}
html body:not(.print-protocol) .battery-inline-card .component-main-panel input,
html body:not(.print-protocol) .battery-inline-card .component-main-panel select,
html body:not(.print-protocol) .battery-inline-card .component-main-panel textarea{
  font-family:Arial,sans-serif!important;
  font-size:13.3333px!important;
  font-weight:400!important;
  line-height:normal!important;
  letter-spacing:normal!important;
}
html body:not(.print-protocol) .battery-inline-card .battery-settings-box>summary,
html body:not(.print-protocol) .battery-inline-card .battery-bms-professional-box>summary,
html body:not(.print-protocol) .battery-inline-card .battery-datasheet-box>summary,
html body:not(.print-protocol) .battery-inline-card .battery-life-box>summary,
html body:not(.print-protocol) .battery-inline-card .runtime-modes-box>summary{
  font-family:Arial,sans-serif!important;
  font-size:13px!important;
  font-weight:400!important;
  line-height:normal!important;
  color:var(--muted,#4b5563)!important;
  -webkit-text-fill-color:var(--muted,#4b5563)!important;
}
html body:not(.print-protocol) .battery-inline-card .battery-bms-current-summary b,
html body:not(.print-protocol) .battery-inline-card .runtime-mode-row b{
  font-family:Arial,sans-serif!important;
  font-size:13px!important;
  font-weight:400!important;
  line-height:normal!important;
  color:var(--text,#111827)!important;
  -webkit-text-fill-color:var(--text,#111827)!important;
}
/* Nadpis celé karty zůstává shodný s ostatními vstupními kartami. */
html body:not(.print-protocol) .battery-inline-card h2.step-title{
  font-family:Arial,sans-serif!important;
  font-size:20px!important;
  font-weight:700!important;
}
</style>
<style id="k2pw-battery-structure-style">
.battery-inline-card .battery-subsection-title{font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:400;line-height:1.35;margin:12px 0 6px;color:inherit;}
.battery-inline-card .battery-bms-professional-box>summary,
.battery-inline-card .battery-datasheet-box>summary,
.battery-inline-card .battery-installation-box>summary,
.battery-inline-card .battery-life-box>summary{font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:400;line-height:1.35;}
.battery-inline-card .battery-bms-current-summary span,
.battery-inline-card .battery-bms-current-summary b{font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:400;line-height:1.35;}
</style>
<style id="battery-k2px-unified-style">
.unified-feed-row-battery-inline-card .battery-primary-section,
.unified-feed-row-battery-inline-card .battery-summary-section,
.unified-feed-row-battery-inline-card .battery-inline-check-section{margin:0;padding:0;border:0;background:transparent;box-shadow:none;border-radius:0}
.unified-feed-row-battery-inline-card .battery-summary-section{margin-top:10px}
.unified-feed-row-battery-inline-card .battery-summary-row{display:block;margin:0 0 8px}
.unified-feed-row-battery-inline-card .battery-summary-row>span,
.unified-feed-row-battery-inline-card .battery-inline-check-section>label,
.unified-feed-row-battery-inline-card .battery-bank-layout label{display:block;margin:0 0 4px;font:400 13px Arial,sans-serif;color:inherit}
.unified-feed-row-battery-inline-card .battery-summary-row input{width:100%;box-sizing:border-box}
.unified-feed-row-battery-inline-card .battery-bank-layout-inline{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 8px}
.unified-feed-row-battery-inline-card .battery-bms-current-summary-inline{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:8px 0}
.unified-feed-row-battery-inline-card .battery-bms-current-summary-inline>div{padding:8px;border:1px solid #d9e1e8;border-radius:6px;background:#fff}
.unified-feed-row-battery-inline-card .battery-bms-current-summary-inline span,
.unified-feed-row-battery-inline-card .battery-bms-current-summary-inline b{display:block;font:400 13px Arial,sans-serif;color:inherit}
.unified-feed-row-battery-inline-card .battery-bms-current-summary-inline b{margin-top:3px}
.unified-feed-row-battery-inline-card .battery-bms-results-compact{margin:8px 0}
.unified-feed-row-battery-inline-card .battery-bms-results-compact .battery-bms-check{font:400 13px Arial,sans-serif;margin:4px 0;padding:7px 9px}
.unified-feed-row-battery-inline-card .battery-details-open-btn{width:100%;margin-top:6px}
.battery-details-modal{display:none;position:fixed;inset:0;z-index:100000}
.battery-details-modal.is-open{display:block}
.battery-details-modal-backdrop{position:absolute;inset:0;background:rgba(15,23,42,.58)}
.battery-details-modal-panel{position:relative;width:min(860px,calc(100vw - 28px));max-height:calc(100vh - 28px);margin:14px auto;background:#fff;border-radius:10px;box-shadow:0 24px 70px rgba(0,0,0,.28);display:flex;flex-direction:column;overflow:hidden;font-family:Arial,sans-serif}
.battery-details-modal-header{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid #d9e1e8}
.battery-details-modal-header h2{margin:0;font:600 18px Arial,sans-serif;color:#172033}
.battery-details-close{border:0;background:transparent;font:400 28px/1 Arial,sans-serif;cursor:pointer;padding:0 4px;color:#344054}
.battery-details-modal-content{padding:16px 18px;overflow:auto}
.battery-modal-section{margin:0 0 18px;padding:0 0 16px;border-bottom:1px solid #e5e7eb}
.battery-modal-section:last-of-type{border-bottom:0}
.battery-modal-section h3{margin:0 0 10px;font:600 14px Arial,sans-serif;color:#172033}
.battery-details-modal .battery-bms-professional-grid{display:grid;grid-template-columns:minmax(230px,1fr) minmax(220px,1fr);gap:8px 12px;align-items:center}
.battery-details-modal label,.battery-details-modal .small,.battery-details-modal input,.battery-details-modal select{font-family:Arial,sans-serif;font-size:13px}
.battery-details-modal label{font-weight:400;color:inherit}
.battery-details-modal-footer{padding:12px 18px;border-top:1px solid #d9e1e8;display:flex;justify-content:flex-end}
body.battery-modal-open{overflow:hidden}
@media(max-width:700px){.battery-details-modal .battery-bms-professional-grid{grid-template-columns:1fr}.unified-feed-row-battery-inline-card .battery-bank-layout-inline,.unified-feed-row-battery-inline-card .battery-bms-current-summary-inline{grid-template-columns:1fr}.battery-details-modal-panel{width:calc(100vw - 16px);max-height:calc(100vh - 16px);margin:8px auto}}
</style>
<style id="k2ql-battery-diagnostics-end-style">
/* K2QL: doplňková diagnostika až za tabulkou Kontrola proti návrhu. */
.battery-diagnostics-end-panel{
  margin-top:10px!important;
