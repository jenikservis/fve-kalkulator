}
#fveK6RWater .k12a-expert:not([open]) .k12a-expert-grid,
#fveK6RWater .k12a-expert:not([open]) .k12j-expert-note{
  display:none!important;
}
</style>
<style id="k13e-gate-logo-visible-size">
html body #fveK6RProjectGate .fve-k6a-brand #fveK6RGateLogo{
  display:block!important;
