  color:#4b5563!important;
}
.battery-diagnostics-end-panel .battery-bms-professional-results{
  display:block!important;
  margin:0!important;
  padding:0!important;
}
.battery-diagnostics-end-panel .battery-bms-check{
  margin:0!important;
  padding:3px 0!important;
  border:0!important;
  border-radius:0!important;
  background:transparent!important;
