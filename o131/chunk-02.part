<style id="fve-k16c121-head-purple-fix">
/* K16C139: stará dvojitě specifická autorita byla odstraněna.
   Přepisovala aktivní fialovou kapacitu modrou během každého přepočtu. */
</style>
<style id="k16c186-mobile-results-scroll-performance">
@media (max-width:700px){
  html,body{
    overflow-y:auto!important;
    overscroll-behavior-y:auto!important;
    touch-action:pan-y!important;
  }
  #resultsGrid,
  #customerSummaryCard,
  #energySystemDetails,
  .fve-global-result-block,
  .logical-result-card,
  .chart-box{
    max-height:none!important;
    overflow-y:visible!important;
    touch-action:pan-y!important;
  }
  #chartProd,#chartDiff,#chartSoc,
  #resultsGrid canvas,
  .fve-global-result-block canvas{
    touch-action:pan-y!important;
    pointer-events:none!important;
  }
  .chart-box{
    contain:layout paint;
  }
}
</style>
<style id="k16c191-pro-tech-summary-style">
.fve-pro-tech-summary{
  margin-top:14px;padding:0 12px 12px;overflow:hidden;
  border:1px solid #cbd5e1;border-radius:12px;background:#f8fafc;
  box-shadow:0 1px 2px rgba(15,23,42,.04);
}
.fve-pro-tech-title{
  margin:0 -12px 10px;padding:10px 12px;
  border-bottom:1px solid #dbe3ec;border-left:4px solid #0f766e;
  background:#f1f5f9;color:#1f2937;font-size:15px;font-weight:800;
}
.fve-pro-tech-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.fve-pro-tech-grid>div{
  min-width:0;display:grid;grid-template-columns:minmax(120px,42%) minmax(0,1fr);align-items:center;gap:10px;
  padding:9px 10px;border:1px solid #dbe3ec;border-radius:8px;background:#fff;
}
.fve-pro-tech-grid span{min-width:0;color:#475569;font-size:13px;line-height:1.3;font-weight:400}
.fve-pro-tech-grid b{min-width:0;color:#111827;font-size:14px;font-weight:400;line-height:1.3;white-space:normal;overflow-wrap:anywhere;text-align:right}
.fve-pro-tech-note{margin-top:9px;padding:8px 10px;border-radius:8px;background:#eef2f7;color:#475569}
@media(max-width:700px){
  .fve-pro-tech-summary{padding:0 10px 10px}
  .fve-pro-tech-title{margin:0 -10px 9px;padding:9px 10px}
  .fve-pro-tech-grid{grid-template-columns:1fr}
}
</style>
<style id="k16c193-reg-results-stable-css">
@media(max-width:700px){
  #regOut .calc-highlight{align-items:stretch}
}
</style>
<style id="k16c192-reg-source-stable-css">
#regCurrentSource{display:block;margin:4px 0 2px;color:#111827;font-weight:700}
</style>
<style id="fve-k16c197-regulator-ivpv-css">
#regOut .reg-ivpv-wrap{
  margin:12px 0;
  padding:12px;
  border:1px solid #d7dde5;
  border-radius:14px;
  background:#f8fafc;
}
#regOut .reg-ivpv-title{
  font-weight:700;
  font-size:13px;
  margin:0 0 10px;
}
#regOut .reg-ivpv-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}
#regOut .reg-ivpv-panel{
  padding:8px;
  border:1px solid #e5e7eb;
  border-radius:12px;
  background:#fff;
}
#regOut .reg-ivpv-panel-title{
  font-size:12px;
  font-weight:700;
  margin:0 0 6px;
}
#regOut .reg-ivpv-svg{
  display:block;
  width:100%;
  height:auto;
  min-height:190px;
}
#regOut .reg-ivpv-axis{stroke:#64748b;stroke-width:1.1}
#regOut .reg-ivpv-gridline{stroke:#e5e7eb;stroke-width:1}
#regOut .reg-ivpv-curve{fill:none;stroke:#0f4c81;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
#regOut .reg-ivpv-power{fill:none;stroke:#c81e1e;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
#regOut .reg-ivpv-guide{stroke:#6b7280;stroke-width:1;stroke-dasharray:5 5}
#regOut .reg-ivpv-range{fill:#d1d5db;opacity:.58}
#regOut .reg-ivpv-range-edge{stroke:#94a3b8;stroke-width:1;stroke-dasharray:3 4}
#regOut .reg-ivpv-mpp{fill:#fff;stroke:#dc2626;stroke-width:2.5}
#regOut .reg-ivpv-operating{fill:#fff;stroke:#0284c7;stroke-width:2.5}
#regOut .reg-ivpv-loss{stroke:#111827;stroke-width:1.2}
#regOut .reg-ivpv-loss-text{font:700 9px Arial,Helvetica,sans-serif;fill:#991b1b}
#regOut .reg-ivpv-text{font:10px Arial,Helvetica,sans-serif;fill:#374151}
#regOut .reg-ivpv-label{font:700 10px Arial,Helvetica,sans-serif;fill:#111827}
#regOut .reg-ivpv-note{
  margin-top:9px;
  font-size:11px;
  line-height:1.4;
  color:#475569;
}
#regOut .reg-ivpv-values{
  margin-top:8px;
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:6px;
}
#regOut .reg-ivpv-values div{
  padding:6px 7px;
  border:1px solid #e5e7eb;
  border-radius:9px;
  background:#fff;
}
#regOut .reg-ivpv-values span{display:block;font-size:10px;color:#64748b}
#regOut .reg-ivpv-values b{display:block;margin-top:3px;font-size:17px;line-height:1.15;color:#0f4c81}
#regOut .reg-ivpv-values small{display:block;margin-top:5px;font-size:10px;line-height:1.25;color:#64748b}
#regOut .reg-ivpv-panel{overflow:visible;padding:0 12px 14px}
#regOut .reg-ivpv-panel-title{margin:0 -8px 7px;padding:10px 12px;font-size:13px;border-bottom:1px solid #dbe3ec}
#regOut .reg-ivpv-panel-iv .reg-ivpv-panel-title{background:#eef6ff;color:#0f4c81}
#regOut .reg-ivpv-panel-pv .reg-ivpv-panel-title{background:#eff9f0;color:#166534}
#regOut .reg-ivpv-svg{min-height:258px;overflow:visible}
#regOut .reg-ivpv-range-batt{fill:#dbeafe;opacity:.62}
#regOut .reg-ivpv-range-mppt{fill:#dcfce7;opacity:.48}
#regOut .reg-ivpv-range-edge-green{stroke:#15803d}
#regOut .reg-ivpv-key{font:700 11px Arial,Helvetica,sans-serif;fill:#111827;paint-order:stroke;stroke:#fff;stroke-width:4px;stroke-linejoin:round}
#regOut .reg-ivpv-key-value{font:700 11px Arial,Helvetica,sans-serif;paint-order:stroke;stroke:#fff;stroke-width:4px;stroke-linejoin:round}
#regOut .reg-ivpv-key-blue{fill:#0f4c81}
#regOut .reg-ivpv-mpp-label,#regOut .reg-ivpv-mpp-value{font:700 11px Arial,Helvetica,sans-serif;fill:#dc2626;paint-order:stroke;stroke:#fff;stroke-width:4px;stroke-linejoin:round}
#regOut .reg-ivpv-area-label{font:700 11px Arial,Helvetica,sans-serif;paint-order:stroke;stroke:#fff;stroke-width:3px;stroke-linejoin:round}
#regOut .reg-ivpv-area-blue{fill:#0f4c81}
#regOut .reg-ivpv-area-green{fill:#166534}
#regOut .reg-ivpv-axis-value,#regOut .reg-ivpv-axis-key{font:10px Arial,Helvetica,sans-serif;fill:#334155;paint-order:stroke;stroke:#fff;stroke-width:3px}
#regOut .reg-ivpv-axis-key-value{font:700 10px Arial,Helvetica,sans-serif;fill:#0f172a;paint-order:stroke;stroke:#fff;stroke-width:3px}
#regOut .reg-ivpv-range-value{font:700 10px Arial,Helvetica,sans-serif;fill:#0f4c81;paint-order:stroke;stroke:#fff;stroke-width:4px;stroke-linejoin:round}
#regOut .reg-ivpv-range-value-green{fill:#166534}
#regOut .reg-ivpv-voc,#regOut .reg-ivpv-voc-value{font:700 10px Arial,Helvetica,sans-serif;fill:#0f4c81;paint-order:stroke;stroke:#fff;stroke-width:4px;stroke-linejoin:round}
#regOut .reg-ivpv-voc-red{fill:#dc2626}
#regOut .reg-ivpv-axis-title{font:700 11px Arial,Helvetica,sans-serif;fill:#111827}
@media(max-width:700px){
  #regOut .reg-ivpv-grid{grid-template-columns:1fr}
  #regOut .reg-ivpv-values{grid-template-columns:1fr 1fr}
  #regOut .reg-ivpv-svg{min-height:180px}
}
@media print{
  #regOut .reg-ivpv-wrap{break-inside:avoid;background:#fff}
}

/* K16C251 – vizual podle schvaleneho navrhu; bez zmen vypoctove logiky. */
#regOut .reg-ivpv-title{font-size:17px;color:#0f2747;margin-bottom:12px}
#regOut .reg-ivpv-title span{font-size:12px;font-weight:600;color:#475569}
#regOut .reg-ivpv-panel-title{font-size:15px!important;line-height:1.2}
#regOut .reg-ivpv-panel-title small{display:block;margin-top:5px;font-size:10px;font-weight:500;line-height:1.35;color:#475569}
#regOut .reg-ivpv-panel-iv .reg-ivpv-panel-title{color:#0b4b8a}
#regOut .reg-ivpv-panel-pv .reg-ivpv-panel-title{color:#166534}
#regOut .reg-ivpv-isc-point{fill:#0f4c81}
#regOut .reg-ivpv-isc-label,#regOut .reg-ivpv-isc-value{font:700 10px Arial,Helvetica,sans-serif;fill:#0f4c81;paint-order:stroke;stroke:#fff;stroke-width:4px;stroke-linejoin:round}
#regOut .reg-ivpv-limit-label,#regOut .reg-ivpv-limit-value{font:700 9px Arial,Helvetica,sans-serif;fill:#166534;paint-order:stroke;stroke:#fff;stroke-width:4px;stroke-linejoin:round}
#regOut .reg-ivpv-values div{border-color:#bfdbfe;background:#f8fbff;padding:8px 9px}
#regOut .reg-ivpv-values span{font-size:11px;font-weight:700;color:#1e293b}
#regOut .reg-ivpv-values b{font-size:20px;color:#0b4b8a}
#regOut .reg-ivpv-note{padding:8px 10px;border:1px solid #bfdbfe;border-radius:9px;background:#eff6ff;color:#334155}

</style>
<!-- K16C270 2026-09-07: runtime apply konsolidace ostrov - fastApply menice bez historickeho input/change/calculate; XML worker a ohrev beze zmeny. -->
<style id="fve-k16c271-professional-alt-topology-css">
</style>
<style id="k16c275-battery-tech-summary-typography">
/* K16C275: Technický souhrn baterie = stejná typografie jako ostatní technické souhrny. */
html body:not(.print-protocol) #batteryTechSummary .fve-pro-tech-title{font-family:Arial,sans-serif!important;font-size:15px!important;font-weight:800!important;line-height:normal!important}
html body:not(.print-protocol) #batteryTechSummary .fve-pro-tech-grid span{font-family:Arial,sans-serif!important;font-size:12px!important;font-weight:400!important;line-height:1.3!important}
html body:not(.print-protocol) #batteryTechSummary .fve-pro-tech-grid b{font-family:Arial,sans-serif!important;font-size:13px!important;font-weight:700!important;line-height:normal!important}
html body:not(.print-protocol) #batteryTechSummary .fve-pro-tech-note{font-family:Arial,sans-serif!important;font-size:13px!important;font-weight:400!important;line-height:normal!important}
</style>
<style id="fve-k16c344-wiring-clean-css">
/* K16C345: pravá technická tabulka zůstává odstraněná, ale samotné schéma
   má původní velikost 105 mm a je pouze vystředěné v dostupné ploše. */
html body:not(.print-protocol) #connectionDiagram .fve-wiring-split{
  grid-template-columns:minmax(0,1fr)!important;
  justify-items:center!important;
}
html body:not(.print-protocol) #connectionDiagram .fve-wiring-stage{
  width:210mm!important;
  max-width:100%!important;
  height:auto!important;
  aspect-ratio:1526/890!important;
  margin:0 auto!important;
}
html body:not(.print-protocol) #k16aOffgridTechnicalSummary{display:none!important;}
@media print{
  #connectionDiagram .fve-wiring-split{grid-template-columns:minmax(0,1fr)!important;justify-items:center!important;}
  #connectionDiagram .fve-wiring-stage{width:210mm!important;max-width:100%!important;height:auto!important;aspect-ratio:1526/890!important;margin:0 auto!important;}
}
</style>
<style id="fve-k16c344-evaluation-css">
#customerSummaryCard .fve-unified-result-operational{margin-top:6px;}
#customerSummaryCard .fve-unified-result-operational li{background:transparent!important;border-color:var(--line,#d1d5db)!important;}
</style>
<style id="fve-k16c347-offgrid-pdf-settings-css">
#pdfPreviewModal.fve-offgrid-preview-mode>.modal{
  width:min(1100px,96vw)!important;
  max-width:none!important;
  max-height:none!important;
  min-height:0!important;
  overflow:visible!important;
}
#pdfPreviewModal.fve-offgrid-preview-mode #fveOffgridProtocolSettings{
  display:block!important;
  margin:0!important;
  padding:14px 20px!important;
  background:#f8fafc!important;
  border:1px solid #cbd5e1!important;
  border-radius:14px!important;
}
#pdfPreviewModal.fve-offgrid-preview-mode #fveOffgridProtocolSettings h3{
  margin:0 0 10px!important;
  padding:0 0 8px!important;
  border-bottom:1px solid #cbd5e1!important;
  color:#0f172a!important;
  font:700 17px/1.35 Arial,sans-serif!important;
}
#pdfPreviewModal.fve-offgrid-preview-mode .fve-offgrid-settings-grid{
  display:grid!important;
  grid-template-columns:1fr 1fr!important;
  gap:6px 32px!important;
}
#pdfPreviewModal.fve-offgrid-preview-mode .fve-offgrid-settings-grid>div{
  display:flex!important;
  align-items:center!important;
  min-height:34px!important;
}
#pdfPreviewModal.fve-offgrid-preview-mode .fve-offgrid-settings-grid label{
  display:flex!important;
  align-items:center!important;
  gap:8px!important;
  margin:0!important;
  color:#334155!important;
  font:600 13px/1.35 Arial,sans-serif!important;
}
#pdfPreviewModal.fve-offgrid-preview-mode .fve-offgrid-settings-grid input[type="checkbox"]{
  width:16px!important;
  height:16px!important;
  min-width:16px!important;
  min-height:16px!important;
  margin:0!important;
}
#pdfPreviewModal.fve-offgrid-preview-mode #fveOffgridProtocolSettings .small{
  margin:8px 0 0!important;
  color:#475569!important;
  font-size:12px!important;
}
#pdfPreviewModal.fve-offgrid-preview-mode #printCustomerStep{
  display:block!important;
}
#pdfPreviewModal.fve-offgrid-preview-mode #printPreviewContent{
  display:block!important;
  min-height:220px!important;
  overflow:visible!important;
}
#pdfPreviewModal.fve-offgrid-preview-mode #fveK5RProtocol{
  display:block!important;
  margin:0 auto!important;
  width:196mm!important;
  max-width:100%!important;
}
@media(max-width:700px){
  #pdfPreviewModal.fve-offgrid-preview-mode .fve-offgrid-settings-grid{
    grid-template-columns:1fr!important;
  }
}
</style>
<style id="fve-k16c349-protocol-live-charts-css">
#fveK5RProtocol .r-chart{
  display:grid!important;
  grid-template-columns:1fr!important;
  gap:12px!important;
}
#fveK5RProtocol .r-protocol-chart-image{
  display:block!important;
  width:100%!important;
  max-width:100%!important;
  height:auto!important;
  object-fit:contain!important;
  background:#fff!important;
}
@media print{
  #fveK5RProtocol .r-protocol-chart-image{
    width:100%!important;
    max-height:105mm!important;
    object-fit:contain!important;
  }
}
</style>
<style id="fve-k16c351-pdf-assembly-css">#fveK5RProtocol .r-product h4{margin:10px 0 5px;font-size:10.5pt;letter-spacing:.02em}#fveK5RProtocol .r-product h4:first-child{margin-top:0}</style>
<style id="fve-k16c352-customer-evaluation-css">
#fveK5RProtocol .r-customer-evaluation{display:grid;gap:10px}
#fveK5RProtocol .r-customer-status,#fveK5RProtocol .r-eval-explain{border:1px solid #d9e0e7;border-radius:8px;padding:10px 12px;break-inside:avoid}
#fveK5RProtocol .r-customer-status{display:flex;flex-direction:column;gap:3px}
#fveK5RProtocol .r-customer-status.ok{border-left:5px solid #2e8b57}
#fveK5RProtocol .r-customer-status.warn,#fveK5RProtocol .r-eval-explain.warn{border-left:5px solid #d88916}
#fveK5RProtocol .r-customer-status.bad,#fveK5RProtocol .r-eval-explain.bad{border-left:5px solid #b63838}
#fveK5RProtocol .r-eval-explain.info{border-left:5px solid #3979b8}
#fveK5RProtocol .r-eval-explain h4{margin:0 0 6px;font-size:10.5pt}
#fveK5RProtocol .r-eval-explain p,#fveK5RProtocol .r-eval-explain ul{margin:0;font-size:9.5pt;line-height:1.4}
#fveK5RProtocol .r-eval-explain ul{padding-left:19px}
</style>
<style id="fve-k16c353-pdf-unify-css">
#fveK5RProtocol .r-customer-evaluation,
#fveK5RProtocol .r-customer-evaluation *{
  font-family:Arial,Helvetica,sans-serif!important;
  font-style:normal;
}
#fveK5RProtocol .r-customer-status{font-size:9.7px!important;line-height:1.32!important;font-weight:400!important}
#fveK5RProtocol .r-customer-status b{font-size:10.5px!important;line-height:1.25!important;font-weight:900!important}
#fveK5RProtocol .r-eval-explain h4{font-size:10.5px!important;line-height:1.25!important;font-weight:900!important}
#fveK5RProtocol .r-eval-explain p,
#fveK5RProtocol .r-eval-explain ul,
#fveK5RProtocol .r-eval-explain li{font-size:9.7px!important;line-height:1.32!important;font-weight:400!important}
#fveK5RProtocol .r-chart.r-chart-pair{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;
  gap:3mm!important;
  align-items:start!important;
  min-height:0!important;
}
#fveK5RProtocol .r-chart.r-chart-pair .r-protocol-chart-image{
  display:block!important;width:100%!important;height:auto!important;max-height:67mm!important;object-fit:contain!important;min-width:0!important;
}
@media print{
  #fveK5RProtocol .r-chart.r-chart-pair{display:grid!important;grid-template-columns:1fr 1fr!important;gap:3mm!important}
  #fveK5RProtocol .r-chart.r-chart-pair .r-protocol-chart-image{width:100%!important;height:auto!important;max-height:67mm!important}
}
</style>
<style id="fve-k16c355-smaller-pdf-wiring-css">
#fveK5RProtocol .r-schema-crop{
  width:72%!important;
  max-width:140mm!important;
  margin-left:auto!important;
  margin-right:auto!important;
}
html body.print-preview-open #pdfPreviewModal #printPreviewContent #fveK5RProtocol .r-schema-crop,
html body.print-protocol #fveK5RProtocol .r-schema-crop{
  width:72%!important;
  max-width:140mm!important;
  margin-left:auto!important;
  margin-right:auto!important;
}
@media print{
  body.print-protocol .protocol-wiring-image-only .fve-wiring-stage{
    width:140mm!important;
    max-width:100%!important;
    margin:0 auto!important;
  }
}
</style>
<style id="fve-k16c356-pdf-black-evaluation-text-css">
/* PDF/Tisk: stavové barvy nesmí barvit text zákaznického vyhodnocení. */
#fveK5RProtocol .r-customer-evaluation,
#fveK5RProtocol .r-customer-evaluation *,
#fveK5RProtocol .r-customer-status,
#fveK5RProtocol .r-customer-status *,
#fveK5RProtocol .r-eval-explain,
#fveK5RProtocol .r-eval-explain *{
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
}
@media print{
  body.print-protocol #fveK5RProtocol .r-customer-evaluation,
  body.print-protocol #fveK5RProtocol .r-customer-evaluation *,
  body.print-protocol #fveK5RProtocol .r-customer-status,
  body.print-protocol #fveK5RProtocol .r-customer-status *,
  body.print-protocol #fveK5RProtocol .r-eval-explain,
  body.print-protocol #fveK5RProtocol .r-eval-explain *{
    color:#000000!important;
    -webkit-text-fill-color:#000000!important;
  }
}
</style>
<style id="fve-k16c357-water-like-evaluation-css">
#fveK5RProtocol .r-offgrid-evaluation{
  border:1px solid #d9dde1!important;
  border-radius:1.5mm!important;
  padding:2mm!important;
  background:#ffffff!important;
  color:#000000!important;
  font-family:Arial,Helvetica,sans-serif!important;
  font-size:10.2px!important;
  line-height:1.35!important;
}
#fveK5RProtocol .r-offgrid-evaluation *{
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
  font-family:Arial,Helvetica,sans-serif!important;
}
#fveK5RProtocol .r-offgrid-status{
  padding:0 0 2mm 0!important;
  margin:0 0 2mm 0!important;
  border-bottom:1px solid #d9dde1!important;
}
#fveK5RProtocol .r-offgrid-status>b{
  display:block!important;
  margin:0 0 .8mm 0!important;
  font-size:11px!important;
  line-height:1.25!important;
  font-weight:900!important;
}
#fveK5RProtocol .r-offgrid-status>div{
  margin:0!important;
  font-size:10.2px!important;
  line-height:1.35!important;
}
#fveK5RProtocol .r-offgrid-eval-group{
  margin:0!important;
  padding:1.5mm 0!important;
  border:0!important;
  background:#ffffff!important;
}
#fveK5RProtocol .r-offgrid-eval-group+.r-offgrid-eval-group{
  border-top:1px solid #e5e7eb!important;
}
#fveK5RProtocol .r-offgrid-eval-group>b{
  display:block!important;
  margin:0 0 1mm 0!important;
  font-size:9.7px!important;
  line-height:1.25!important;
  font-weight:900!important;
  letter-spacing:.01em!important;
}
#fveK5RProtocol .r-offgrid-eval-group ul{
  margin:0!important;
  padding-left:5mm!important;
  font-size:10.2px!important;
  line-height:1.35!important;
