<style id="k13e-hide-main-controls-on-project-gate-v2">
html.k13e-project-gate-visible #fveTopControls,
html.k13e-project-gate-visible #mobileCleanMenuBtn{
  display:none!important;
  visibility:hidden!important;
  opacity:0!important;
  pointer-events:none!important;
}
</style>
<style id="k13e-results-evaluation-unified-typography">
/* Pouze Výsledky + Vyhodnocení; vstupní tabulky se nemění. */
#fveK6RWater #wWaterResultsGrid td,
#fveK6RWater #wWaterResultsGrid th,
#fveK6RWater #wWaterResultsGrid .k10w-energy-grid > div > span,
#fveK6RWater #wWaterResultsGrid .k10w-energy-grid > div > b,
#fveK6RWater #wWaterResultsGrid .k12a-row > span,
#fveK6RWater #wWaterResultsGrid .k12a-row > b,
#fveK6RWater #wWaterResultsGrid .k8s-result-body span,
#fveK6RWater #wWaterResultsGrid .k8s-result-body b,
#fveK6RWater #wWaterResultsGrid .k8s-result-body strong,
#fveK6RWater #wWaterResultsGrid .k8s-result-body div,
#fveK6RWater #wWaterEvaluation td,
#fveK6RWater #wWaterEvaluation th,
#fveK6RWater #wWaterEvaluation span,
#fveK6RWater #wWaterEvaluation b,
#fveK6RWater #wWaterEvaluation strong,
#fveK6RWater #wWaterEvaluation li,
#fveK6RWater #wStatus p,
#fveK6RWater #wStatus li,
#fveK6RWater #wStatus span,
#fveK6RWater #wStatus b{
  font-size:11px!important;
  line-height:1.25!important;
}
#fveK6RWater #wWaterResultsGrid td:first-child,
#fveK6RWater #wWaterResultsGrid .k10w-energy-grid > div > span,
#fveK6RWater #wWaterResultsGrid .k12a-row > span{
