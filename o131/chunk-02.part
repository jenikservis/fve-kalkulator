<script id="k2hy-pwm-calculation-core">
(function(){
  'use strict';
  if(window.__FVE_K2HY_PWM_CALCULATION_CORE__) return;
  window.__FVE_K2HY_PWM_CALCULATION_CORE__=true;

  function n(value){ value=Number(value); return Number.isFinite(value)?value:0; }
  function clamp(value,min,max){ return Math.max(min,Math.min(max,value)); }

  window.FVE_PWM_ReferencePower=function(input){
    input=input||{};
    var declared=Math.max(0,n(input.fieldWp));
    var series=Math.max(0,n(input.series));
    var parallel=Math.max(0,n(input.parallel));
    var vmp=Math.max(0,n(input.vmp));
    var imp=Math.max(0,n(input.imp));
    var ivPower=series>0&&parallel>0&&vmp>0&&imp>0 ? series*parallel*vmp*imp : 0;
    var mismatchPct=declared>0&&ivPower>0 ? Math.abs(declared-ivPower)/declared*100 : 0;
    var consistent=!(declared>0&&ivPower>0) || mismatchPct<=10;
    var used=declared||ivPower;
    if(!consistent) used=Math.min(declared,ivPower);
    return {declaredWp:declared,ivWp:ivPower,usedWp:used,mismatchPct:mismatchPct,consistent:consistent};
  };

  window.FVE_PWM_Evaluate=function(input){
    input=input||{};
    var vmpStc=Math.max(0,n(input.vmpStc));
    var vmpHot=Math.max(0,n(input.vmpHot)||vmpStc);
    var chargeV=Math.max(0,n(input.chargeV));
    var workingV=Math.max(0,n(input.workingV)||chargeV);
    var vocCold=Math.max(0,n(input.vocCold));
    var maxVoc=Math.max(0,n(input.maxVoc));
    var ratioStc=chargeV>0?vmpStc/chargeV:0;
    var ratioHot=chargeV>0?vmpHot/chargeV:0;
    var lossPct=vmpStc>0 ? (1-clamp(workingV/vmpStc,0,1))*100 : 0;
    var state='info', code='waiting', text='PWM kontrola čeká na úplné údaje.';
    if(vmpStc<=0||chargeV<=0){
      return {state:state,code:code,text:text,vmpStc:vmpStc,vmpHot:vmpHot,chargeV:chargeV,workingV:workingV,vocCold:vocCold,maxVoc:maxVoc,ratioStc:ratioStc,ratioHot:ratioHot,lossPct:lossPct};
    }
    if(maxVoc>0&&vocCold>=maxVoc){ state='bad'; code='voc'; text='PWM: zimní Voc dosahuje nebo překračuje Max. Voc regulátoru.'; }
    else if(ratioHot<1.05){ state='bad'; code='vmp-hot-low'; text='PWM: Vmp panelů po zahřátí nestačí pro spolehlivé dosažení nabíjecího napětí baterie.'; }
    else if(ratioHot<1.10){ state='warn'; code='vmp-hot-reserve'; text='PWM: rezerva Vmp po zahřátí je malá; ověřte I-V křivku panelu a kabelové úbytky.'; }
    else if(ratioStc>1.55){ state='warn'; code='vmp-high-severe'; text='PWM: Vmp je výrazně vyšší než nabíjecí napětí; velká část výkonu se nevyužije.'; }
    else if(ratioStc>1.35){ state='warn'; code='vmp-high'; text='PWM: Vmp je vyšší než vhodné pásmo; část výkonu se nevyužije.'; }
    else { state='ok'; code='ok'; text='PWM: zimní Voc je pod Max. Voc a napětí panelů odpovídá baterii po teplotní korekci.'; }
    return {state:state,code:code,text:text,vmpStc:vmpStc,vmpHot:vmpHot,chargeV:chargeV,workingV:workingV,vocCold:vocCold,maxVoc:maxVoc,ratioStc:ratioStc,ratioHot:ratioHot,lossPct:lossPct};
  };
})();
</script>
<script id="fve-k16c381-pwm-voltage-policy-selftest">
(function(){
  try{
    var eq=window.FVE_PWM_Evaluate({vmpStc:36,vmpHot:32,chargeV:28.4,workingV:27,vocCold:100,maxVoc:100});
    window.__FVE_K16C381_PWM_POLICY_SELFTEST__={atMaxVoc:eq.state,pass:eq.state==='bad'};
    if(!window.__FVE_K16C381_PWM_POLICY_SELFTEST__.pass) console.error('K16C381: PWM Max. Voc politika neprošla.',window.__FVE_K16C381_PWM_POLICY_SELFTEST__);
  }catch(e){window.__FVE_K16C381_PWM_POLICY_SELFTEST__={pass:false,error:String(e)}}
})();
</script>
<style id="fve-k2pr-regulator-compatibility-inherits-parent-state">
/* K2PR: Napěťová kompatibilita je fyzická část tabulky Regulátor.
