/* Light / Dark přepínač + profi dashboard grafy */
:root,
html{
  --bg:#f4f6f8;
  --card:#ffffff;
  --card-soft:#f8fafc;
  --line:#d1d5db;
  --line-soft:#e5e7eb;
  --text:#111827;
  --muted:#4b5563;
  --blue:#2563eb;
  --ok:#047857;
  --warn:#b45309;
  --bad:#b91c1c;
  --chart-grid:rgba(15,23,42,.10);
  --chart-tick:#475569;
  --chart-prod:#2563eb;
  --chart-cons:#f59e0b;
  --chart-diff:#16a34a;
  --chart-diff-neg:#dc2626;
  --chart-soc:#7c3aed;
  --tab-bg:rgba(255,255,255,.90);
  --tab-line:rgba(15,23,42,.12);
  --tab-text:#111827;
}

/* Světlý režim – bílé pole + černé písmo */
html input,
html select,
html textarea{
  background:#f8fafc!important;
  color:#000000!important;
}

.chart-box{
  border:1px solid var(--line);
  border-radius:18px;
  padding:12px;
  background:linear-gradient(180deg,var(--card),var(--card-soft));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.05), 0 8px 24px rgba(0,0,0,.08);
}

@media(max-width:700px){
.chart-box{height:280px!important;padding:10px}
}

/* Mobilní app upgrade: větší mapa,
iOS list cards,
sticky hlavičky a swipe scroll */
#map{
  height:480px!important;
  border:2px solid var(--line)!important;
  box-shadow:0 10px 28px rgba(0,0,0,.18);
}

@media(max-width:900px){
#map{height:430px!important;}
}

.card{
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
}

.card table:not(.protocol-table){
  border-collapse:separate!important;
  border-spacing:0!important;
  border:1px solid var(--line)!important;
  border-radius:14px!important;
  overflow:hidden!important;
  background:rgba(148,163,184,.05)!important;
  box-shadow:0 8px 22px rgba(0,0,0,.10);
}

.card table:not(.protocol-table) th{
  position:sticky;
  top:0;
  z-index:3;
  background:var(--card)!important;
  color:var(--text)!important;
  border-bottom:2px solid var(--line)!important;
}

.card table:not(.protocol-table) th,
.card table:not(.protocol-table) td{
  border-bottom:1px solid var(--line)!important;
  padding:10px!important;
}

@media(max-width:700px){
