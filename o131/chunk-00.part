.diagram-arrow{font-size:24px;color:#64748b}

.energy-flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px}

.flow-box{border:1px solid #cbd5e1;background:#f8fafc;border-radius:10px;padding:10px;text-align:center}

.flow-value{font-size:20px;font-weight:bold}



@page{size:A4 portrait;margin:10mm}
@media print{
