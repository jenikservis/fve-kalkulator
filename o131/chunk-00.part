<!-- AUDIT OPRAVA 1 2026-06-30: start/barveni tabulek slouceno do KROK21 authority; odstraneno KROK41 duplicitni jadro a KROK62 casovane prebarvovani. -->
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport"/>
<script id="fve-clean-single-boot-init">
(function(){try{document.documentElement.classList.add('fve-hard-booting');}catch(e){}})();
</script>
<style id="fve-clean-single-boot-css">
@keyframes fveBootStableSpin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
html.fve-hard-booting,html.fve-hard-booting body{background:#f4f6f8!important;background-color:#f4f6f8!important;background-image:none!important;overflow:hidden!important;}
html.fve-hard-booting body > *:not(#fveStartupOverlay){visibility:hidden!important;opacity:0!important;pointer-events:none!important;}
html.fve-hard-booting body > #fveStartupOverlay{display:grid!important;visibility:visible!important;opacity:1!important;pointer-events:none!important;}
html:not(.fve-hard-booting) #fveStartupOverlay{display:none!important;visibility:hidden!important;opacity:0!important;}
#fveStartupOverlay{position:fixed!important;inset:0!important;width:100vw!important;height:100vh!important;width:100dvw!important;height:100dvh!important;z-index:2147483647!important;display:grid!important;place-items:center!important;background:#f4f6f8!important;background-image:none!important;margin:0!important;padding:0!important;box-sizing:border-box!important;opacity:1!important;visibility:visible!important;pointer-events:none!important;}
#fveBootBoxStable{width:min(485px,calc(100vw - 48px))!important;width:min(485px,calc(100dvw - 48px))!important;min-height:118px!important;display:grid!important;grid-template-columns:42px minmax(0,1fr)!important;column-gap:20px!important;align-items:center!important;justify-self:center!important;align-self:center!important;padding:30px 32px!important;margin:0!important;border:1px solid #cbd5e1!important;border-radius:16px!important;background:#ffffff!important;color:#111827!important;box-shadow:0 20px 44px rgba(15,23,42,.08)!important;font-family:'Segoe UI',Arial,sans-serif!important;box-sizing:border-box!important;}
#fveBootSpinnerStable{width:40px!important;height:40px!important;min-width:40px!important;min-height:40px!important;border-radius:50%!important;border:3px solid #dbeafe!important;border-top-color:#3b82f6!important;background:transparent!important;box-shadow:none!important;animation:fveBootStableSpin .9s linear infinite!important;will-change:transform!important;box-sizing:border-box!important;}
#fveBootCopyStable{min-width:0!important;width:100%!important;display:block!important;padding:0!important;margin:0!important;font-family:'Segoe UI',Arial,sans-serif!important;}
#fveBootTitleStable{font-family:'Segoe UI',Arial,sans-serif!important;font-size:20px!important;line-height:22px!important;font-weight:700!important;margin:0 0 6px!important;padding:0!important;color:#111827!important;-webkit-text-fill-color:#111827!important;}
#fveBootTextStable{font-family:'Segoe UI',Arial,sans-serif!important;font-size:13px!important;line-height:18px!important;font-weight:400!important;margin:0!important;padding:0!important;color:#111827!important;-webkit-text-fill-color:#111827!important;}
@media(max-width:560px){#fveBootBoxStable{grid-template-columns:38px minmax(0,1fr)!important;width:calc(100dvw - 32px)!important;min-height:112px!important;padding:24px 20px!important;column-gap:16px!important;}#fveBootSpinnerStable{width:38px!important;height:38px!important;min-width:38px!important;min-height:38px!important;}#fveBootTitleStable{font-size:18px!important;line-height:21px!important;}}

@media(max-width:700px){
  .mobile-mode .chart-grid,
  .mobile-mode .charts-grid,
  .mobile-mode .results-graphs,
