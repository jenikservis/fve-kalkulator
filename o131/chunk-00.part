body.print-protocol #printProtocolPage{display:block!important}

#printProtocolPage{display:block!important}
}

#printProtocolPage{display:none}

.protocol-grid{display:block;grid-template-columns:1fr;gap:0}

.protocol-box{border:1px solid #ccc;border-radius:6px;padding:6px;margin-bottom:6px;background:#fff}

