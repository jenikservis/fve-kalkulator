    min-width:680px;
  }

.card::after{
    content:'';
    display:block;
    clear:both;
  }
}

#monthBlock{
  overflow-x:auto!important;
  -webkit-overflow-scrolling:touch;
}



/* Kabely a jištění jako iOS list cards */
#cableOut{
  overflow:visible;
}

.cable-card-list{
  display:grid!important;
  grid-template-columns:repeat(auto-fit,minmax(290px,1fr))!important;
  gap:14px!important;
  padding:2px 0 4px;
}

.cable-card{
  background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.035))!important;
  border:1px solid var(--line)!important;
  border-radius:22px!important;
  padding:0!important;
  overflow:hidden!important;
  box-shadow:0 14px 34px rgba(0,0,0,.18)!important;
}

.cable-card h4{
  margin:0!important;
  padding:14px 16px!important;
  font-size:16px!important;
  font-weight:800!important;
  letter-spacing:-.01em;
  background:rgba(148,163,184,.12)!important;
  border-bottom:1.5px solid var(--line)!important;
}

.cable-row{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  gap:14px!important;
  align-items:center!important;
  padding:12px 16px!important;
  border-top:1px solid rgba(148,163,184,.28)!important;
  min-height:42px;
}

.cable-row:first-of-type{border-top:none!important;}

.cable-label{
  color:var(--muted)!important;
  line-height:1.25;
}

.cable-value{
  color:var(--text)!important;
  font-weight:800!important;
  text-align:right!important;
  white-space:nowrap;
}

.cable-status{
  margin:12px 16px 16px!important;
  padding:11px 12px!important;
  border-radius:999px!important;
  border:1px solid currentColor!important;
  text-align:center!important;
  font-weight:800!important;
  background:rgba(255,255,255,.04);
}

@media(max-width:700px){
.cable-card-list{display:block!important;}

.cable-card{margin-bottom:14px!important;}

.cable-row{grid-template-columns:minmax(0,1fr) auto!important;}

.cable-value{text-align:right!important;}
}

/* Mobilní režim bez vodorovného posunu a bez zkratek */
html,
body{
  max-width:100%;
  overflow-x:hidden;
}

img,
canvas,
svg,
iframe{
  max-width:100%;
}

.mobile-mode{
  width:100%;
  overflow-x:hidden!important;
}

.mobile-mode .grid,
.mobile-mode .grid-2,
.mobile-mode .protocol-grid,
.mobile-mode .project-actions{
  display:block!important;
  grid-template-columns:1fr!important;
}

.mobile-mode .card,
.mobile-mode .protocol-box{
  width:100%!important;
  max-width:100%!important;
  overflow-x:hidden!important;
  box-sizing:border-box!important;
}

.mobile-mode input,
.mobile-mode select,
.mobile-mode textarea,
.mobile-mode button,
.mobile-mode .buttonlink{
  width:100%!important;
  max-width:100%!important;
  box-sizing:border-box!important;
  white-space:normal!important;
  word-break:normal!important;
  overflow-wrap:anywhere!important;
  line-height:1.25!important;
}

.mobile-mode #map{
  width:100%!important;
  max-width:100%!important;
  height:360px!important;
}

.mobile-mode .chart-box{
  width:100%!important;
  height:260px!important;
  overflow:hidden!important;
}

.mobile-mode .card table:not(.protocol-table),
.mobile-mode table{
  min-width:0!important;
  width:100%!important;
  max-width:100%!important;
  table-layout:fixed!important;
  font-size:12px!important;
}

.mobile-mode th,
.mobile-mode td{
  white-space:normal!important;
  overflow-wrap:break-word!important;
  word-break:normal!important;
  hyphens:none!important;
  text-align:left!important;
  padding:7px 5px!important;
}

.mobile-mode #monthBlock{
  overflow-x:hidden!important;
}


.mobile-mode .cable-card-list{
  display:block!important;
  width:100%!important;
}

.mobile-mode .cable-card{
  width:100%!important;
  max-width:100%!important;
  box-sizing:border-box!important;
}

.mobile-mode .cable-row{
  grid-template-columns:1fr!important;
  gap:4px!important;
}

.mobile-mode .cable-value{
  text-align:left!important;
  white-space:normal!important;
  overflow-wrap:anywhere!important;
}





@media(max-width:700px){
.mobile-mode body,
body.mobile-mode{
    padding-bottom:calc(196px + env(safe-area-inset-bottom))!important;
  }
}

/* FVE návrhový protokol: vždy jedna strana,
tabulky pod sebou */
.protocol-grid{
  display:block!important;
  grid-template-columns:1fr!important;
  gap:0!important;
}

.protocol-box{
  width:100%!important;
  max-width:100%!important;
  box-sizing:border-box!important;
  break-inside:auto;
  page-break-inside:auto;
}

.protocol-table{
  table-layout:fixed;
  width:100%!important;
}

.protocol-table td{
  white-space:normal!important;
  word-break:normal!important;
  overflow-wrap:anywhere!important;
}

.protocol-table td:first-child{width:42%;}

.protocol-table td:last-child{width:58%;}

.protocol-charts{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  align-items:start;
}

.protocol-chart-card{
  border:1px solid #cccccc;
  border-radius:6px;
  padding:6px;
  background:#f8fafc!important;
  break-inside:auto;
  page-break-inside:auto;
}

.protocol-chart-title{
  font-size:11px;
  font-weight:bold;
  margin:0 0 4px;
  color:#000000!important;
}

.protocol-chart-img{
  display:block;
  width:100%;
  height:auto;
  background:#f8fafc!important;
}

@media(max-width:700px){
.protocol-charts{grid-template-columns:1fr;}
}

@media print{
html,
body{
    background:#ffffff!important;
    color:#000000!important;
    -webkit-print-color-adjust:exact;
    print-color-adjust:exact;
  }

body.print-protocol,
body.print-protocol *{
    background:#ffffff!important;
    color:#000000!important;
    box-shadow:none!important;
    text-shadow:none!important;
  }

body.print-protocol #printProtocolPage{
    display:block!important;
    background:#ffffff!important;
    color:#000000!important;
    width:100%!important;
    max-width:100%!important;
  }

body.print-protocol .protocol-grid{
    display:block!important;
    grid-template-columns:1fr!important;
    gap:0!important;
  }

body.print-protocol .protocol-box{
    display:block!important;
    width:100%!important;
    max-width:100%!important;
    border:1px solid #bbbbbb!important;
    background:#ffffff!important;
    color:#000000!important;
    margin:0 0 5px 0!important;
    padding:6px!important;
    break-inside:auto!important;
    page-break-inside:auto!important;
  }

body.print-protocol .protocol-table{
    width:100%!important;
    table-layout:fixed!important;
    background:#ffffff!important;
    color:#000000!important;
  }

body.print-protocol .protocol-table td{
    border-bottom:1px solid #e5e5e5!important;
    background:#ffffff!important;
    color:#000000!important;
    white-space:normal!important;
    overflow-wrap:anywhere!important;
  }

body.print-protocol .protocol-table td:first-child{
    width:42%!important;
    color:#333333!important;
    text-align:left!important;
  }

body.print-protocol .protocol-table td:last-child{
    width:58%!important;
    color:#000000!important;
    text-align:right!important;
    font-weight:bold!important;
  }
}

.protocol-map-img,
.protocol-map-frame{
  display:block;
  width:100%;
  height:240px;
  max-height:240px;
  object-fit:cover;
  border:1px solid #cccccc;
  border-radius:6px;
  background:#f8fafc!important;
}

.protocol-map-frame{overflow:hidden;}

.protocol-map-static{
  display:block;
  position:relative;
  width:100%;
  height:240px;
  max-height:240px;
  overflow:hidden;
  border:1px solid #cccccc;
  border-radius:6px;
  background:#f3f4f6!important;
}

.protocol-map-static img{
  position:absolute;
  width:256px;
  height:256px;
  max-width:none!important;
  border:0!important;
}

.protocol-map-marker{
  position:absolute;
  left:50%;
  top:50%;
  width:16px;
  height:16px;
  margin-left:-8px;
  margin-top:-16px;
  background:#b83b3b!important;
  border:2px solid #ffffff!important;
  border-radius:50% 50% 50% 0;
  transform:rotate(-45deg);
  box-shadow:0 1px 4px rgba(0,0,0,.45)!important;
  z-index:5;
}
.protocol-map-marker::after{
  content:'';
  position:absolute;
  left:4px;
  top:4px;
  width:4px;
  height:4px;
  background:#f8fafc!important;
  border-radius:50%;
}

.protocol-map-attrib{
  position:absolute;
  right:4px;
  bottom:2px;
  z-index:6;
  font-size:7px;
  line-height:1;
  color:#333!important;
  background:rgba(255,255,255,.75)!important;
  padding:2px 3px;
  border-radius:3px;
}

.protocol-map-top{
  margin-top:6px;
  margin-bottom:6px;
}

.protocol-map-top h3{
  margin:0 0 5px;
}

.protocol-map-note{
  font-size:10px;
  margin-top:4px;
  color:#333333!important;
}

.protocol-location-detail{
  margin-top:0;
}

.protocol-location-detail .protocol-table td:first-child{
  width:32%;
}

.protocol-location-detail .protocol-table td:last-child{
  width:68%;
}

@media print{
body.print-protocol #printProtocolPage .protocol-map-img,
body.print-protocol #printProtocolPage .protocol-map-frame,
body.print-protocol #printProtocolPage .protocol-map-static{
    display:block!important;
    width:100%!important;
    height:240px!important;
    max-height:240px!important;
    object-fit:cover!important;
    border:1px solid #cccccc!important;
  }

body.print-protocol #printProtocolPage .protocol-map-note{
    font-size:8px!important;
    color:#333333!important;
  }
}


body.print-preview-open #pdfPreviewModal .modal,
body.print-preview-open #printPreviewContent,
body.print-preview-open #printPreviewContent *{
  background:#f8fafc!important;
  color:#000000!important;
  border-color:#cccccc!important;
  box-shadow:none!important;
  text-shadow:none!important;
}

body.print-preview-open #pdfPreviewModal{
  background:rgba(255,255,255,.28)!important;
}

body.print-preview-open #pdfPreviewModal .modal{
  background:#f8fafc!important;
  color:#000000!important;
}

body.print-preview-open #printPreviewContent{
  background:#ffffff!important;
  color:#000000!important;
  border:1px solid #dddddd!important;
  border-radius:0!important;
  box-sizing:border-box!important;
  max-width:100%!important;
  overflow-x:hidden!important;
}

body.print-preview-open #printProtocolPreviewClone{
  display:block!important;
  background:#ffffff!important;
  color:#000000!important;
  width:100%!important;
  max-width:190mm!important;
  margin:0 auto!important;
}

body.print-preview-open #printProtocolPreviewClone .protocol-grid{
  display:block!important;
  grid-template-columns:1fr!important;
}

body.print-preview-open #printProtocolPreviewClone .protocol-box{
  display:block!important;
  width:100%!important;
  max-width:100%!important;
  background:#ffffff!important;
  color:#000000!important;
  border:1px solid #bbbbbb!important;
  box-sizing:border-box!important;
}

body.print-preview-open #printProtocolPreviewClone .protocol-table,
body.print-preview-open #printProtocolPreviewClone .protocol-table td{
  background:#ffffff!important;
  color:#000000!important;
  border-color:#e5e5e5!important;
}

body.print-preview-open #printProtocolPreviewClone .protocol-table td:first-child{
  color:#333333!important;
  text-align:left!important;
}

body.print-preview-open #printProtocolPreviewClone .protocol-table td:last-child{
  color:#000000!important;
  text-align:right!important;
  font-weight:bold!important;
}

body.print-preview-open #pdfPreviewModal .modal-actions,
body.print-preview-open #pdfPreviewModal .modal-actions *{
  background:#ffffff!important;
  color:#000000!important;
}

body.print-preview-open #pdfPreviewModal .modal-actions button{
  background:#f8fafc!important;
  color:#ffffff!important;
  border-color:#cbd5e1!important;
  box-shadow:none!important;
}

@media(max-width:700px){
body.print-preview-open #pdfPreviewModal{padding:8px!important;}

body.print-preview-open #pdfPreviewModal .modal{width:96vw!important;max-width:96vw!important;padding:8px!important;}

body.print-preview-open #printPreviewContent{padding:6mm!important;}

body.print-preview-open #printProtocolPreviewClone{width:100%!important;max-width:100%!important;}
}


@media print{
  @page{background:#ffffff!important;margin:10mm!important;}
  html,
  body{
    background:#ffffff!important;
    color:#000000!important;
    margin:0!important;
    padding:0!important;
    min-height:0!important;
    overflow:visible!important;
    -webkit-print-color-adjust:exact!important;
    print-color-adjust:exact!important;
  }
  body::before,
  body::after{
    display:none!important;
    content:none!important;
  }
  body.print-protocol > *:not(#printProtocolPage){
    display:none!important;
    visibility:hidden!important;
  }
  body.print-protocol #pdfPreviewModal,
body.print-protocol .modal-backdrop{
    display:none!important;
    visibility:hidden!important;
    opacity:0!important;
    background:#ffffff!important;
  }
  body.print-protocol #printProtocolPage{
    display:block!important;
    visibility:visible!important;
    position:static!important;
    inset:auto!important;
    width:100%!important;
    max-width:100%!important;
    min-height:0!important;
    margin:0!important;
    padding:0!important;
    background:#ffffff!important;
    color:#000000!important;
    box-shadow:none!important;
    filter:none!important;
  }
  body.print-protocol #printProtocolPage,
  body.print-protocol #printProtocolPage *{
    background:#ffffff!important;
    color:#000000!important;
    box-shadow:none!important;
    text-shadow:none!important;
    filter:none!important;
  }
  body.print-protocol #printProtocolPage .protocol-box{
    border:1px solid #bbbbbb!important;
    margin:0 0 5px 0!important;
    padding:6px!important;
    break-inside:auto!important;
    page-break-inside:auto!important;
  }
  body.print-protocol #printProtocolPage .protocol-table td{
    border-bottom:1px solid #e5e5e5!important;
  }
}

/* Náhled Tisk/PDF: spodní část modalu je také vždy bílá */
body.print-preview-open #pdfPreviewModal .modal,
body.print-preview-open #printPreviewContent{
  background:#ffffff!important;
  box-shadow:0 10px 30px rgba(0,0,0,.20)!important;
}

body.print-preview-open #printPreviewContent::after{
  content:'';
  display:block;
  height:1px;
  background:#ffffff!important;
}

/* Final fix: po návratu z tisku zůstává náhled bílý a mobilní spodní lišta je stejná jako klasická */
body.print-preview-open,
body.print-preview-open #pdfPreviewModal,
body.print-preview-open #pdfPreviewModal .modal,
body.print-preview-open #printPreviewContent,
body.print-preview-open #printPreviewContent *{
  background-color:#ffffff!important;
  color:#000000!important;
  border-color:#cccccc!important;
}

body.print-preview-open #pdfPreviewModal{
  background:rgba(244,246,248,.96)!important;
}

body.print-preview-open #pdfPreviewModal .modal-actions button{
  background:#f8fafc!important;
  color:#ffffff!important;
}





body.mobile-mode #mobileToggleBtn{
  grid-column:auto!important;
}

@media(max-width:700px){
body.mobile-mode{
    padding-bottom:calc(96px + env(safe-area-inset-bottom))!important;
  }
}

/* PVGIS-like grafy: čisté měsíční sloupce,
čitelná osa a papírový podklad */
.chart-box{
  background:linear-gradient(180deg,var(--card),var(--card-soft))!important;
  border:1px solid var(--line)!important;
  border-radius:16px!important;
  padding:14px!important;
}

@media(max-width:700px){
.chart-box{height:320px!important;padding:10px!important;}
}

/* Tlačítko načtení polohy v mapě */
#mapWrap{
  position:relative;
  border-radius:12px;
  overflow:hidden;
}

#mapWrap #map{
  width:100%;
}

#pvgisMapBtn{
  position:absolute;
  left:12px;
  bottom:12px;
  z-index:1200;
  width:auto!important;
  max-width:calc(100% - 24px);
  margin:0!important;
  padding:10px 14px!important;
  min-height:42px!important;
  border-radius:14px!important;
  background:#f8fafc!important;
  color:#ffffff!important;
  border:1px solid rgba(255,255,255,.35)!important;
  box-shadow:0 6px 18px rgba(0,0,0,.35)!important;
  font-size:13px!important;
  line-height:1.1!important;
  white-space:nowrap;
}

#pvgisMapBtn:disabled{
  opacity:.75;
  cursor:not-allowed;
}

@media(max-width:700px){
#pvgisMapBtn{
    left:10px;
    bottom:10px;
    font-size:12px!important;
    padding:9px 12px!important;
  }
}


/* VERZE 223: dvě samostatné akce v mapě – lokální ČR a online PVGIS */
.pvgis-map-actions{
  position:absolute;
  left:12px;
  bottom:12px;
  z-index:1200;
  display:grid;
  grid-template-columns:minmax(170px,auto) minmax(170px,auto);
  gap:8px;
  max-width:calc(100% - 24px);
}
.pvgis-map-actions #pvgisMapBtn,
.pvgis-map-actions #pvgisOnlineBtn{
  position:static!important;
  left:auto!important;
  bottom:auto!important;
  width:auto!important;
  max-width:none!important;
  margin:0!important;
  white-space:normal!important;
}
#pvgisOnlineBtn{
  background:#f8fafc!important;
  color:#111827!important;
  border:1px solid #cbd5e1!important;
}
#pvgisOnlineBtn.pvgis-loading{background:#facc15!important;color:#111827!important;}
#pvgisOnlineBtn.pvgis-done{background:#16a34a!important;color:#ffffff!important;}
#pvgisOnlineBtn.pvgis-error{background:#dc2626!important;color:#ffffff!important;}
@media(max-width:700px){
  .pvgis-map-actions{left:10px;bottom:10px;grid-template-columns:1fr;right:10px;max-width:none;}
}

@media print{
#mapWrap,
#pvgisMapBtn,
#pvgisOnlineBtn{display:none!important}
}

/* Přehledná měsíční karta místo široké tabulky */
#monthBlock{overflow:visible!important;max-height:none;}


.month-card-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:12px;
  margin-top:10px;
}

.month-card{
  border:1px solid var(--line);
  border-radius:18px;
  background:linear-gradient(180deg,var(--card),var(--card-soft,#f8fafc));
  box-shadow:0 8px 22px rgba(0,0,0,.08);
  overflow:hidden;
}

.month-card-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  padding:12px 14px;
  border-bottom:1px solid var(--line);
  background:rgba(148,163,184,.10);
}

.month-card-title{font-weight:600;font-size:16px;}

.month-card-badge{
  font-size:11px;
  font-weight:600;
  padding:4px 8px;
  border-radius:999px;
  border:1px solid currentColor;
  white-space:nowrap;
}

.month-card-body{padding:8px 14px 12px;}

.month-row{
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  gap:12px;
  align-items:center;
  padding:8px 0;
  border-bottom:1px solid rgba(148,163,184,.22);
}

.month-row:last-child{border-bottom:none;}

.month-label{color:var(--muted);font-size:13px;}

.month-value{font-weight:600;text-align:right;white-space:nowrap;}

@media(max-width:700px){
.month-card-grid{grid-template-columns:1fr;}

.month-row{grid-template-columns:1fr auto;}
}

@media print{
.month-card{box-shadow:none!important;break-inside:auto;}
}

/* Jednotné zvýraznění hlavních výpočtových částí */
.calc-highlight{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(145px,1fr));
  gap:10px;
  margin:0 0 12px;
}

.calc-metric{
  border:1px solid var(--line);
  border-radius:16px;
  padding:12px;
  background:linear-gradient(180deg,rgba(37,99,235,.08),rgba(37,99,235,.03));
  box-shadow:0 8px 22px rgba(15,23,42,.08);
}

.calc-label{
  font-size:11px;
  color:var(--muted);
  margin-bottom:5px;
}

.calc-value{
  font-size:22px;
  line-height:1.1;
  font-weight:700;
  color:var(--blue);
}

.calc-value.ok{color:var(--ok)!important}

.calc-value.bad{color:var(--bad)!important}

.calc-note{
  grid-column:1 / -1;
  font-size:11px;
  color:var(--muted);
  padding:8px 10px;
  border-radius:12px;
  border:1px solid var(--line);
  background:var(--card-soft);
}

@media print{
.calc-highlight{grid-template-columns:repeat(4,1fr)!important;gap:5px!important;margin-bottom:6px!important}

.calc-metric{box-shadow:none!important;border:1px solid #ccc!important;background:#fff!important;padding:6px!important;border-radius:6px!important}

.calc-label{font-size:8px!important;color:#333!important;margin-bottom:2px!important}

.calc-value{font-size:12px!important;color:#000!important}

.calc-value.ok{color:#047857!important}

.calc-value.bad{color:#b91c1c!important}

.calc-note{font-size:8px!important;background:#fff!important;color:#333!important;border-color:#ccc!important;padding:4px!important}
}

/* Zvýraznění měniče ve výpočtech */
.inverter-highlight{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(145px,1fr));
  gap:10px;
  margin:0 0 12px;
}

.inverter-metric{
  border:1px solid var(--line);
  border-radius:16px;
  padding:12px;
  background:linear-gradient(180deg,rgba(37,99,235,.08),rgba(37,99,235,.03));
  box-shadow:0 8px 22px rgba(15,23,42,.08);
}

.inverter-label{
  font-size:11px;
  color:var(--muted);
  margin-bottom:5px;
}

.inverter-value{
  font-size:22px;
  line-height:1.1;
  font-weight:700;
  color:var(--blue);
}

.inverter-value.ok{color:var(--ok)!important}

.inverter-value.bad{color:var(--bad)!important}

.inverter-note{
  grid-column:1 / -1;
  font-size:11px;
  color:var(--muted);
  padding:8px 10px;
  border-radius:12px;
  border:1px solid var(--line);
  background:var(--card-soft);
}

@media print{
.inverter-highlight{grid-template-columns:repeat(4,1fr)!important;gap:5px!important;margin-bottom:6px!important}

.inverter-metric{box-shadow:none!important;border:1px solid #ccc!important;background:#fff!important;padding:6px!important;border-radius:6px!important}

.inverter-label{font-size:8px!important;color:#333!important;margin-bottom:2px!important}

.inverter-value{font-size:12px!important;color:#000!important}

.inverter-value.ok{color:#047857!important}

.inverter-value.bad{color:#b91c1c!important}

.inverter-note{font-size:8px!important;background:#fff!important;color:#333!important;border-color:#ccc!important;padding:4px!important}
}

/* Finální úprava: hodnoty kabelů a jištění na jeden řádek */
.calc-metric .calc-value{
  font-size:clamp(12px,2.3vw,14px);
  white-space:nowrap;
  letter-spacing:-0.2px;
}

.cable-value{
  font-size:clamp(12px,2.3vw,14px)!important;
  white-space:nowrap!important;
  letter-spacing:-0.2px;
}

/* TOP verze 1 výsledkových karet – větší hlavní hodnoty a jednotný dashboard styl */
.calc-highlight{
  grid-template-columns:repeat(auto-fit,minmax(170px,1fr))!important;
  gap:12px!important;
  margin:0 0 14px!important;
}

.calc-metric{
  position:relative;
  overflow:hidden;
  min-height:92px;
  border:1px solid rgba(37,99,235,.22)!important;
  border-radius:20px!important;
  padding:14px 14px 13px!important;
  background:linear-gradient(180deg,rgba(37,99,235,.105),rgba(37,99,235,.035))!important;
  box-shadow:0 12px 30px rgba(15,23,42,.10)!important;
}

.calc-metric::before{
  content:'';
  position:absolute;
  left:0;right:0;top:0;
  height:4px;
  background:linear-gradient(90deg,var(--blue),rgba(37,99,235,.20));
}

.calc-label{
  font-size:12px!important;
  line-height:1.2!important;
  color:var(--muted)!important;
  margin-bottom:8px!important;
  font-weight:800!important;
  letter-spacing:.01em;
}

.calc-value,
.calc-metric .calc-value{
  font-size:clamp(24px,3.9vw,34px)!important;
  line-height:1.04!important;
  font-weight:950!important;
  color:var(--blue)!important;
  letter-spacing:-.035em!important;
  white-space:normal!important;
}

.calc-value.ok{color:var(--ok)!important}

.calc-value.bad{color:var(--bad)!important}

.calc-note{
  margin-top:0!important;
  border-radius:16px!important;
  padding:10px 12px!important;
  font-size:12px!important;
}

/* Kabelový souhrn má delší hodnoty typu 4 mm² / 16 A,
proto zůstává kompaktní a na jeden řádek */
.cable-summary-highlight .calc-metric{
  min-height:82px!important;
}

.cable-summary-highlight .calc-value,
.cable-summary-highlight .calc-metric .calc-value{
  font-size:clamp(15px,2.45vw,20px)!important;
  line-height:1.08!important;
  white-space:nowrap!important;
  letter-spacing:-.025em!important;
}

@media(max-width:700px){
.calc-highlight{
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
    gap:9px!important;
  }

.calc-metric{
    min-height:86px!important;
    padding:12px 10px!important;
    border-radius:17px!important;
  }

.calc-label{
    font-size:11px!important;
    margin-bottom:7px!important;
  }

.calc-value,
.calc-metric .calc-value{
    font-size:clamp(21px,7vw,27px)!important;
  }

.cable-summary-highlight .calc-value,
.cable-summary-highlight .calc-metric .calc-value{
    font-size:clamp(13px,4.2vw,16px)!important;
  }
}

@media print{
.calc-highlight{grid-template-columns:repeat(4,1fr)!important;gap:5px!important;margin-bottom:6px!important}

.calc-metric{min-height:auto!important;box-shadow:none!important;border:1px solid #ccc!important;background:#fff!important;padding:6px!important;border-radius:6px!important}

.calc-metric::before{display:none!important}

.calc-label{font-size:8px!important;color:#333!important;margin-bottom:2px!important}

.calc-value,
.calc-metric .calc-value{font-size:12px!important;color:#000!important;white-space:normal!important;letter-spacing:0!important}

.cable-summary-highlight .calc-value,
.cable-summary-highlight .calc-metric .calc-value{font-size:10px!important;white-space:nowrap!important}

.calc-value.ok{color:#047857!important}

.calc-value.bad{color:#b91c1c!important}
}

/* Finální sjednocení výsledkových karet – menší jednotné hodnoty */
.calc-highlight{
  grid-template-columns:repeat(auto-fit,minmax(170px,1fr))!important;
  gap:11px!important;
}

.calc-metric{
  min-height:82px!important;
  padding:12px 12px 11px!important;
  border-radius:18px!important;
}

.calc-label{
  font-size:12px!important;
  line-height:1.2!important;
  margin-bottom:7px!important;
}

.calc-value,
.calc-metric .calc-value{
  font-size:clamp(18px,2.8vw,24px)!important;
  line-height:1.12!important;
  font-weight:850!important;
  letter-spacing:-.02em!important;
  white-space:normal!important;
}

.cable-summary-highlight .calc-metric{
  min-height:112px!important;
}

.cable-stack{
  display:grid;
  gap:4px;
  line-height:1.15;
  font-size:clamp(14px,2.2vw,18px)!important;
  letter-spacing:-.015em!important;
}

.cable-stack-row{
  display:flex;
  justify-content:space-between;
  gap:8px;
  border-top:1px solid rgba(148,163,184,.28);
  padding-top:4px;
}

.cable-stack-row:first-child{
  border-top:none;
  padding-top:0;
}

.cable-stack-label{
  color:var(--muted);
  font-size:.72em;
  font-weight:600;
  letter-spacing:0;
}

.cable-stack-value{
  color:inherit;
  font-weight:700;
  white-space:nowrap;
}

@media(max-width:700px){
.calc-highlight{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}

.calc-metric{min-height:78px!important;padding:10px 9px!important}

.calc-label{font-size:10.5px!important;margin-bottom:6px!important}

.calc-value,
.calc-metric .calc-value{font-size:clamp(17px,5.5vw,22px)!important}

.cable-summary-highlight .calc-metric{min-height:106px!important}

.cable-stack{font-size:clamp(12px,3.9vw,15px)!important}
}

@media print{
.calc-value,
.calc-metric .calc-value{font-size:11px!important;letter-spacing:0!important}

.cable-summary-highlight .calc-metric{min-height:auto!important}

.cable-stack{font-size:9px!important;gap:2px!important}

.cable-stack-row{padding-top:2px!important;gap:4px!important}
}

/* verze 1 – větší hodnoty v souhrnu Kabely a jištění */
.cable-summary-highlight .calc-metric{
  min-height:118px!important;
}

.cable-summary-highlight .cable-stack{
  font-size:clamp(16px,2.7vw,22px)!important;
  gap:6px!important;
  line-height:1.16!important;
}

.cable-summary-highlight .cable-stack-row{
  gap:10px!important;
  padding-top:6px!important;
}

.cable-summary-highlight .cable-stack-row:first-child{
  padding-top:0!important;
}

.cable-summary-highlight .cable-stack-label{
  font-size:.68em!important;
}

.cable-summary-highlight .cable-stack-value{
  font-weight:950!important;
  white-space:nowrap!important;
}

@media(max-width:700px){
.cable-summary-highlight .calc-metric{min-height:112px!important}

.cable-summary-highlight .cable-stack{font-size:clamp(14px,4.3vw,18px)!important}
}

@media print{
.cable-summary-highlight .cable-stack{font-size:10px!important;gap:2px!important}
}

/* verze 1 – kompaktní výška tabulek a výsledkových karet */
body{
  line-height:1.32!important;
}

.card{
  padding:10px 12px!important;
  margin-bottom:10px!important;
}

.card h2{
  margin-bottom:8px!important;
}

.card h3{
  margin-bottom:6px!important;
}

.calc-highlight{
  gap:8px!important;
  margin-bottom:10px!important;
}

.calc-metric{
  min-height:68px!important;
  padding:9px 10px 8px!important;
  border-radius:15px!important;
}

.calc-metric::before{
  height:3px!important;
}

.calc-label{
  font-size:11px!important;
  margin-bottom:4px!important;
  line-height:1.12!important;
}

.calc-value,
.calc-metric .calc-value{
  font-size:clamp(17px,2.45vw,22px)!important;
  line-height:1.05!important;
}

.calc-note{
  padding:7px 9px!important;
  font-size:11.5px!important;
}

.cable-summary-highlight .calc-metric{
  min-height:88px!important;
}

.cable-summary-highlight .cable-stack{
  font-size:clamp(15px,2.35vw,20px)!important;
  gap:3px!important;
  line-height:1.08!important;
}

.cable-summary-highlight .cable-stack-row{
  padding-top:3px!important;
  gap:8px!important;
}

.cable-summary-highlight .cable-stack-label{
  font-size:.64em!important;
}

.cable-card{
  border-radius:16px!important;
}

.cable-card h4{
  padding:10px 12px!important;
  font-size:14px!important;
}

.cable-row{
  min-height:30px!important;
  padding:7px 12px!important;
  gap:8px!important;
}

.cable-status{
  margin:8px 12px 12px!important;
  padding:8px 10px!important;
}

.month-card{
  padding:10px!important;
}

.month-row{
  padding:4px 0!important;
}

th,
td{
  padding:5px!important;
}

@media(max-width:700px){
.card{padding:9px 10px!important;margin-bottom:9px!important}

.calc-highlight{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important}

.calc-metric{min-height:64px!important;padding:8px 8px 7px!important}

.calc-label{font-size:10px!important;margin-bottom:3px!important}

.calc-value,
.calc-metric .calc-value{font-size:clamp(16px,5vw,20px)!important}

.cable-summary-highlight .calc-metric{min-height:82px!important}

.cable-summary-highlight .cable-stack{font-size:clamp(13px,4vw,16px)!important}
}

@media print{
.card{padding:5px!important;margin:3px 0!important}

.calc-highlight{gap:4px!important;margin-bottom:4px!important}

.calc-metric{min-height:auto!important;padding:5px!important}

.calc-label{font-size:7.5px!important;margin-bottom:1px!important}

.calc-value,
.calc-metric .calc-value{font-size:10px!important;line-height:1.05!important}

.cable-summary-highlight .cable-stack{font-size:8.5px!important;gap:1px!important}

.cable-summary-highlight .cable-stack-row{padding-top:1px!important}
}

/* verze 1 – větší hodnoty,
menší rámečky */
.calc-highlight{
  gap:7px!important;
  margin-bottom:8px!important;
}

.calc-metric{
  min-height:58px!important;
  padding:6px 8px 6px!important;
  border-radius:12px!important;
}

.calc-metric::before{
  height:2px!important;
}

.calc-label{
  font-size:10px!important;
  margin-bottom:2px!important;
  line-height:1.08!important;
}

.calc-value,
.calc-metric .calc-value{
  font-size:clamp(20px,3.2vw,28px)!important;
  line-height:1.02!important;
  font-weight:950!important;
  letter-spacing:-.03em!important;
}

.calc-note{
  padding:6px 8px!important;
  font-size:11px!important;
  border-radius:10px!important;
}

.cable-summary-highlight .calc-metric{
  min-height:72px!important;
}

.cable-summary-highlight .cable-stack{
  font-size:clamp(17px,2.8vw,23px)!important;
  gap:2px!important;
  line-height:1.04!important;
}

.cable-summary-highlight .cable-stack-row{
  padding-top:2px!important;
  gap:8px!important;
}

.cable-summary-highlight .cable-stack-label{
  font-size:.58em!important;
}

.cable-summary-highlight .cable-stack-value{
  font-weight:950!important;
}

.card{
  padding:8px 10px!important;
  margin-bottom:8px!important;
}

.card h2{margin-bottom:6px!important}

.card h3{margin-bottom:4px!important}

@media(max-width:700px){
.calc-highlight{gap:6px!important}

.calc-metric{min-height:56px!important;padding:6px 7px!important;border-radius:11px!important}

.calc-label{font-size:9.5px!important;margin-bottom:2px!important}

.calc-value,
.calc-metric .calc-value{font-size:clamp(18px,6vw,24px)!important}

.cable-summary-highlight .calc-metric{min-height:68px!important}

.cable-summary-highlight .cable-stack{font-size:clamp(15px,4.7vw,20px)!important}
}

@media print{
.calc-metric{padding:4px!important;border-radius:5px!important}

.calc-label{font-size:7px!important}

.calc-value,
.calc-metric .calc-value{font-size:11px!important}

.cable-summary-highlight .cable-stack{font-size:9px!important}
}

/* Verze 1 – Kabely a jištění pod sebou: Průřez / Jištění */
.cable-mini-table{
  display:grid!important;
  grid-template-columns:1fr!important;
  gap:5px!important;
  width:100%!important;
  margin-top:2px!important;
}

.cable-mini-cell{
  border:1px solid rgba(148,163,184,.35)!important;
  border-radius:10px!important;
  padding:5px 6px!important;
  text-align:left!important;
  background:rgba(255,255,255,.08)!important;
  min-width:0!important;
}

.cable-mini-label{
  display:block!important;
  font-size:10px!important;
  line-height:1.05!important;
  color:var(--muted)!important;
  font-weight:800!important;
  margin-bottom:2px!important;
}

.cable-mini-value{
  display:block!important;
  font-size:clamp(18px,3.2vw,24px)!important;
  line-height:1.05!important;
  color:inherit!important;
  font-weight:950!important;
  white-space:nowrap!important;
  letter-spacing:-.03em!important;
}

@media(max-width:700px){
.cable-mini-table{gap:4px!important}

.cable-mini-cell{padding:5px 4px!important;border-radius:9px!important}

.cable-mini-label{font-size:9px!important}

.cable-mini-value{font-size:clamp(14px,4.3vw,18px)!important}
}

@media print{
.cable-mini-table{gap:2px!important}

.cable-mini-cell{padding:2px!important;border:1px solid #ccc!important;background:#fff!important;border-radius:4px!important}

.cable-mini-label{font-size:7px!important;color:#333!important;margin-bottom:1px!important}

.cable-mini-value{font-size:9px!important;color:#000!important;letter-spacing:0!important}
}

/* Zákaznické vyhodnocení systému */
.customer-summary-card{
  border-left:5px solid var(--ok)!important;
}

.customer-summary-card.summary-warn{border-left-color:var(--warn)!important}

.customer-summary-card.summary-bad{border-left-color:var(--bad)!important}

.customer-summary-headline{
  font-size:clamp(18px,3.5vw,26px);
  font-weight:700;
  line-height:1.15;
  margin:4px 0 6px;
}

.customer-summary-note{
  font-size:14px;
  color:var(--muted);
  margin:3px 0 8px;
}

.customer-summary-table{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:8px;
  margin-top:8px;
}

.customer-summary-cell{
  border:1px solid var(--line);
  border-radius:12px;
  padding:8px;
  text-align:center;
  background:var(--card-soft);
}

.customer-summary-label{
  font-size:11px;
  color:var(--muted);
  margin-bottom:3px;
}

.customer-summary-value{
  font-size:clamp(18px,4.5vw,24px);
  font-weight:700;
  line-height:1.05;
}

.customer-summary-value.ok{color:var(--ok)!important}

.customer-summary-value.warn{color:var(--warn)!important}

.customer-summary-value.bad{color:var(--bad)!important}

@media(max-width:700px){
.customer-summary-table{grid-template-columns:1fr;}

.customer-summary-cell{padding:7px;}
}

@media print{
.customer-summary-card{background:#fff!important;color:#000!important;border-left:4px solid #16a34a!important}

.customer-summary-cell{background:#fff!important;border-color:#ccc!important}

.customer-summary-headline,
.customer-summary-note,
.customer-summary-label,
.customer-summary-value{color:#000!important}
}

/* Verze 1 – otevírací podstránky pro podrobnosti a měsíční přehled */
.open-panel-actions{
  display:grid!important;
  grid-template-columns:repeat(auto-fit,minmax(180px,1fr))!important;
  gap:8px!important;
  margin:8px 0 12px!important;
}

.open-panel-actions.single{
  grid-template-columns:1fr!important;
}

.open-panel-btn,
.subpage-close-btn{
  background:var(--tab-bg,rgba(255,255,255,.90))!important;
  color:var(--tab-text,var(--text))!important;
  border:1px solid var(--tab-line,var(--line))!important;
  border-radius:22px!important;
  min-height:46px!important;
  padding:8px 12px!important;
  font-size:13px!important;
  font-weight:900!important;
  box-shadow:0 10px 26px rgba(15,23,42,.14)!important;
  margin:0!important;
}

.open-panel-btn:hover,
.subpage-close-btn:hover{
  background:rgba(148,163,184,.18)!important;
  color:var(--text)!important;
}

.subpage-backdrop{
  position:fixed!important;
  inset:0!important;
  z-index:10050!important;
  display:none!important;
  align-items:stretch!important;
  justify-content:center!important;
  padding:12px!important;
  background:rgba(244,246,248,.96)!important;
  overflow:auto!important;
  box-sizing:border-box!important;
}

.subpage-backdrop.open{
  display:flex!important;
}

body.subpage-open{
  overflow:hidden!important;
}

.subpage{
  width:min(1100px,100%)!important;
  max-height:calc(100vh - 24px)!important;
  overflow:auto!important;
  background:var(--card)!important;
  color:var(--text)!important;
  border:1px solid var(--line)!important;
  border-radius:24px!important;
  padding:12px!important;
  box-shadow:0 24px 70px rgba(0,0,0,.38)!important;
}

.subpage-header{
  position:sticky!important;
  top:0!important;
  z-index:2!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  gap:10px!important;
  align-items:center!important;
  padding:4px 0 10px!important;
  margin-bottom:8px!important;
  background:var(--card)!important;
  border-bottom:1px solid var(--line)!important;
}

.subpage-header h2{
  margin:0!important;
  font-size:20px!important;
}

.subpage-close-btn{
  width:auto!important;
  min-width:92px!important;
}

.subpage-grid{
  grid-template-columns:repeat(auto-fit,minmax(190px,1fr))!important;
  gap:8px!important;
}

.subpage-grid .card{
  border:1px solid rgba(37,99,235,.22)!important;
  border-radius:14px!important;
  padding:8px 10px!important;
  margin:0!important;
  background:linear-gradient(180deg,rgba(37,99,235,.08),rgba(37,99,235,.025))!important;
  box-shadow:0 8px 20px rgba(15,23,42,.08)!important;
  overflow:hidden!important;
}

.subpage-grid .card h3{
  color:var(--muted)!important;
  font-size:11px!important;
  line-height:1.12!important;
  margin:0 0 4px!important;
  font-weight:900!important;
}

.subpage-grid .metric{
  font-size:clamp(18px,3vw,26px)!important;
  line-height:1.08!important;
  font-weight:950!important;
}

.subpage-grid .small{
  font-size:13px!important;
  font-weight:normal!important;
}

#monthBlock.subpage-backdrop{
  max-height:none!important;
  opacity:1!important;
  margin:0!important;
  padding:12px!important;
  border:0!important;
}

#monthBlock.subpage-backdrop.closed{
  display:none!important;
}

#monthBlock.subpage-backdrop.open{
  display:flex!important;
}

.month-subpage .small{
  margin:0 0 8px!important;
}

@media(max-width:700px){
.subpage-backdrop{padding:8px!important;}

.subpage{border-radius:20px!important;max-height:calc(100vh - 16px)!important;padding:10px!important;}

.subpage-header{grid-template-columns:1fr!important;}

.subpage-close-btn{width:100%!important;}

.subpage-grid{grid-template-columns:1fr 1fr!important;gap:7px!important;}

.subpage-grid .metric{font-size:clamp(16px,5.3vw,22px)!important;}

.open-panel-actions{grid-template-columns:1fr!important;}
}

@media print{
.open-panel-actions,
.subpage-backdrop{display:none!important;}
}

/* Verze 1 – měsíční přehled zpět na stránce,
ale standardně sbalený */
#monthBlock.card{
  margin-top:8px!important;
  overflow:visible!important;
  border:1px solid var(--line)!important;
}

#monthBlock.card.closed{
  display:none!important;
  max-height:0!important;
  opacity:0!important;
  padding:0!important;
  margin:0!important;
  border-width:0!important;
}

#monthBlock.card.open{
  display:block!important;
  max-height:none!important;
  opacity:1!important;
}


@media print{
#monthBlock{display:none!important;}
}

/* Verze 1 – hlavní vyhodnocení čisté,
souhrn pokrytí je v podrobnostech */
.subpage .customer-summary-table{
  grid-template-columns:repeat(3,minmax(0,1fr));
}

.subpage .customer-summary-cell{
  padding:7px 6px!important;
}

.month-panel-action{
  margin:8px 0 6px!important;
}

@media(max-width:700px){
.subpage .customer-summary-table{grid-template-columns:1fr!important;}
}

/* Verze 1 – grafy v tiskovém protokolu/PDF vždy viditelné jako obrázky */
@media print{
  body.print-protocol #printProtocolPage .protocol-charts,
  body.print-protocol #printProtocolPage .protocol-chart-card,
  body.print-protocol #printProtocolPage .protocol-chart-title,
  body.print-protocol #printProtocolPage .protocol-chart-img{
    display:block!important;
    visibility:visible!important;
    opacity:1!important;
  }
  body.print-protocol #printProtocolPage .protocol-charts{
    display:grid!important;
    grid-template-columns:1fr 1fr!important;
    gap:6px!important;
    margin-top:4px!important;
  }
  body.print-protocol #printProtocolPage .protocol-chart-img{
    width:100%!important;
    max-width:100%!important;
    height:auto!important;
    background:#ffffff!important;
    border:0!important;
  }
}

/* Verze 1 – podrobnosti systému a kabelů se otevírají přímo na místě,
ne jako nová stránka */
.subpage-backdrop{
  position:static!important;
  inset:auto!important;
  z-index:auto!important;
  display:none!important;
  align-items:initial!important;
  justify-content:initial!important;
  padding:0!important;
  margin:8px 0 12px!important;
  background:transparent!important;
  overflow:visible!important;
  box-sizing:border-box!important;
}

.subpage-backdrop.open{
  display:block!important;
}

body.subpage-open{
  overflow:visible!important;
}

.subpage{
  width:100%!important;
  max-width:100%!important;
  max-height:none!important;
  overflow:visible!important;
  background:var(--card)!important;
  color:var(--text)!important;
  border:1px solid var(--line)!important;
  border-radius:18px!important;
  padding:10px!important;
  box-shadow:0 8px 22px rgba(15,23,42,.10)!important;
  box-sizing:border-box!important;
}

.subpage-header{
  position:static!important;
  top:auto!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  gap:8px!important;
  align-items:center!important;
  padding:0 0 8px!important;
  margin:0 0 8px!important;
  background:transparent!important;
  border-bottom:1px solid var(--line)!important;
}

.subpage-header h2{
  font-size:16px!important;
}

.subpage-close-btn{
  min-height:40px!important;
  min-width:82px!important;
  border-radius:18px!important;
  padding:7px 10px!important;
}

@media(max-width:700px){
.subpage{padding:8px!important;border-radius:16px!important;}

.subpage-header{grid-template-columns:1fr!important;}

.subpage-close-btn{width:100%!important;}
}

@media print{
.subpage-backdrop{display:none!important;}
}

/* Verze 1 finální: podrobnosti se rozbalují přímo na místě,
bez tlačítka Skrýt */
.inline-panel.subpage-backdrop{
  position:static!important;
  inset:auto!important;
  display:block!important;
  opacity:1!important;
  pointer-events:auto!important;
  background:transparent!important;
  padding:0!important;
  max-height:0!important;
  overflow:hidden!important;
  transition:max-height .32s ease, opacity .22s ease, margin .22s ease!important;
  margin:0!important;
}

.inline-panel.subpage-backdrop.open{
  max-height:2400px!important;
  opacity:1!important;
  margin:8px 0 10px!important;
}

.inline-panel.subpage-backdrop:not(.open){
  opacity:0!important;
}

.inline-panel .subpage{
  width:100%!important;
  max-width:100%!important;
  max-height:none!important;
  overflow:visible!important;
  padding:0!important;
  border:none!important;
  border-radius:0!important;
  background:transparent!important;
  box-shadow:none!important;
}

.inline-panel .subpage-header{
  display:block!important;
  margin:0 0 6px!important;
}

.inline-panel .subpage-header h2{
  margin:0!important;
  font-size:20px!important;
}

.inline-panel .subpage-close-btn{
  display:none!important;
}

.inline-panel .subpage-grid{
  margin-top:0!important;
}

@media print{
.inline-panel.subpage-backdrop{display:none!important;}
}

/* Finální stavové zobrazení PVGIS mapy – bez modrého ohraničení */
#pvgisMapBtn,
html #pvgisMapBtn{
  left:12px!important;
  right:auto!important;
  bottom:12px!important;
  border:none!important;
  outline:none!important;
  box-shadow:0 10px 26px rgba(0,0,0,.38)!important;
  color:#111827!important;
  font-weight:900!important;
  background:#facc15!important;
  text-shadow:none!important;
}

#pvgisMapBtn:focus,
#pvgisMapBtn:focus-visible,
#pvgisMapBtn:active{
  border:none!important;
  outline:none!important;
  box-shadow:0 10px 26px rgba(0,0,0,.38)!important;
}

#pvgisMapBtn.pvgis-default{
  background:linear-gradient(180deg,#fde047,#facc15)!important;
  color:#111827!important;
}

#pvgisMapBtn.pvgis-loading,
html #pvgisMapBtn.pvgis-loading{
  background:linear-gradient(180deg,#fde047,#facc15)!important;
  color:#111827!important;
  animation:none!important;
}

#pvgisMapBtn.pvgis-done,
html #pvgisMapBtn.pvgis-done{
  background:linear-gradient(180deg,#22c55e,#15803d)!important;
  color:#ffffff!important;
}

#pvgisMapBtn.pvgis-error,
html #pvgisMapBtn.pvgis-error{
  background:linear-gradient(180deg,#f87171,#dc2626)!important;
  color:#ffffff!important;
}


@keyframes pvgisPulseGlow{
  0%,100%{
    transform:scale(1);
    box-shadow:0 8px 20px rgba(0,0,0,.30),0 0 13px rgba(127,29,29,.42)!important;
    filter:saturate(.62);
  }
  50%{
    transform:scale(1.018);
    box-shadow:0 10px 24px rgba(0,0,0,.36),0 0 18px rgba(127,29,29,.55)!important;
    filter:saturate(.72);
  }
}
#pvgisState{
  display:inline-block;
  margin-top:8px!important;
  padding:0!important;
  border-radius:0!important;
  font-weight:900!important;
  border:none!important;
  background:transparent!important;
  box-shadow:none!important;
}

#pvgisState.pvgis-default-state{
  background:transparent!important;
  color:#ca8a04!important;
}

#pvgisState.pvgis-loading-state{
  background:transparent!important;
  color:#ca8a04!important;
}

#pvgisState.pvgis-done-state{
  background:transparent!important;
  color:#16a34a!important;
}

#pvgisState.pvgis-error-state{
  background:transparent!important;
  color:#dc2626!important;
}

@media(max-width:700px){
#pvgisMapBtn{left:10px!important;bottom:10px!important;font-size:12px!important;padding:9px 12px!important;}
}

/* FINÁLNÍ OPRAVA MAPY: hlavní obrazovka 480 px,
tisk/PDF a náhled PDF 240 px */
#map,
#mapWrap #map{
  height:480px!important;
}

body.print-preview-open #printProtocolPreviewClone .protocol-map-img,
body.print-preview-open #printProtocolPreviewClone .protocol-map-frame,
body.print-preview-open #printProtocolPreviewClone .protocol-map-static,
body.print-preview-open #printProtocolPreviewClone #p_map_static{
  display:block!important;
  width:100%!important;
  height:240px!important;
  max-height:240px!important;
  min-height:240px!important;
  object-fit:cover!important;
  overflow:hidden!important;
}

@media print{
body.print-protocol #printProtocolPage .protocol-map-img,
body.print-protocol #printProtocolPage .protocol-map-frame,
body.print-protocol #printProtocolPage .protocol-map-static,
body.print-protocol #printProtocolPage #p_map_static{
    display:block!important;
    width:100%!important;
    height:240px!important;
    max-height:240px!important;
    min-height:240px!important;
    object-fit:cover!important;
    overflow:hidden!important;
    border:1px solid #cccccc!important;
  }
}

.recommend-note{
  display:block;
  font-size:11px;
  line-height:1.2;
  color:var(--muted);
  margin-top:2px;
  font-weight:600;
}

/* Upgrade: bezpečnostní kontroly baterie a DC jištění */
.safety-note{
  display:block;
  margin-top:4px;
  font-size:11px;
  line-height:1.25;
  color:var(--muted);
  font-weight:600;
}

.safety-note.warn{color:var(--warn)!important}

.safety-note.bad{color:var(--bad)!important;font-weight:800}

.safety-note.ok{color:var(--ok)!important}

/* Pokročilé nastavení systému */
.advanced-losses-details{
  border:1px solid var(--line);
  border-radius:16px;
  padding:10px 12px;
  margin-top:10px;
  background:var(--card-soft,#f8fafc);
}

.advanced-losses-details summary{
  padding:2px 0;
  cursor:pointer;
  font-weight:600;
  color:var(--text);
  list-style:none;

  font-size:16px;
}

.advanced-losses-details summary::-webkit-details-marker{display:none}

.advanced-losses-details summary::after{
  content:'';
  font-size:11px;
  color:var(--muted);
  font-weight:700;
}

.advanced-losses-details[open] summary::after{
  content:'';
}

.advanced-losses-note{
  font-size:11px;
  color:var(--muted);
  margin:6px 0 2px;
}

@media print{
.advanced-losses-details{
    border:1px solid #ccc!important;
    background:#fff!important;
    padding:5px!important;
    margin-top:4px!important;
  }

.advanced-losses-details summary{
  padding:2px 0;font-size:9px!important;color:#000!important}

.advanced-losses-note{font-size:8px!important;color:#333!important}
}

/* Tlačítko otevřít/zavřít pro pokročilé nastavení */
.advanced-losses-details summary{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.advanced-toggle-btn{
  border:1px solid var(--line);
  border-radius:10px;
  padding:4px 10px;
  font-size:12px;
  font-weight:500;
  background:var(--card-soft,#f8fafc);
  color:var(--text);
  min-width:78px;
  text-align:center;
}

/* SJEDNOCENÍ PÍSMA V CELÉM SOFTWARU */
body,
input,
select,
textarea,
button,
label,
.small,
.calc-label,
.calc-value,
.card,
table,
td,
th,
div,
span{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif!important;
  font-weight:500!important;
  -webkit-font-smoothing:antialiased!important;
  -moz-osx-font-smoothing:grayscale!important;
  text-rendering:optimizeLegibility!important;
}

h1,
h2,
h3{
  font-weight:700!important;
}

.calc-value,
.metric,
.cable-mini-value{
  font-weight:700!important;
}

/* DoD automaticky pole bez možnosti ruční úpravy */
#dodDisplay{
  opacity:1!important;
  color:var(--text)!important;
}

/* Úprava horních vstupních sloupců: max. 3 na šířku + sloučený měnič/kabely */
.top-input-grid{
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  align-items:start;
}

.inverter-cables-card .merged-card-section{
  margin-top:12px;
  padding-top:10px;
  border-top:1px solid var(--line);
}

.inverter-cables-card .merged-card-section h3{
  margin-top:0!important;
}

@media(max-width:1100px){
.top-input-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;}
}

@media(max-width:700px){
.top-input-grid{grid-template-columns:1fr!important;}
}

@media print{
.top-input-grid{grid-template-columns:repeat(3,1fr)!important;}
}

/* Upgrade: Instalovaný výkon FV pole [Wp] pod výkonem panelu */
.pv-total-box{
  margin-top:8px;
  padding:10px 12px;
  border:1px solid rgba(34,197,94,.35);
  border-radius:12px;
  background:linear-gradient(180deg,rgba(34,197,94,.10),rgba(34,197,94,.035));
}

.pv-total-label{
  font-size:12px;
  color:var(--muted);
  font-weight:800;
  margin-bottom:4px;
}

.pv-total-value{
  font-size:clamp(20px,3vw,28px);
  line-height:1.05;
  font-weight:950;
  color:var(--ok);
  letter-spacing:-.03em;
}

.pv-total-sub{
  margin-top:2px;
  font-size:12px;
  color:var(--muted);
}

@media print{
.pv-total-box{border:1px solid #ccc!important;background:#fff!important;padding:5px!important}

.pv-total-label{font-size:8px!important;color:#333!important}

.pv-total-value{font-size:11px!important;color:#047857!important}

.pv-total-sub{font-size:8px!important;color:#333!important}
}

/* Úprava: Instalovaný výkon FV pole [Wp] má být pouze zobrazení hodnoty z ručního výkonu pole */
.pv-total-box{
  margin-top:8px!important;
  padding:6px 8px!important;
  border-radius:12px!important;
  border:1px solid rgba(37,99,235,.22)!important;
  background:linear-gradient(180deg,rgba(37,99,235,.105),rgba(37,99,235,.035))!important;
  box-shadow:0 8px 22px rgba(15,23,42,.08)!important;
}

.pv-total-label{
  font-size:10px!important;
  line-height:1.08!important;
  color:var(--muted)!important;
  font-weight:800!important;
  margin-bottom:2px!important;
}

.pv-total-value{
  font-size:clamp(20px,3.2vw,28px)!important;
  line-height:1.02!important;
  font-weight:950!important;
  color:var(--blue)!important;
  letter-spacing:-.03em!important;
}

.pv-total-sub{display:none!important}

/* Finální úprava: Instalovaný výkon FV pole [Wp] jako stejné pole jako Výkon panelu */
#pvTotalField.pv-total-input{
  width:100%!important;
  box-sizing:border-box!important;
  padding:8px!important;
  border:1px solid var(--line)!important;
  border-radius:12px!important;
  margin-top:4px!important;
  min-height:42px!important;
  font-size:16px!important;
  background:#050505!important;
  color:var(--text)!important;
  opacity:1!important;
  cursor:default!important;
}

html #pvTotalField.pv-total-input{
  background:#ffffff!important;
  color:var(--text)!important;
}

@media print{
#pvTotalField.pv-total-input{
    border:none!important;
    background:transparent!important;
    padding:0!important;
    margin:0!important;
    font-size:10px!important;
    color:#000000!important;
  }
}

.auto-calculated{background:rgba(148,163,184,.12)!important;}

}

/* Zvýraznění sekcí Regulátor / Baterie / Měnič přímo ve výsledkové tabulce */
#regOut table th[colspan="2"]{
  background:rgba(244,246,248,.96)!important;
  color:#000000!important;
  border-left:4px solid #000000!important;
  text-align:left!important;
  font-weight:900!important;
  font-size:14px!important;
  padding:8px 10px!important;
  border-radius:8px 8px 0 0!important;
  letter-spacing:.01em!important;
}

@media print{
#regOut table th[colspan="2"]{
    background:#f3f4f6!important;
    color:#000000!important;
    border-left-color:#000000!important;
    -webkit-print-color-adjust:exact!important;
    print-color-adjust:exact!important;
  }
}

/* Verze 1 – stav tlačítka v mapě: žlutá načítá se,
zelená načteno,
červená chyba */
#pvgisMapBtn.pvgis-loading{background:linear-gradient(180deg,#fde047,#facc15)!important;color:#111827!important;}

#pvgisMapBtn.pvgis-done{background:linear-gradient(180deg,#22c55e,#15803d)!important;color:#ffffff!important;}

#pvgisMapBtn.pvgis-error{background:linear-gradient(180deg,#f87171,#dc2626)!important;color:#ffffff!important;}

#pvgisState.pvgis-loading-state{color:#ca8a04!important;}

/* Verze 1 – údaje zákazníka pod Výroba / poloha */
.customer-box{
  margin-top:12px;
  padding:10px 12px;
  border:1px solid var(--line);
  border-radius:14px;
  background:var(--card-soft,#f8fafc);
}

.customer-box h3{
  margin:0 0 8px;
  font-size:15px;
}
.customer-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:8px 10px;
}

@media print{
.customer-box{display:none!important}
}

/* Finální úprava PDF/Tisk: číslo zakázky vedle nadpisu,
jméno přes celý řádek */
.protocol-customer-table td[colspan="2"]{
  text-align:left!important;
}

.protocol-customer-table td[colspan="2"] span{
  display:block;
  margin-top:3px;
  font-weight:bold;
  text-align:left!important;
}

@media print{
body.print-protocol .protocol-customer-table td[colspan="2"],
body.print-protocol .protocol-customer-table td[colspan="2"] span{
    text-align:left!important;
  }
}

/* PDF/Tisk – údaje zákazníka pod mapou: zakázka vedle názvu,
jméno přes celý řádek */
.protocol-customer-detail{margin-top:6px!important;}

.protocol-customer-table .customer-title-cell{width:50%!important;text-align:left!important;}

.protocol-customer-table .customer-order-cell{width:50%!important;text-align:right!important;}

.protocol-customer-table .customer-name-row td{text-align:left!important;}

.protocol-customer-table .customer-name-row span{display:block;margin-top:3px;font-weight:bold!important;}

@media print{
body.print-protocol .protocol-customer-table .customer-title-cell{width:50%!important;text-align:left!important;}

body.print-protocol .protocol-customer-table .customer-order-cell{width:50%!important;text-align:right!important;}

body.print-protocol .protocol-customer-table .customer-name-row td{text-align:left!important;}
}

/* OPRAVA: hlavní strana + PDF/Tisk zákazník */
.customer-header-line{
  display:grid;
  grid-template-columns:minmax(160px,1fr) minmax(240px,1.4fr);
  gap:10px;
  align-items:end;
  margin-bottom:8px;
}

.customer-header-line h3{
  margin:0 0 6px!important;
}

.customer-order-main label{
  margin-top:0!important;
}

.customer-full-row{
  grid-column:1 / -1;
}

.protocol-customer-table .customer-title-cell{width:34%!important;text-align:left!important;}

.protocol-customer-table .customer-order-cell{width:66%!important;text-align:left!important;white-space:normal!important;font-weight:400!important;}

.protocol-customer-table .customer-order-cell span{font-weight:400!important;}

.protocol-customer-table .customer-order-label{font-weight:700!important;}

.protocol-customer-table .customer-name-row td{
  text-align:left!important;
  font-weight:400!important;
  padding-left:3px!important;
}

.protocol-customer-table .customer-name-row span{
  display:inline!important;
  margin-top:0!important;
  font-weight:400!important;
  text-align:left!important;
}

.protocol-customer-table .customer-name-label{font-weight:400!important;}

@media(max-width:700px){
.customer-header-line{grid-template-columns:1fr;}
}

@media print{
body.print-protocol .protocol-customer-table .customer-title-cell{width:34%!important;text-align:left!important;}

body.print-protocol .protocol-customer-table .customer-order-cell{width:66%!important;text-align:left!important;white-space:normal!important;font-weight:400!important;}

body.print-protocol .protocol-customer-table .customer-name-row td,
body.print-protocol .protocol-customer-table .customer-name-row span{font-weight:400!important;text-align:left!important;display:inline!important;margin-top:0!important;}
}

/* FINAL: Údaje zákazníka – hlavní strana + Tisk/PDF */
.customer-box{
  margin-top:12px!important;
  padding:12px!important;
  border:1px solid var(--line)!important;
  border-radius:16px!important;
  background:var(--card-soft,#f8fafc)!important;
}

.customer-header-line{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) minmax(220px,340px)!important;
  gap:12px!important;
  align-items:end!important;
  margin-bottom:8px!important;
}

.customer-header-line h3{
  margin:0!important;
  font-size:16px!important;
}

.customer-order-main label{margin-top:0!important;}

.customer-grid{
  display:grid!important;
  grid-template-columns:1fr 1fr!important;
  gap:8px 12px!important;
}

.customer-full-row{grid-column:1 / -1!important;}

@media(max-width:700px){
.customer-header-line,
.customer-grid{grid-template-columns:1fr!important;}
}

/* Tisk/PDF: tabulka zákazníka pod mapou */
.protocol-customer-detail{
  margin-top:6px!important;
  margin-bottom:6px!important;
}

.protocol-customer-table{
  width:100%!important;
  table-layout:fixed!important;
}

.protocol-customer-table .customer-title-cell{
  width:30%!important;
  text-align:left!important;
  font-weight:700!important;
  white-space:nowrap!important;
}

.protocol-customer-table .customer-order-cell{
  width:70%!important;
  text-align:left!important;
  white-space:normal!important;
  overflow-wrap:anywhere!important;
  font-weight:400!important;
}

.protocol-customer-table .customer-order-label{
  font-weight:700!important;
}

.protocol-customer-table .customer-order-cell span:not(.customer-order-label){
  font-weight:400!important;
}

.protocol-customer-table .customer-name-row td{
  text-align:left!important;
  font-weight:400!important;
}

.protocol-customer-table .customer-name-label{
  font-weight:400!important;
}

.protocol-customer-table .customer-name-row span{
  display:inline!important;
  margin:0!important;
  font-weight:400!important;
}

@media print{
body.print-protocol .protocol-customer-detail{display:block!important;}

body.print-protocol .protocol-customer-table .customer-title-cell{width:30%!important;text-align:left!important;font-weight:700!important;white-space:nowrap!important;}

body.print-protocol .protocol-customer-table .customer-order-cell{width:70%!important;text-align:left!important;white-space:normal!important;overflow-wrap:anywhere!important;font-weight:400!important;}

body.print-protocol .protocol-customer-table .customer-order-label{font-weight:700!important;}

body.print-protocol .protocol-customer-table .customer-name-row td,
body.print-protocol .protocol-customer-table .customer-name-row span,
body.print-protocol .protocol-customer-table .customer-name-label{font-weight:400!important;text-align:left!important;display:inline!important;margin:0!important;}
}

/* FINÁLNÍ OPRAVA – tabulka zákazníka v Tisk/PDF jako ostatní tabulky */
.protocol-customer-detail h3{
  margin:0 0 5px!important;
  padding:0!important;
  font-size:12px!important;
  font-weight:700!important;
  text-align:left!important;
}

.protocol-customer-table{
  width:100%!important;
  table-layout:fixed!important;
}

.protocol-customer-table td:first-child{
  width:32%!important;
  text-align:left!important;
  font-weight:400!important;
  color:#333333!important;
  white-space:normal!important;
}

.protocol-customer-table td:last-child{
  width:68%!important;
  text-align:left!important;
  font-weight:400!important;
  color:#000000!important;
  white-space:normal!important;
  overflow-wrap:anywhere!important;
}

@media print{
body.print-protocol .protocol-customer-detail h3{
    margin:0 0 5px!important;
    padding:0!important;
    font-size:12px!important;
    font-weight:700!important;
    text-align:left!important;
  }

body.print-protocol .protocol-customer-table td:first-child{
    width:32%!important;
    text-align:left!important;
    font-weight:400!important;
    color:#333333!important;
  }

body.print-protocol .protocol-customer-table td:last-child{
    width:68%!important;
    text-align:left!important;
    font-weight:400!important;
    color:#000000!important;
    overflow-wrap:anywhere!important;
  }
}

/* FINAL: hlavní stránka – zkrácené pole Číslo zakázky,
zarovnané doprava */
.customer-header-line{
  grid-template-columns:minmax(0,1fr) minmax(150px,226px)!important;
  align-items:end!important;
}

.customer-order-main{
  justify-self:end!important;
  width:66%!important;
  min-width:150px!important;
  max-width:226px!important;
}

.customer-order-main label{
  display:block!important;
  text-align:left!important;
}

.customer-order-main input{
  width:100%!important;
  text-align:right!important;
}

@media(max-width:700px){
.customer-header-line{grid-template-columns:1fr!important;}

.customer-order-main{width:100%!important;max-width:none!important;justify-self:stretch!important;}

.customer-order-main input{text-align:left!important;}
}

/* Umístění údajů zákazníka nad Výroba / poloha na hlavní stránce */
.customer-card-main{
  grid-column:1 / -1!important;
}

.customer-card-main .customer-box{
  margin-top:0!important;
}

/* FINAL Verze 1 – sjednocení hlaviček tabulek a zákaznického bloku */
.card h2,
.card h3,
.protocol-box h3,
.customer-box h3{
  display:block!important;
  margin:0 0 8px 0!important;
  padding:0 0 6px 0!important;
  font-size:20px!important;
  line-height:1.2!important;
  font-weight:800!important;
  color:var(--text,#111827)!important;
  border-bottom:1.5px solid var(--line,#d1d5db)!important;
}

.protocol-box h3{
  color:#000000!important;
  border-bottom:1px solid #cccccc!important;
}

.customer-header-line{
  align-items:start!important;
}

.customer-header-line h3{
  flex:1 1 auto!important;
}

.customer-order-main{
  width:33.333%!important;
  max-width:260px!important;
  min-width:150px!important;
  margin-left:auto!important;
}

.customer-order-main input{
  text-align:right!important;
}

@media(max-width:700px){
.customer-header-line{display:block!important;}

.customer-order-main{width:100%!important;max-width:none!important;margin-left:0!important;}

.card h2,
.card h3,
.protocol-box h3,
.customer-box h3{font-size:16px!important;}
}

/* FINAL: Číslo zakázky v řádku s nadpisem Údaje zákazníka */
.customer-title-order-row{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) minmax(150px,226px)!important;
  gap:12px!important;
  align-items:end!important;
  margin-bottom:8px!important;
}

.customer-title-order-row h2{
  margin:0!important;
}

.customer-title-order-row .customer-order-main{
  justify-self:end!important;
  width:100%!important;
  min-width:150px!important;
  max-width:226px!important;
}

.customer-title-order-row .customer-order-main label{
  display:block!important;
  margin-top:0!important;
  text-align:left!important;
}

.customer-title-order-row .customer-order-main input{
  width:100%!important;
  text-align:right!important;
}

.customer-box-main .customer-header-line,
.customer-box-main .customer-order-line{
  display:none!important;
}

@media(max-width:700px){
.customer-title-order-row{grid-template-columns:1fr!important;}

.customer-title-order-row .customer-order-main{max-width:none!important;justify-self:stretch!important;}

.customer-title-order-row .customer-order-main input{text-align:left!important;}
}

/* Intuitivní průvodce prvotním návrhem */
.design-guide-panel{display:none!important;}

.design-guide-panel{
  position:relative;
  margin:10px 0 14px;
  padding:12px 14px;
  border:1px solid rgba(37,99,235,.26);
  border-radius:18px;
  background:linear-gradient(180deg,rgba(37,99,235,.10),rgba(37,99,235,.035));
  box-shadow:0 10px 26px rgba(15,23,42,.08);
}

.design-guide-title{font-weight:900;margin-bottom:4px;display:flex;align-items:center;gap:8px;}

.design-guide-title::before{content:'➜';display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:999px;background:var(--blue);color:#fff;font-size:13px;}

.design-guide-text{font-size:13px;color:var(--muted);line-height:1.35;}

.design-guide-actions{display:flex;gap:8px;align-items:center;margin-top:10px;flex-wrap:wrap;}

.design-guide-mini-btn{width:auto!important;min-height:34px!important;padding:7px 12px!important;margin:0!important;border-radius:999px!important;font-size:12px!important;}

.design-guide-progress{height:7px;border-radius:999px;background:rgba(148,163,184,.22);overflow:hidden;margin-top:10px;}

.design-guide-progress span{display:block;height:100%;width:0%;background:linear-gradient(90deg,var(--ok),var(--blue));border-radius:999px;transition:width .25s ease;}

.guide-card-next{
  border-color:rgba(37,99,235,.95)!important;
  background:linear-gradient(180deg,rgba(37,99,235,.13),rgba(37,99,235,.035))!important;
  box-shadow:0 0 0 2px rgba(37,99,235,.18),0 16px 38px rgba(37,99,235,.18)!important;
  position:relative;
}

.guide-card-next::before{display:none!important;content:none!important;}

.guide-card-done{
  border-color:rgba(4,120,87,.48)!important;
  background:linear-gradient(180deg,rgba(4,120,87,.09),rgba(4,120,87,.025))!important;
}

.guide-card-done .step-circle{
  background:#f8fafc!important;
  color:#111827!important;
  -webkit-text-fill-color:#111827!important;
  border-color:#cbd5e1!important;
}

.guide-field-next,
.guide-field-next:focus{
  border-color:var(--blue)!important;
  box-shadow:0 0 0 3px rgba(37,99,235,.18),0 8px 22px rgba(37,99,235,.10)!important;
  background:linear-gradient(180deg,rgba(37,99,235,.08),rgba(37,99,235,.025))!important;
}

.guide-field-done{
  border-color:rgba(4,120,87,.70)!important;
  background:linear-gradient(180deg,rgba(4,120,87,.08),rgba(4,120,87,.025))!important;
}

.guide-required-label{font-weight:900!important;color:var(--blue)!important;}

.guide-required-label::after{content:'';}


@keyframes guidePulse{0%,100%{box-shadow:0 0 0 3px rgba(37,99,235,.14),0 8px 22px rgba(37,99,235,.10)}50%{box-shadow:0 0 0 5px rgba(37,99,235,.25),0 12px 30px rgba(37,99,235,.18)}}
.guide-field-next{animation:guidePulse 1.8s ease-in-out infinite;}

@media(max-width:700px){
.design-guide-panel{margin:8px 0 10px;padding:10px 12px}

.guide-card-next::before{position:static;display:inline-block;margin-bottom:6px}

.design-guide-actions{display:grid;grid-template-columns:1fr}

.design-guide-mini-btn{width:100%!important}
}

@media print{
.design-guide-panel,
.guide-card-next::before{display:none!important}

.guide-card-next,
.guide-card-done,
.guide-field-next,
.guide-field-done{box-shadow:none!important;animation:none!important}
}

/* Výdrž baterie v různých režimech provozu */
.runtime-modes-box{
  margin-top:10px;
  border:1px solid var(--line);
  border-radius:16px;
  padding:10px 12px;
  background:linear-gradient(180deg,var(--card),var(--card-soft,#f8fafc));
}

.runtime-modes-box summary{
  cursor:pointer;
  font-weight:800;
  color:var(--text);
  list-style:none;
}

.runtime-modes-box summary::-webkit-details-marker{display:none}

.runtime-modes-box summary::after{
  content:'▼';
  float:right;
  font-size:11px;
  color:var(--muted);
  transition:transform .18s ease;
}

.runtime-modes-box[open] summary::after{transform:rotate(180deg)}

.runtime-modes-grid{
  display:grid;
  gap:6px;
  margin-top:10px;
}

.runtime-mode-row{
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  gap:10px;
  align-items:center;
  padding:8px 0;
  border-top:1px solid rgba(148,163,184,.28);
}

.runtime-mode-row span{color:var(--muted)}

.runtime-mode-row b{font-size:18px;color:var(--blue);white-space:nowrap}

@media print{
.runtime-modes-box{display:block!important;box-shadow:none!important;border:1px solid #ccc!important;background:#fff!important}

.runtime-modes-box summary{font-size:9px!important;color:#000!important}

.runtime-mode-row{padding:2px 0!important}

.runtime-mode-row span,
.runtime-mode-row b{font-size:8px!important;color:#000!important}
}

.auto-voltage-24v{
  color:#000000!important;
}

label[for="invPower"],
#invPower{
  color:#000000!important;
}

label,
label[for="invPower"],
.menic-label,
#invPowerLabel{
    color:#000000 !important;
}

/* Černé písmo pro text „Zadejte výkon měniče“ ve volbě systémového DC napětí */
#systemVoltage,
#systemVoltage option,
#systemVoltageDisplay,
input[value="Zadejte výkon měniče"],
input[placeholder="Zadejte výkon měniče"]{
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
}

#systemVoltage::placeholder,
input[placeholder="Zadejte výkon měniče"]::placeholder{
  color:#000000!important;
  opacity:1!important;
}

/* FIX: text „Zadejte výkon měniče“ musí být černý,
ne modrý */
input[value="Zadejte výkon měniče"],
input[placeholder="Zadejte výkon měniče"],
select option[value="auto"],
select option:checked,
#systemVoltage,
#systemVoltage option,
#dcVoltage,
#dcVoltage option,
#batteryVoltage,
#batteryVoltage option,
[id*="voltage" i],
[id*="napeti" i],
[id*="napětí" i]{
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
}

input[value="Zadejte výkon měniče"]::placeholder,
input[placeholder="Zadejte výkon měniče"]::placeholder{
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
  opacity:1!important;
}

/* Umístění: Systémové napětí přímo pod Měnič ve stejném sloupci */
@media(min-width:901px){
  .inverter-cables-card{
    grid-column:1!important;
    grid-row:auto!important;
  }
  .system-voltage-card{
    grid-column:1!important;
    grid-row:auto!important;
  }
}

/* Tabulky 3 a 4 vpravo vedle tabulky 2 */
@media(min-width:1200px){

  .grid{
    display:grid!important;
    grid-template-columns:1fr 1fr 1fr!important;
    align-items:start!important;
  }

  .inverter-cables-card{
    grid-column:3!important;
    grid-row:1!important;
  }

  .system-voltage-card{
    grid-column:3!important;
    grid-row:2!important;
  }
}

/* Tabulka 4 těsně pod tabulkou 3 */
@media(min-width:1200px){

  .inverter-cables-card{
    grid-column:3!important;
    grid-row:1!important;
    margin-bottom:6px!important;
  }

  .system-voltage-card{
    grid-column:3!important;
    grid-row:1!important;
    margin-top:340px!important;
  }
}

/* Černé písmo pro sekci Výdrž baterie */
.battery-runtime-card,
.battery-runtime-card *,
#batteryRuntime,
#batteryRuntime *,
.runtime-card,
.runtime-card *,
[class*="runtime"],
[class*="runtime"] *,
[class*="battery-life"],
[class*="battery-life"] *,
[class*="vydrz"],
[class*="vydrz"] *{
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
}

/* Menší písmo pro sekci Výdrž baterie */
.battery-runtime-card,
#batteryRuntime,
[class*="runtime"],
[class*="vydrz"]{
  font-size:13px!important;
}

.battery-runtime-card h2,
#batteryRuntime h2,
[class*="runtime"] h2,
[class*="vydrz"] h2{
  font-size:16px!important;
  font-weight:700!important;
}

.battery-runtime-card .metric,
#batteryRuntime .metric,
[class*="runtime"] .metric,
[class*="vydrz"] .metric{
  font-size:16px!important;
  font-weight:700!important;
}

/* Výsledky ve Výdrži baterie stejným písmem jako ostatní pole */
.battery-runtime-card .metric,
#batteryRuntime .metric,
[class*="runtime"] .metric,
[class*="vydrz"] .metric,
[class*="runtime"] .calc-value,
[class*="vydrz"] .calc-value{
  font-size:14px!important;
  font-weight:600!important;
  line-height:1.2!important;
  letter-spacing:0!important;
}

/* Výsledky výdrže baterie stejně velké jako hodnota 200 Ah */
.battery-runtime-card .metric,
#batteryRuntime .metric,
[class*="runtime"] .metric,
[class*="vydrz"] .metric,
[class*="runtime"] .calc-value,
[class*="vydrz"] .calc-value{
  font-size:22px!important;
  font-weight:700!important;
  line-height:1.1!important;
  letter-spacing:0!important;
}

/* PŘESNĚ stejné písmo jako input s hodnotou 200 */
#batteryRuntime .metric,
#batteryRuntime .calc-value,
#batteryRuntime strong,
#batteryRuntime b,
.battery-runtime-card .metric,
.battery-runtime-card .calc-value,
.battery-runtime-card strong,
.battery-runtime-card b{
    font-size: 16px !important;
    font-weight: 400 !important;
    font-family: Arial, sans-serif !important;
    color: #000000 !important;
    line-height: normal !important;
    letter-spacing: normal !important;
    text-shadow: none !important;
}

/* explicitně zrušit všechny předchozí zvýrazňovací styly */
#batteryRuntime *,
.battery-runtime-card *{
    font-weight: 400 !important;
}

#batteryRuntime .metric,
#batteryRuntime .calc-value,
.battery-runtime-card .metric,
.battery-runtime-card .calc-value{
    font-size:16px !important;
}

/* Menší písmo výsledků výdrže baterie */
#runtimeFull,
#runtimeNormal,
#runtimeNight,
#runtimeEmergency,
[id*="runtime" i],
[id*="vydrz" i],
[id*="výdrž" i],
[class*="runtime" i],
[class*="vydrz" i],
[class*="výdrž" i]{
  font-size:14px!important;
  font-weight:400!important;
  line-height:1.2!important;
}

/* Oprava: spodní pomocný text má stejné písmo jako horní popisky */
.small{
  font-size:13px!important;
  color:var(--muted)!important;
  font-weight:normal!important;
}

/* Oprava: zamčené pole má stejné černé písmo jako odemčené */
input:disabled,
input[readonly],
select:disabled,
textarea:disabled{
    color:#000000 !important;
    -webkit-text-fill-color:#000000 !important;
    opacity:1 !important;
    font-family:inherit !important;
    font-size:inherit !important;
    font-weight:inherit !important;
}

/* FINÁLNÍ FIX – zamčené pole vždy černé */
input:disabled,
input[readonly],
input.locked,
.locked input{
    color:#000 !important;
    -webkit-text-fill-color:#000 !important;
    caret-color:#000 !important;
    opacity:1 !important;
    filter:none !important;
    text-shadow:none !important;
    font-weight:700 !important;
    background:#ffffff !important;
}

/* FINÁLNÍ SJEDNOCENÍ – Výkon FV pole + Denní spotřeba */
input:disabled,
input[readonly],
input.locked,
.locked input,
#fvPower,
#dailyConsumption,
#fvPower:disabled,
#dailyConsumption:disabled,
#fvPower[readonly],
#dailyConsumption[readonly]{
    color:#000000 !important;
    -webkit-text-fill-color:#000000 !important;
    caret-color:#000000 !important;
    opacity:1 !important;
    filter:none !important;
    text-shadow:none !important;
    font-family:Arial,sans-serif !important;
    font-size:16px !important;
    font-weight:700 !important;
    line-height:1.2 !important;
    background:#ffffff !important;
}

/* ===== ULTRA SJEDNOCENÍ POLÍ ===== */
/* Výkon FV pole + Denní spotřeba */
/* Otevřené / zavřené / readonly / disabled = IDENTICKÝ VZHLED */

input:disabled,
input[readonly],
input.locked,
.locked input,
#fvPower,
#dailyConsumption,
[id*="fv"]:disabled,
[id*="spot"]:disabled,
[id*="consumption"]:disabled{
    appearance:none !important;
    -webkit-appearance:none !important;

    background:#ffffff !important;
    background-color:#ffffff !important;
    opacity:1 !important;

    color:#000000 !important;
    -webkit-text-fill-color:#000000 !important;
    caret-color:#000000 !important;

    border:2px solid #000000 !important;
    border-radius:10px !important;

    font-family:Arial,sans-serif !important;
    font-size:16px !important;
    font-weight:700 !important;
    line-height:1.2 !important;
    letter-spacing:0 !important;

    text-shadow:none !important;
    filter:none !important;

    box-shadow:none !important;
}

/* Produktový XML katalog – verze 4,
vyvážené obrázky nad zbožím */
.feed-card{border:1px solid var(--line);background:linear-gradient(180deg,var(--card),var(--card-soft,#f8fafc));}

.feed-actions{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin-top:8px}

.feed-toolbar{display:grid;grid-template-columns:2fr 1fr 1fr;gap:8px;margin:10px 0}

.feed-results{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-top:12px}

.feed-product{border:1px solid var(--line);border-radius:22px;padding:0;background:rgba(148,163,184,.08);display:flex!important;flex-direction:column!important;overflow:hidden;box-shadow:0 12px 30px rgba(0,0,0,.12)}

.feed-product-img-wrap{order:0!important;display:block!important;width:100%!important;background:#fff!important;border-bottom:1px solid rgba(148,163,184,.35)!important;padding:12px!important;box-sizing:border-box!important}

.feed-product-img-wrap img{display:block!important;width:100%!important;height:220px!important;max-height:220px!important;object-fit:contain!important;border-radius:14px!important;background:#fff!important;margin:0 auto!important}

.feed-product-noimg{height:220px!important;display:flex;align-items:center;justify-content:center;border-radius:14px;background:#f1f5f9;color:#64748b;font-weight:800}

.feed-product-body{order:1!important;padding:14px 16px 16px!important}

.feed-product-title{font-weight:950;font-size:17px;line-height:1.25;margin-bottom:8px}

.feed-product-meta{font-size:12px;color:var(--muted);line-height:1.4}

.feed-product-price{font-weight:950;color:var(--ok);margin-top:8px;font-size:19px}

.feed-product a{display:inline-block;color:var(--blue);font-weight:900;text-decoration:none;margin-top:9px}

.feed-badges{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}

.feed-badge{font-size:11px;border:1px solid currentColor;border-radius:999px;padding:3px 7px;color:var(--muted)}

@media(max-width:700px){
.feed-toolbar{grid-template-columns:1fr}

.feed-results{grid-template-columns:1fr}

.feed-product-img-wrap{padding:10px!important}

.feed-product-img-wrap img{height:180px!important;max-height:180px!important}

.feed-product-noimg{height:180px!important}
}

}

@media print{
.feed-card{display:none!important}
}

/* Spodní lišta: feed tlačítka přesunuta z tabulky dolů */




.feed-inline-picker .feed-actions{display:none!important;}

@media(max-width:900px){


body{padding-bottom:calc(150px + env(safe-area-inset-bottom))!important;}
}

@media(max-width:520px){


body{padding-bottom:calc(245px + env(safe-area-inset-bottom))!important;}
}

/* Opravný software: stav po načtení se zobrazuje v rozklikávacím poli,
ne dole na kartě regulátoru */

/* VERZE 3: výběrové/proklikávací pole regulátoru šedivé,
bez informačních řádků pod polem */
#regulatorFeedPicker #feedRegulatorSelect{
  background:#ffffff!important;
  color:#111827!important;
  border:1px solid #cbd5e1!important;
  font-weight:800!important;
}

/* OPRAVA VERZE 3: šedivé pozadí pouze pro tlačítko Aktualizovat výběr regulátorů z feedu */
#regulatorFeedRefreshBtn,
#regFeedRefreshBtn,
button[data-regulator-feed-refresh="1"],
.regulator-feed-refresh-btn{
  background:#e5e7eb!important;
  color:#111827!important;
  border:1px solid #9ca3af!important;
  box-shadow:none!important;
}

#regulatorFeedRefreshBtn:hover,
#regFeedRefreshBtn:hover,
button[data-regulator-feed-refresh="1"]:hover,
.regulator-feed-refresh-btn:hover{
  background:#d1d5db!important;
  color:#111827!important;
}

/* Verze 4: vycentrování textů v polích regulátoru */
#regulatorFeedRefreshBtn,
#regFeedRefreshBtn,
button[data-regulator-feed-refresh="1"],
.regulator-feed-refresh-btn,
.regulator-feed-select,
#regulatorFeedSelect{
  text-align:center!important;
  justify-content:center!important;
}

#regulatorFeedSelect option{
  text-align:center;
}

/* Verze 4: tlačítko „Katalog produktů není načten“ ve stylu Pokročilé nastavení systému */
#regulatorFeedSelect,
select[data-regulator-feed-select="1"],
.regulator-feed-select{
  background:#e5e7eb!important;
  color:#111827!important;
  border:1px solid #9ca3af!important;
  border-radius:14px!important;
  min-height:44px!important;
  font-weight:700!important;
  text-align:center!important;
  text-align-last:center!important;
  box-shadow:0 3px 10px rgba(0,0,0,.10)!important;
}

#regulatorFeedSelect:disabled,
select[data-regulator-feed-select="1"]:disabled,
.regulator-feed-select:disabled{
  opacity:1!important;
  cursor:not-allowed!important;
}

/* Oprava rozložení Typ systému */
