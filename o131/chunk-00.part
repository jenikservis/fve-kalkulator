<style id="fve-k5cp-energy-balance-css">
.fve-k5cp-energy-balance{width:100%;border-collapse:collapse}
.fve-k5cp-energy-balance th{padding:8px 10px;background:#f1f5f9;color:#0f172a;text-align:left;font-size:12px;border:1px solid #cbd5e1}
.fve-k5cp-energy-balance td{padding:7px 10px;border:1px solid #cbd5e1;vertical-align:middle}
.fve-k5cp-energy-balance td:last-child{text-align:right;font-weight:700;white-space:nowrap}
.fve-k5cp-energy-dot{display:inline-block;width:10px;height:10px;margin-right:7px;border-radius:50%;vertical-align:0}
.fve-k5cp-energy-check-ok td{color:#08751d;background:#f0fdf4}
.fve-k5cp-energy-check-bad td{color:#b91c1c;background:#fef2f2}
@media print{.fve-k5cp-energy-balance th,.fve-k5cp-energy-balance td{padding:4px 6px;font-size:9px}}
</style>
