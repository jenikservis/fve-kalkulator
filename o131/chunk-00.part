<!-- K16C254 2026-09-07: BATERIE – WARM JEN PRO TECHNICKY VYZNAMNE UPOZORNENI; CHYBEJICI VOLITELNA XML DATA A PREBYTECNA KAPACITA JSOU ADVISORY. -->

#k14fDynamicModelCard{display:none!important}
#k14hDynamicModelCard{
  display:block!important;visibility:visible!important;opacity:1!important;
  grid-column:1/-1!important;width:100%!important;box-sizing:border-box!important;
  margin:12px 0!important;
}
#k14hDynamicModelCard h3{margin:0 0 8px!important}
#k14hDynamicModelCard .k14j-auto-model-status{color:#000!important}
@media print{#k14hDynamicModelCard{break-inside:avoid!important;page-break-inside:avoid!important}}
</style>
<style id="k14f-visible-model-style">
#k14fDynamicModelCard{display:block!important;visibility:visible!important;opacity:1!important;margin:16px 0;position:relative!important;overflow:visible!important}
#k14fDynamicModelCard h3{margin:0 0 10px 0}
#k14fDynamicModelCard table,#k14fDynamicModelCard th,#k14fDynamicModelCard td{color:#000!important}
#k14fDynamicModelCard .fve-water-note{margin-top:8px;color:#000!important}
@media print{
  #k14fDynamicModelCard{break-inside:avoid;page-break-inside:avoid}
}
</style>
<style id="k14e-auto-calibration-only">
html body:not(.print-protocol) .k14d-trnsys-validation,
html body:not(.print-protocol) #wV7TrnsysComparison,
html body:not(.print-protocol) #wV7TrnsysFile,
html body:not(.print-protocol) #wV7TrnsysStatus{display:none!important}
</style>
<script id="fve-k5av-early-print-gate">
(function(){'use strict';
  if(window.__FVE_K5AV_EARLY_PRINT_GATE__)return;
  window.__FVE_K5AV_EARLY_PRINT_GATE__=true;
  function waterActive(){
    var root=document.getElementById('fveK6RWater'),stored='';
    try{stored=sessionStorage.getItem('fve_k6a_project_type_chosen')||''}catch(_){}
    return !!(
      (root&&!root.hidden) ||
      document.documentElement.classList.contains('fve-k6b-water-open') ||
      document.documentElement.dataset.fveProjectType==='water' ||
      stored==='water'
    );
  }
  function isPrintButton(b){
    if(!b)return false;
    var t=String(b.textContent||'').replace(/\s+/g,' ').trim().toLowerCase();
    return b.id==='printPdfBtn' ||
      b.getAttribute('data-print-pdf-btn')==='1' ||
      b.getAttribute('data-bottom-print-pdf-btn')==='1' ||
      t==='tisk / pdf'||t==='tisk/pdf'||t==='pdf / tisk'||t==='pdf/tisk';
  }
  window.addEventListener('click',function(e){
    var b=e.target&&e.target.closest&&e.target.closest('button,a,[role="button"]');
    if(!isPrintButton(b)||b.closest('#fveWaterPrintModal,#pdfPreviewModal'))return;
    if(!waterActive())return;
    e.preventDefault();e.stopPropagation();if(e.stopImmediatePropagation)e.stopImmediatePropagation();
    if(window.FVEWaterPrint&&typeof window.FVEWaterPrint.show==='function'){
      window.FVEWaterPrint.show();
    }else{
      setTimeout(function(){
        if(window.FVEWaterPrint&&typeof window.FVEWaterPrint.show==='function')window.FVEWaterPrint.show();
      },50);
    }
  },true);
})();
</script>
