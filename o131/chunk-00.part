}
</style><style id="final-clean-css">
:root{
  --bg:#f4f6f8;--card:#fff;--line:#d1d5db;--text:#111827;--muted:#4b5563;
  --blue:#2563eb;--ok:#047857;--warn:#b45309;--bad:#b91c1c;
}

body{font-family:Arial,sans-serif;background:var(--bg);margin:0;padding:18px;color:var(--text)}

h1{margin:0 0 6px}

h2{margin-top:0;font-size:18px}

h3{margin-bottom:8px}

.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px}

.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:14px}

.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:14px;box-shadow:0 2px 8px rgba(0,0,0,.06)}

label{display:block;font-size:13px;margin-top:9px;color:var(--muted)}

input,
select,
textarea,
button{width:100%;box-sizing:border-box;padding:8px;border:1px solid var(--line);border-radius:8px;margin-top:4px}

button,
.buttonlink{display:block;text-align:center;text-decoration:none;background:var(--blue);color:#fff;border:none;font-weight:bold;cursor:pointer;margin-top:10px;width:100%;box-sizing:border-box;padding:8px;border-radius:8px}

button.secondary{background:#64748b}

button.mobile-on{
  background:var(--ok)!important; /* zelená = zapnuto */
  color:#fff!important;
}

button.mobile-off{
  background:var(--bad)!important; /* červená = vypnuto */
  color:#fff!important;
}

table{width:100%;border-collapse:collapse;font-size:13px}

th,
td{border-bottom:1px solid #e5e7eb;padding:6px;text-align:right}

th:first-child,
td:first-child{text-align:left}

.ok,
.good{color:var(--ok);font-weight:bold}

.warn{color:var(--warn);font-weight:bold}

.bad{color:var(--bad);font-weight:bold}

.metric{font-size:22px;font-weight:bold}

.small{font-size:13px;color:var(--muted);font-weight:normal}

.profi-note{font-size:11px;color:var(--muted);background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:8px;margin-top:8px}

#map{height:330px;border-radius:12px;overflow:hidden}

#pvgisState{margin-top:8px;font-weight:bold}

.pvgis-location-box{
  margin-top:10px;
  padding:10px 12px;
  border:1px solid var(--line);
  border-radius:14px;
  background:var(--card-soft,#f8fafc);
  font-size:13px;
  line-height:1.35;
}

.pvgis-location-title{font-weight:800;margin-bottom:4px;color:var(--text)}

.pvgis-location-row{display:grid;grid-template-columns:130px 1fr;gap:8px;padding:3px 0;border-top:1px solid rgba(148,163,184,.22)}

.pvgis-location-row:first-of-type{border-top:none}

.pvgis-location-label{color:var(--muted);font-weight:700}

.pvgis-location-value{font-weight:800;color:var(--text);overflow-wrap:anywhere}

@media(max-width:700px){
.pvgis-location-row{grid-template-columns:1fr}

.pvgis-location-value{font-size:14px}
}

.chart-box{height:520px;position:relative}

#monthBlock{overflow:hidden;max-height:900px;opacity:1;transition:max-height .35s ease,opacity .25s ease,padding .25s ease,margin .25s ease}

#monthBlock.closed{max-height:0;opacity:0;padding-top:0!important;padding-bottom:0!important;margin-bottom:0!important;border-width:0!important}




#cableOut{font-size:13px}

.cable-card-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px;margin-top:8px}

.cable-card{border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.04);padding:12px;box-shadow:0 4px 14px rgba(0,0,0,.10)}

.cable-card h4{margin:0 0 10px;font-size:15px;color:var(--text)}

.cable-row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:start;border-top:1px solid rgba(148,163,184,.22);padding:7px 0}

.cable-row:first-of-type{border-top:none}

.cable-label{color:var(--muted);text-align:left}

.cable-value{text-align:right;font-weight:bold;color:var(--text)}

.cable-status{margin-top:10px;padding:8px;border-radius:10px;border:1px solid currentColor;text-align:center;font-weight:bold}

@media(max-width:700px){
.cable-card-list{display:block}

.cable-card{margin-bottom:10px}

.cable-row{grid-template-columns:1fr}

.cable-value{text-align:left}
}

@media(max-width:900px){
.grid-2{grid-template-columns:1fr}

.chart-box{height:360px}
}

@media print{
body{background:white;padding:0}

button,
.buttonlink,
#map{display:none}

.card{box-shadow:none;border:1px solid #ddd;break-inside:avoid}

input,
select,
textarea{border:none;background:transparent}
}

