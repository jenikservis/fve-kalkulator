/* PWA / iOS-Android styl UI + finální tlačítka */
:root{
  --app-black:#f8fafc;
  --app-black-hover:#eef2f7;
  --app-green:#16a34a;
  --app-red:#dc2626;
}

html{
  -webkit-text-size-adjust:100%;
  touch-action:manipulation;
}

body{
  min-height:100vh;
  padding-left:max(18px, env(safe-area-inset-left));
  padding-right:max(18px, env(safe-area-inset-right));
}

button,
.buttonlink{
  display:block;
  text-align:center;
  text-decoration:none;
  background:var(--app-black)!important;
  color:#fff!important;
  border:1px solid #cbd5e1!important;
  font-weight:700;
  cursor:pointer;
  margin-top:10px;
  width:100%;
  box-sizing:border-box;
  padding:11px 12px;
  border-radius:14px;
  min-height:44px;
  letter-spacing:.01em;
  box-shadow:0 3px 10px rgba(0,0,0,.16);
  -webkit-tap-highlight-color:transparent;
  user-select:none;
  transition:transform .12s ease, box-shadow .12s ease, background .12s ease;
}

button:hover,
.buttonlink:hover{
  background:var(--app-black-hover)!important;
  color:#fff!important;
}

button:active,
.buttonlink:active{
  transform:scale(.985);
  box-shadow:0 1px 4px rgba(0,0,0,.22);
}

button.secondary{
  background:var(--app-black)!important;
  color:#fff!important;
  border-color:var(--app-black)!important;
}

button.mobile-on{
  background:var(--app-green)!important;
  color:#fff!important;
  border-color:#cbd5e1!important;
}

button.mobile-off{
  background:var(--app-red)!important;
  color:#fff!important;
  border-color:#cbd5e1!important;
}

input,
select,
textarea{
  min-height:42px;
  border-radius:12px;
  font-size:16px;
}

.card{
  border-radius:18px;
}





@media(max-width:700px){
body{
    padding:12px;
    padding-bottom:calc(168px + env(safe-area-inset-bottom));
  }

h1{font-size:22px}

.card{padding:12px;margin-bottom:12px}





