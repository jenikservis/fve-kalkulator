/* ===== v5-final-light-blue-action-buttons-only-soc-fix ===== */

html a.buttonlink.action-light-btn[href*="pvg_tools"],
html a.buttonlink.action-light-btn[href*="re.jrc.ec.europa.eu"],
html a[href*="pvg_tools"].buttonlink,
html a[href*="re.jrc.ec.europa.eu"].buttonlink,
html button.action-light-btn[onclick="autoDesignStrings()"],
html button.action-light-btn[onclick="autoBattery()"],
html button[onclick="autoDesignStrings()"],
html button[onclick="autoBattery()"],
html #cableToggleBtn,
html .soc-open-btn button,
html .soc-open-btn button.secondary,
html .soc-open-btn button.action-light-btn,
html #pdfPreviewModal .modal-actions button,
html #pdfPreviewModal button,
html .subpage-close-btn,
body.print-preview-open #pdfPreviewModal .modal-actions button{
  background:#eaf3ff!important;
  background-image:linear-gradient(180deg,#f5faff,#dbeafe)!important;
  color:#0f172a!important;
  -webkit-text-fill-color:#0f172a!important;
  border:1px solid #93c5fd!important;
  border-radius:12px!important;
  box-shadow:0 3px 9px rgba(37,99,235,.14)!important;
  text-shadow:none!important;
}

html a.buttonlink.action-light-btn[href*="pvg_tools"]:hover,
html a.buttonlink.action-light-btn[href*="re.jrc.ec.europa.eu"]:hover,
html a[href*="pvg_tools"].buttonlink:hover,
html a[href*="re.jrc.ec.europa.eu"].buttonlink:hover,
html button.action-light-btn[onclick="autoDesignStrings()"]:hover,
html button.action-light-btn[onclick="autoBattery()"]:hover,
html button[onclick="autoDesignStrings()"]:hover,
html button[onclick="autoBattery()"]:hover,
html #cableToggleBtn:hover,
html .soc-open-btn button:hover,
html .soc-open-btn button.secondary:hover,
html .soc-open-btn button.action-light-btn:hover,
html #pdfPreviewModal .modal-actions button:hover,
html #pdfPreviewModal button:hover,
html .subpage-close-btn:hover,
body.print-preview-open #pdfPreviewModal .modal-actions button:hover{
  background:#dbeafe!important;
  background-image:linear-gradient(180deg,#eff6ff,#bfdbfe)!important;
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
  border-color:#60a5fa!important;
  box-shadow:0 4px 12px rgba(37,99,235,.20)!important;
}

html a.buttonlink.action-light-btn[href*="pvg_tools"]:active,
html a.buttonlink.action-light-btn[href*="re.jrc.ec.europa.eu"]:active,
html a[href*="pvg_tools"].buttonlink:active,
html a[href*="re.jrc.ec.europa.eu"].buttonlink:active,
html button.action-light-btn[onclick="autoDesignStrings()"]:active,
html button.action-light-btn[onclick="autoBattery()"]:active,
html button[onclick="autoDesignStrings()"]:active,
html button[onclick="autoBattery()"]:active,
html #cableToggleBtn:active,
html .soc-open-btn button:active,
html .soc-open-btn button.secondary:active,
html .soc-open-btn button.action-light-btn:active,
html #pdfPreviewModal .modal-actions button:active,
html #pdfPreviewModal button:active,
html .subpage-close-btn:active,
body.print-preview-open #pdfPreviewModal .modal-actions button:active{
  background:#bfdbfe!important;
  background-image:none!important;
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
  border-color:#3b82f6!important;
  transform:scale(.985)!important;
}

/* FINÁLNÍ POZICE: Údaje zákazníka jsou v levém sloupci nad Výroba / poloha */
.left-input-column{
  display:flex!important;
  flex-direction:column!important;
  gap:0!important;
  min-width:0!important;
}

.left-input-column .card{
  width:100%!important;
  box-sizing:border-box!important;
}

.customer-card-main{
  grid-column:auto!important;
}

.customer-card-main > h2{
  margin:0 0 8px 0!important;
}

.customer-card-main .customer-box{
  margin-top:0!important;
  padding:0!important;
  border:0!important;
  background:transparent!important;
}

.customer-order-line{
  grid-template-columns:minmax(0,1fr) minmax(150px,33.333%)!important;
  margin-bottom:8px!important;
}

.customer-order-line .customer-order-main{
  width:100%!important;
  min-width:150px!important;
  max-width:260px!important;
  justify-self:end!important;
  margin-left:auto!important;
}

@media(max-width:700px){
.left-input-column{display:block!important;}

.customer-order-line{grid-template-columns:1fr!important;}

.customer-order-line > div:first-child{display:none!important;}

.customer-order-line .customer-order-main{max-width:none!important;width:100%!important;}
}

/* FINAL FIX: hlavní strana – hlavička Údaje zákazníka se šedým podkladem,
levou odrážkou a číslem zakázky v řádku */
.customer-card-main .customer-title-bar{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) minmax(170px,32%)!important;
  gap:12px!important;
  align-items:center!important;
  margin:0 0 10px 0!important;
  padding:10px 12px 10px 14px!important;
  border:1px solid var(--line,#d1d5db)!important;
  border-left:5px solid var(--blue,#2563eb)!important;
  border-radius:14px!important;
  background:rgba(148,163,184,.14)!important;
  box-sizing:border-box!important;
}

.customer-card-main .customer-title-bar h2{
  margin:0!important;
  padding:0!important;
  border:0!important;
  background:transparent!important;
  line-height:1.15!important;
}

.customer-card-main .customer-title-bar .customer-order-main{
  justify-self:end!important;
  width:100%!important;
  max-width:260px!important;
  min-width:170px!important;
  margin:0!important;
}

.customer-card-main .customer-title-bar .customer-order-main label{
  margin:0 0 3px 0!important;
  font-size:11px!important;
  line-height:1.1!important;
  color:var(--muted,#4b5563)!important;
  font-weight:700!important;
  text-align:left!important;
}

.customer-card-main .customer-title-bar .customer-order-main input{
  margin:0!important;
  min-height:34px!important;
  padding:6px 8px!important;
  text-align:right!important;
}

@media(max-width:700px){
.customer-card-main .customer-title-bar{
    grid-template-columns:1fr!important;
    gap:8px!important;
  }

.customer-card-main .customer-title-bar .customer-order-main{
    max-width:none!important;
    min-width:0!important;
    justify-self:stretch!important;
  }

.customer-card-main .customer-title-bar .customer-order-main input{
    text-align:left!important;
  }
}

/* ===== customer-title-bar-final-color-fix ===== */
/* Oprava: odrážka hlavičky Údaje zákazníka má stejnou barvu jako ostatní tabulky. */
.customer-card-main .customer-title-bar{
  border-left-color:#000000!important;
}

@media print{
.customer-card-main .customer-title-bar{
    border-left-color:#000000!important;
  }
}

/* ===== customer-print-layout-final-fix ===== */
/* FINAL FIX: Údaje zákazníka – stejná poloha a šířky v náhledu i při skutečném tisku */
.protocol-customer-detail{
  width:100%!important;
  max-width:100%!important;
  box-sizing:border-box!important;
  margin:6px 0!important;
  break-inside:avoid!important;
  page-break-inside:avoid!important;
}

.protocol-customer-detail h3{
  display:block!important;
  margin:0 0 5px 0!important;
  padding:0 0 4px 0!important;
  font-size:12px!important;
  line-height:1.2!important;
  font-weight:700!important;
  text-align:left!important;
  color:#000!important;
  border-bottom:1px solid #cccccc!important;
}

.protocol-customer-table{
  width:100%!important;
  max-width:100%!important;
  table-layout:fixed!important;
  border-collapse:collapse!important;
}

.protocol-customer-table .protocol-customer-label-col{width:32%!important;}

.protocol-customer-table .protocol-customer-value-col{width:68%!important;}

.protocol-customer-table td{
  box-sizing:border-box!important;
  vertical-align:top!important;
  padding:3px 4px!important;
  line-height:1.25!important;
  font-size:10px!important;
  background:#ffffff!important;
  border-bottom:1px solid #e5e5e5!important;
}

.protocol-customer-table td:first-child{
  width:32%!important;
  min-width:32%!important;
  max-width:32%!important;
  text-align:left!important;
  font-weight:400!important;
  color:#333333!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-overflow:clip!important;
}

.protocol-customer-table td:last-child{
  width:68%!important;
  min-width:68%!important;
  max-width:68%!important;
  text-align:left!important;
  font-weight:400!important;
  color:#000000!important;
  white-space:normal!important;
  overflow-wrap:anywhere!important;
  word-break:normal!important;
}

body.print-preview-open #printProtocolPreviewClone .protocol-customer-detail,
body.print-protocol #printProtocolPage .protocol-customer-detail{
  display:block!important;
  position:static!important;
  float:none!important;
  width:100%!important;
  max-width:100%!important;
  margin:6px 0!important;
  padding:6px!important;
  border:1px solid #bbbbbb!important;
  background:#ffffff!important;
  color:#000000!important;
  box-sizing:border-box!important;
}

body.print-preview-open #printProtocolPreviewClone .protocol-customer-detail h3,
body.print-protocol #printProtocolPage .protocol-customer-detail h3{
  display:block!important;
  margin:0 0 5px 0!important;
  padding:0 0 4px 0!important;
  font-size:12px!important;
  line-height:1.2!important;
  font-weight:700!important;
  text-align:left!important;
  color:#000000!important;
  border-bottom:1px solid #cccccc!important;
  background:#ffffff!important;
}

body.print-preview-open #printProtocolPreviewClone .protocol-customer-table,
body.print-protocol #printProtocolPage .protocol-customer-table{
  width:100%!important;
  max-width:100%!important;
  table-layout:fixed!important;
  border-collapse:collapse!important;
}

body.print-preview-open #printProtocolPreviewClone .protocol-customer-table td,
body.print-protocol #printProtocolPage .protocol-customer-table td{
  box-sizing:border-box!important;
  vertical-align:top!important;
  padding:3px 4px!important;
  line-height:1.25!important;
  font-size:10px!important;
  background:#ffffff!important;
  border-bottom:1px solid #e5e5e5!important;
}

body.print-preview-open #printProtocolPreviewClone .protocol-customer-table td:first-child,
body.print-protocol #printProtocolPage .protocol-customer-table td:first-child{
  width:32%!important;
  min-width:32%!important;
  max-width:32%!important;
  text-align:left!important;
  font-weight:400!important;
  color:#333333!important;
  white-space:nowrap!important;
}

body.print-preview-open #printProtocolPreviewClone .protocol-customer-table td:last-child,
body.print-protocol #printProtocolPage .protocol-customer-table td:last-child{
  width:68%!important;
  min-width:68%!important;
  max-width:68%!important;
  text-align:left!important;
  font-weight:400!important;
  color:#000000!important;
  white-space:normal!important;
  overflow-wrap:anywhere!important;
}

@media print{
body.print-protocol #printProtocolPage .protocol-customer-detail{
    break-inside:avoid!important;
    page-break-inside:avoid!important;
  }
}

/* ===== customer-print-alignment-final-real ===== */
/* FINÁLNÍ OPRAVA Tisk/PDF – Údaje zákazníka: nadpis s odsazením od levé odrážky,
hodnoty zarovnané doprava */
.protocol-customer-detail h3,
body.print-preview-open #printProtocolPreviewClone .protocol-customer-detail h3,
body.print-protocol #printProtocolPage .protocol-customer-detail h3{
  margin:0 0 5px 0!important;
  padding:0 0 4px 10px!important;
  font-size:12px!important;
  line-height:1.2!important;
  font-weight:700!important;
  text-align:left!important;
  color:#000000!important;
  border-bottom:1px solid #cccccc!important;
  background:#ffffff!important;
  box-sizing:border-box!important;
}

.protocol-customer-table td:first-child,
body.print-preview-open #printProtocolPreviewClone .protocol-customer-table td:first-child,
body.print-protocol #printProtocolPage .protocol-customer-table td:first-child{
  text-align:left!important;
  font-weight:400!important;
  color:#333333!important;
}

.protocol-customer-table td:last-child,
body.print-preview-open #printProtocolPreviewClone .protocol-customer-table td:last-child,
body.print-protocol #printProtocolPage .protocol-customer-table td:last-child{
  text-align:right!important;
  font-weight:400!important;
  color:#000000!important;
  white-space:normal!important;
  overflow-wrap:anywhere!important;
  word-break:normal!important;
}

@media print{
body.print-protocol #printProtocolPage .protocol-customer-detail h3{
    padding-left:10px!important;
  }

body.print-protocol #printProtocolPage .protocol-customer-table td:last-child{
    text-align:right!important;
  }
}

/* ===== final-print-pdf-customer-above-map-titlebars ===== */
/* FINAL: Tisk/PDF – Údaje zákazníka nad mapou + jednotné rámečky nadpisů */
#printProtocolPage .protocol-box > h3,
body.print-preview-open #printProtocolPreviewClone .protocol-box > h3,
body.print-protocol #printProtocolPage .protocol-box > h3{
  display:block!important;
  width:100%!important;
  box-sizing:border-box!important;
  margin:0 0 5px 0!important;
  padding:4px 6px 4px 10px!important;
  min-height:22px!important;
  line-height:1.2!important;
  font-size:12px!important;
  font-weight:700!important;
  text-align:left!important;
  color:#000000!important;
  background:#ffffff!important;
  border:1px solid #cccccc!important;
  border-left:4px solid #000000!important;
  border-radius:4px!important;
}

#printProtocolPage .protocol-customer-detail,
body.print-preview-open #printProtocolPreviewClone .protocol-customer-detail,
body.print-protocol #printProtocolPage .protocol-customer-detail{
  order:1!important;
  width:100%!important;
  max-width:100%!important;
  margin:0 0 5px 0!important;
  padding:6px!important;
  box-sizing:border-box!important;
  break-inside:avoid!important;
  page-break-inside:avoid!important;
}

#printProtocolPage .protocol-map-top,
body.print-preview-open #printProtocolPreviewClone .protocol-map-top,
body.print-protocol #printProtocolPage .protocol-map-top{
  order:2!important;
  margin-top:0!important;
}

#printProtocolPage .protocol-customer-table,
body.print-preview-open #printProtocolPreviewClone .protocol-customer-table,
body.print-protocol #printProtocolPage .protocol-customer-table{
  width:100%!important;
  table-layout:fixed!important;
  border-collapse:collapse!important;
}

#printProtocolPage .protocol-customer-table td:first-child,
body.print-preview-open #printProtocolPreviewClone .protocol-customer-table td:first-child,
body.print-protocol #printProtocolPage .protocol-customer-table td:first-child{
  width:32%!important;
  text-align:left!important;
  font-weight:400!important;
  color:#333333!important;
  white-space:nowrap!important;
}

#printProtocolPage .protocol-customer-table td:last-child,
body.print-preview-open #printProtocolPreviewClone .protocol-customer-table td:last-child,
body.print-protocol #printProtocolPage .protocol-customer-table td:last-child{
  width:68%!important;
  text-align:right!important;
  font-weight:400!important;
  color:#000000!important;
  white-space:normal!important;
  overflow-wrap:anywhere!important;
}

@media print{
body.print-protocol #printProtocolPage .protocol-box > h3{
    padding-left:10px!important;
    border-left:4px solid #000000!important;
  }
}

/* ===== battery-inverter-second-page-print-fix ===== */
@media print{
  body.print-protocol #printProtocolPage .protocol-battery-inverter-page{
    break-before:page!important;
    page-break-before:always!important;
  }
}

body.print-preview-open #printProtocolPreviewClone .protocol-battery-inverter-page{
  break-before:page!important;
  page-break-before:always!important;
  margin-top:12mm!important;
}

/* ===== step-number-circles-final ===== */
/* Číslování postupu návrhu – výrazné malé kroužky v hlavičkách sekcí */
.step-title{display:inline-flex;align-items:center;gap:12px;line-height:1.2;}

.step-circle{
  display:inline-flex;align-items:center;justify-content:center;
  width:22px;height:22px;min-width:22px;border-radius:999px;
  background:#2563eb;color:#ffffff;font-size:12px;font-weight:900;
  box-shadow:0 2px 8px rgba(37,99,235,.28);
}

.customer-card-main .customer-title-bar h2.step-title{display:flex!important;}

.customer-card-main .customer-title-bar h2.step-title .step-circle{margin-right:0;}

.protocol-box h3 .step-circle,
.protocol-customer-detail h3 .step-circle{
  width:18px;height:18px;min-width:18px;font-size:10px;box-shadow:none;
}

@media print{
.step-circle{display:none!important;}

.protocol-box h3,
.protocol-customer-detail h3{display:block!important;}
}

/* ===== step-circle-unified-spacing-fix ===== */
/* Finální sjednocení odsazení názvů sekcí od číselného kroužku */
.step-title{
  display:inline-flex!important;
  align-items:center!important;
  gap:16px!important;
  line-height:1.2!important;
}

.customer-card-main .customer-title-bar h2.step-title{
  display:flex!important;
  align-items:center!important;
  gap:16px!important;
}

.merged-card-section > h3.step-title,
.card > h2.step-title,
.card h2.step-title,
.card h3.step-title{
  gap:16px!important;
}

.step-circle{
  flex:0 0 22px!important;
  margin-right:0!important;
}

@media print{
.step-circle{display:none!important;}
}

/* ===== step-circle-final-main-only-spacing ===== */
/* Finální oprava: číslování pouze na hlavní obrazovce,
jednotný odskok názvů od kroužků */
body:not(.print-protocol) .step-title{
  display:flex!important;
  align-items:center!important;
  gap:0!important;
  line-height:1.2!important;
}

body:not(.print-protocol) .step-title .step-circle{
  flex:0 0 22px!important;
  width:22px!important;
  height:22px!important;
  min-width:22px!important;
  margin-right:18px!important;
}

body:not(.print-protocol) .customer-card-main .customer-title-bar h2.step-title,
body:not(.print-protocol) .card > h2.step-title,
body:not(.print-protocol) .card h2.step-title,
body:not(.print-protocol) .card h3.step-title,
body:not(.print-protocol) .merged-card-section > h3.step-title{
  gap:0!important;
}

#printProtocolPage .step-circle,
#printProtocolPreviewClone .step-circle{
  display:none!important;
}

#printProtocolPage h3,
#printProtocolPreviewClone h3{
  display:block!important;
}

@media print{
.step-circle{display:none!important;}

#printProtocolPage h3{display:block!important;}
}

/* ===== step-circle-softer-contrast-final ===== */
/* Jemnější méně kontrastní číselné kroužky pouze na hlavní obrazovce; Tisk/PDF zůstává bez čísel */
body:not(.print-protocol) .step-circle{
  background:#f8fafc!important;
  color:#111827!important;
  -webkit-text-fill-color:#111827!important;
  border:1px solid #cbd5e1!important;
  box-shadow:0 1px 4px rgba(15,23,42,.08)!important;
  font-weight:800!important;
}

#printProtocolPage .step-circle,
#printProtocolPreviewClone .step-circle{
  display:none!important;
}

@media print{
.step-circle{display:none!important;}
}

/* ===== workflow-v11-styles ===== */
.workflow-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;align-items:end}

.workflow-inline-grid{margin:8px 0 12px!important;padding:10px!important;border:1px solid var(--line)!important;border-radius:14px!important;background:rgba(148,163,184,.08)!important;}

.workflow-inline-note{margin:4px 0 6px!important;}

.advanced-subtitle{font-size:13px;font-weight:900;margin:12px 0 4px;color:var(--text);}

.workflow-info{margin-top:10px;padding:9px 11px;border:1px solid var(--line);border-radius:12px;background:rgba(148,163,184,.10)}

.design-linked-inputs{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px;margin:10px 0 12px;}

.design-linked-field{position:relative;}

.design-linked-field input{padding-right:42px!important;}

.design-lock-icon{position:absolute;right:10px;top:50%;transform:translateY(-50%);display:none;align-items:center;justify-content:center;width:24px;height:24px;border-radius:999px;background:#dbeafe;color:#1e3a8a;font-size:14px;font-weight:900;pointer-events:none;border:1px solid #93c5fd;}

.design-linked-field.is-locked .design-lock-icon{display:flex;}

.locked-field,
input.auto-locked{background:#eef2ff!important;color:#1e3a8a!important;border-color:#93c5fd!important;cursor:not-allowed!important;font-weight:800!important}

.print-hidden{visibility:hidden!important;pointer-events:none!important}

.print-visible{visibility:visible!important;pointer-events:auto!important}

.validation-groups{display:grid;gap:8px}

.validation-group{border:1px solid var(--line);border-radius:12px;padding:8px;background:var(--card-soft,#f8fafc)}

.validation-group h4{margin:0 0 5px;font-size:13px}

.validation-group div{font-size:12px;line-height:1.35}

@media(min-width:1050px){
.top-input-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important}

.left-input-column{display:block!important}
}

@media print{
.print-hidden,
.print-visible{visibility:hidden!important}
}

/* GRAFICKÉ ÚPRAVY PŘENESENÉ Z NEJNOVĚJŠÍ VERZE */
.advanced-losses-details summary{display:block!important;padding:0!important;}

.advanced-toggle-btn{
  display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;width:100%!important;box-sizing:border-box!important;
  border:1px solid var(--line)!important;border-radius:14px!important;padding:10px 12px!important;font-size:13px!important;font-weight:800!important;
  background:#dbeafe!important;color:#111827!important;text-align:left!important;min-width:0!important;cursor:pointer!important;
}

.advanced-toggle-btn::before{content:'Pokročilé nastavení systému';}

.advanced-toggle-btn::after{content:'▼';font-size:14px;line-height:1;color:currentColor;opacity:.9;}

.advanced-losses-details[open] .advanced-toggle-btn::after{content:'▲';}

@media print{
.advanced-losses-details summary{display:none!important}
}

input::placeholder,
textarea::placeholder{color:#9ca3af;font-weight:400}

.empty-results-note{font-size:12px;color:var(--muted);padding:8px 10px;border:1px dashed var(--line);border-radius:12px;background:var(--card-soft);margin-top:8px}

.clean-arrow-toggle{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;text-align:left!important;}

.clean-arrow-toggle .toggle-arrow,
.clean-arrow-toggle::after{margin-left:auto!important;}

@media print{
.clean-arrow-toggle{display:none!important;}
}

[data-bottom-print-pdf-btn="1"].print-hidden{visibility:hidden!important;opacity:0!important;pointer-events:none!important;}

.user-value-field{transition:border-color .15s ease, box-shadow .15s ease, background .15s ease;}

.user-value-field:focus{border-color:var(--blue)!important;box-shadow:0 0 0 3px rgba(37,99,235,.14)!important;outline:none!important;}

.workflow-card .workflow-grid select,
.workflow-card .workflow-grid input{min-height:42px;border-radius:12px;}

/* Úprava názvů rozbalovacích sekcí: bez slov Otevřít/Zavřít */
.clean-arrow-toggle .toggle-label{font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}

.clean-arrow-toggle .toggle-arrow{font-size:14px;line-height:1;color:currentColor;opacity:.9;margin-left:auto;}

/* ===== guide-input-cleanup-final ===== */
/* Finální UX průvodce: zvýrazňuje se celý blok,
ne jednotlivé vstupní pole.
   Modrá = aktuální blok,
zelená = hotový blok,
vstupy zůstávají neutrální. */
.guide-field-next,
.guide-field-next:focus,
.guide-field-done,
.guide-field-done:focus{
  animation:none!important;
  background:var(--card)!important;
  border-color:var(--line)!important;
  box-shadow:none!important;
  outline:none!important;
}

.guide-required-label{
  color:var(--muted)!important;
  font-weight:700!important;
}

.guide-card-next{
  border-color:rgba(37,99,235,.95)!important;
  background:linear-gradient(180deg,rgba(37,99,235,.13),rgba(37,99,235,.035))!important;
  box-shadow:0 0 0 2px rgba(37,99,235,.18),0 16px 38px rgba(37,99,235,.16)!important;
}

.guide-card-done{
  border-color:rgba(4,120,87,.55)!important;
  background:linear-gradient(180deg,rgba(4,120,87,.10),rgba(4,120,87,.025))!important;
}

/* ===== poloha-prvni-krok-final ===== */
.location-start-link{
  display:block;
  width:100%;
  box-sizing:border-box;
  margin:0 0 10px 0;
  padding:11px 13px;
  border:1px solid var(--line);
  border-radius:14px;
  background:var(--card-soft,#f8fafc);
  color:#111827;
  font-weight:850;
  text-align:center;
  text-decoration:none;
  cursor:pointer;
  transition:box-shadow .18s ease, transform .12s ease, border-color .18s ease, background .18s ease;
}

.location-start-link:hover{
  border-color:#9ca3af;
  background:#eef2f7;
  box-shadow:0 6px 18px rgba(15,23,42,.10);
}

.location-start-link:active{transform:scale(.99);}

#mapWrap.guide-map-pulse{
  animation:mapGuidePulse 1.6s ease-in-out 2;
}


@keyframes mapGuidePulse{
  0%,100%{box-shadow:0 0 0 0 rgba(37,99,235,0);}
  50%{box-shadow:0 0 0 5px rgba(37,99,235,.24);}
}
@keyframes mapGuidePulseDark{
  0%,100%{box-shadow:0 0 0 0 rgba(96,165,250,0);}
  50%{box-shadow:0 0 0 5px rgba(96,165,250,.28);}
}
@media print{
.location-start-link{display:none!important}
}

/* ===== customer-print-step-modal-styles ===== */
/* Údaje zákazníka jsou nově jen v kroku Tisk/PDF,
ne na hlavní obrazovce. */
.print-customer-step{
  border:1px solid var(--line,#d1d5db);
  border-radius:16px;
  padding:12px;
  margin:0 0 12px;
  background:var(--card-soft,#f8fafc);
}

.print-customer-step h3{
  margin:0 0 8px;
  font-size:18px;
  border-bottom:1px solid var(--line,#d1d5db);
  padding-bottom:6px;
}

.print-customer-toggle{
  display:flex;
  gap:8px;
  align-items:center;
  margin:8px 0 10px;
  font-size:13px;
  font-weight:700;
}

.print-customer-toggle input{
  width:auto!important;
  min-height:auto!important;
  margin:0!important;
}

.print-customer-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px 12px;
}

.print-customer-grid .full-row{grid-column:1 / -1;}

.print-preview-open #printProtocolPreviewClone .protocol-customer-detail.customer-hidden,
body.print-protocol #printProtocolPage .protocol-customer-detail.customer-hidden{
  display:none!important;
}

@media(max-width:700px){
.print-customer-grid{grid-template-columns:1fr;}
}

/* ===== always-visible-print-pdf-button-fix ===== */
/* Zámek rozpracovaného kombinovaného systému */
.system-type-lock-wrap{
  display:block;
  width:100%;
  position:relative;
}

.system-type-lock-wrap select{
  width:100%!important;
  max-width:100%!important;
}

/* Zámek kombinovaného systému je pouze v textu volby v rozbalovacím seznamu,
ne vedle celého pole. */
@media(max-width:700px){
  .system-type-lock-wrap{display:block;width:100%;}
}

/* Tisk/PDF je vždy viditelné a klikatelné,
nezávisle na validaci konfigurátoru. */
[data-bottom-print-pdf-btn="1"]{visibility:visible!important;opacity:1!important;pointer-events:auto!important;}

[data-bottom-print-pdf-btn="1"].print-hidden{visibility:visible!important;opacity:1!important;pointer-events:auto!important;}


/* ===== design-lock-neutral-style ===== */
#dailyWhWrap.locked-field .design-lock-icon,
#fieldManualWrap.locked-field .design-lock-icon,
#inverterDesignWrap.locked-field .design-lock-icon{
  display:inline-block !important;
  margin-left:6px;
}

#dailyWhWrap.unlocked-field .design-lock-icon,
#fieldManualWrap.unlocked-field .design-lock-icon,
#inverterDesignWrap.unlocked-field .design-lock-icon{
  display:none !important;
}

#dailyWhWrap.locked-field,
#fieldManualWrap.locked-field,
#inverterDesignWrap.locked-field,
#dailyWhWrap.unlocked-field,
#fieldManualWrap.unlocked-field,
#inverterDesignWrap.unlocked-field{
  opacity:1 !important;
  border:0 !important;
  padding:0 !important;
  background:transparent !important;
}

#dailyWhWrap.locked-field input,
#fieldManualWrap.locked-field input,
#inverterDesignWrap.locked-field input,
#dailyWhWrap.locked-field select,
#fieldManualWrap.locked-field select,
#inverterDesignWrap.locked-field select{
  cursor:default !important;
}

/* ===== system-voltage-auto-display-style ===== */
.system-voltage-auto-wrap{margin-top:10px;}

#systemVoltageAutoDisplay{font-weight:900;background:#eef2ff!important;color:#1e3a8a!important;border-color:#93c5fd!important;cursor:default!important;}

/* ===== daily-consumption-lock-icon-final-fix ===== */
/* Zámek patří přímo k poli Denní spotřeba; jednotky Wh/kWh zůstávají vždy ovladatelné. */
.daily-consumption-control-row{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) 125px!important;
  gap:8px!important;
  align-items:center!important;
}

.daily-consumption-input-shell{
  position:relative!important;
  min-width:0!important;
}

.daily-consumption-input-shell #dailyEnergyInput{
  width:100%!important;
  padding-right:42px!important;
  margin-top:0!important;
}

#dailyEnergyUnit{
  width:100%!important;
  max-width:none!important;
  margin-top:0!important;
  pointer-events:auto!important;
  cursor:pointer!important;
}

#dailyWhWrap .daily-lock-icon{
  position:absolute!important;
  right:10px!important;
  top:50%!important;
  transform:translateY(-50%)!important;
  margin-left:0!important;
  z-index:4!important;
}

#dailyWhWrap.locked-field #dailyEnergyUnit,
#dailyWhWrap.is-locked #dailyEnergyUnit{
  pointer-events:auto!important;
  cursor:pointer!important;
  opacity:1!important;
}

#dailyWhWrap.locked-field #dailyEnergyInput,
#dailyWhWrap.is-locked #dailyEnergyInput{
  cursor:default!important;
}

@media(max-width:700px){
.daily-consumption-control-row{grid-template-columns:minmax(0,1fr) 112px!important;gap:7px!important;}
}

/* ===== final-inline-lock-icons-system-daily ===== */
/* Finální umístění ikon zámku přímo uvnitř polí: Denní spotřeba,
Výkon FV pole a Kombinovaný systém. */
.design-lock-field,
.system-type-lock-wrap,
.daily-consumption-input-shell,
.design-linked-field{
  position:relative!important;
}

.design-linked-field > input,
.design-lock-field > select,
.system-type-lock-wrap > select{
  padding-right:42px!important;
}

.daily-consumption-input-shell #dailyEnergyInput{
  padding-right:42px!important;
}

.design-linked-field > .design-lock-icon,
.daily-consumption-input-shell > .design-lock-icon,
.system-type-lock-wrap > .design-lock-icon{
  position:absolute!important;
  right:10px!important;
  top:50%!important;
  transform:translateY(-50%)!important;
  display:none;
  align-items:center!important;
  justify-content:center!important;
  width:24px!important;
  height:24px!important;
  border-radius:999px!important;
  margin:0!important;
  z-index:5!important;
  pointer-events:none!important;
}

.design-linked-field.locked-field > .design-lock-icon,
.design-linked-field.is-locked > .design-lock-icon,
.daily-consumption-input-shell .design-lock-icon[style*="inline"],
#systemTypeWrap.system-type-locked > .system-type-lock-icon{
  display:flex!important;
}

#dailyWhWrap.locked-field .daily-consumption-input-shell > .daily-lock-icon,
#dailyWhWrap.is-locked .daily-consumption-input-shell > .daily-lock-icon{
  display:flex!important;
}

#systemTypeWrap #systemType{
  width:100%!important;
}

#systemTypeWrap.system-type-locked #systemType{
  padding-right:42px!important;
}

@media(max-width:700px){
.design-linked-field > input,
.design-lock-field > select,
.system-type-lock-wrap > select,
.daily-consumption-input-shell #dailyEnergyInput{padding-right:40px!important;}
}

/* ===== unified-right-lock-icons-final-authoritative ===== */
/* Autoritativní sjednocení ikon: vzorem je Denní spotřeba. Ikona je vždy uvnitř vlastního pole vpravo,
ne v textu selectu ani mimo wrapper. */
.daily-consumption-input-shell,
.lock-input-shell,
.system-type-lock-wrap{
  position:relative!important;
  width:100%!important;
}

.daily-consumption-input-shell > input,
.lock-input-shell > input,
.system-type-lock-wrap > select{
  width:100%!important;
  padding-right:70px!important;
  box-sizing:border-box!important;
}

.daily-consumption-input-shell > .design-lock-icon,
.lock-input-shell > .design-lock-icon,
.system-type-lock-wrap > .design-lock-icon{
  position:absolute!important;
  right:34px!important;
  top:50%!important;
  transform:translateY(-50%)!important;
  width:24px!important;
  height:24px!important;
  min-width:24px!important;
  min-height:24px!important;
  max-width:24px!important;
  max-height:24px!important;
  display:none!important;
  align-items:center!important;
  justify-content:center!important;
  margin:0!important;
  padding:0!important;
  border-radius:999px!important;
  background:#dbeafe!important;
  color:#1e3a8a!important;
  border:1px solid #93c5fd!important;
  box-shadow:none!important;
  font-size:14px!important;
  line-height:1!important;
  font-weight:900!important;
  z-index:6!important;
  pointer-events:none!important;
}

#dailyWhWrap.locked-field .daily-consumption-input-shell > .daily-lock-icon,
#dailyWhWrap.is-locked .daily-consumption-input-shell > .daily-lock-icon,
#fieldManualWrap.locked-field .field-manual-input-shell > .field-manual-lock-icon,
#fieldManualWrap.is-locked .field-manual-input-shell > .field-manual-lock-icon,
#systemTypeWrap.system-type-locked > .system-type-lock-icon{
  display:flex!important;
}

/* Starší pravidla nesmí udělat z ikon inline prvek vedle pole. */
#dailyWhWrap.locked-field > .design-lock-icon,
#fieldManualWrap.locked-field > .design-lock-icon,
#inverterDesignWrap.locked-field > .design-lock-icon{
  display:none!important;
}

#dailyWhWrap.locked-field,
#fieldManualWrap.locked-field,
#dailyWhWrap.unlocked-field,
#fieldManualWrap.unlocked-field{
  background:transparent!important;
  border:0!important;
  padding:0!important;
}

#dailyEnergyUnit{
  padding-right:32px!important;
}

@media(max-width:700px){
.daily-consumption-input-shell > input,
.lock-input-shell > input,
.system-type-lock-wrap > select{padding-right:44px!important;}
}

/* ===== field-manual-locked-font-unification-final ===== */
/* Finální oprava: Výkon FV pole má stejné písmo při zamčeném i odemčeném stavu.
   Zamčení ponechává pouze logiku readonly + ikonu zámku,
nepřebarvuje typografii hodnoty. */
#fieldManual,
#fieldManual.auto-locked,
#fieldManual[readonly],
#fieldManualWrap.locked-field #fieldManual,
#fieldManualWrap.is-locked #fieldManual,
#fieldManualWrap.unlocked-field #fieldManual{
  font-family:Arial,sans-serif!important;
  font-size:16px!important;
  font-weight:400!important;
  font-style:normal!important;
  line-height:1.25!important;
  letter-spacing:normal!important;
  text-transform:none!important;
  opacity:1!important;
  -webkit-text-fill-color:currentColor!important;
}

#fieldManual.auto-locked,
#fieldManual[readonly],
#fieldManualWrap.locked-field #fieldManual,
#fieldManualWrap.is-locked #fieldManual{
  cursor:default!important;
}

@media print{
#fieldManual,
#fieldManual.auto-locked,
#fieldManual[readonly]{
    font-size:10px!important;
    font-weight:400!important;
    line-height:1.2!important;
    letter-spacing:normal!important;
  }
}

/* ===== authoritative-fieldmanual-dailyenergy-unified-style ===== */

#dailyEnergyInput,
#fieldManual,
#dailyEnergyInput:read-only,
#fieldManual:read-only,
#dailyEnergyInput.auto-locked,
#fieldManual.auto-locked,
#dailyWhWrap.locked-field #dailyEnergyInput,
#fieldManualWrap.locked-field #fieldManual{
  appearance:none !important;
  -webkit-appearance:none !important;
  width:100% !important;
  box-sizing:border-box !important;
  min-height:42px !important;
  margin-top:4px !important;
  padding:8px 46px 8px 8px !important;
  border:1px solid #d1d5db !important;
  border-radius:12px !important;
  background:#ffffff !important;
  background-color:#ffffff !important;
  color:#000000 !important;
  -webkit-text-fill-color:#000000 !important;
  caret-color:#000000 !important;
  opacity:1 !important;
  filter:none !important;
  text-shadow:none !important;
  box-shadow:none !important;
  font-family:Arial,sans-serif !important;
  font-size:14px !important;
  font-weight:400 !important;
  line-height:1.25 !important;
  letter-spacing:0 !important;
}

/* Jednotka u Denní spotřeby zůstává ovladatelná,
ale barevně je sjednocená. */
#dailyEnergyUnit{
  appearance:none !important;
  -webkit-appearance:none !important;
  min-height:42px !important;
  border:1px solid #d1d5db !important;
  border-radius:12px !important;
  background:#ffffff !important;
  background-color:#ffffff !important;
  color:#000000 !important;
  -webkit-text-fill-color:#000000 !important;
  opacity:1 !important;
  filter:none !important;
  text-shadow:none !important;
  font-family:Arial,sans-serif !important;
  font-size:14px !important;
  font-weight:400 !important;
}

/* Wrapper nesmí dávat modré pozadí ani modrou barvu zamčenému stavu. */
#dailyWhWrap.locked-field,
#fieldManualWrap.locked-field,
#dailyWhWrap.is-locked,
#fieldManualWrap.is-locked{
  background:transparent !important;
  background-color:transparent !important;
  color:#000000 !important;
  opacity:1 !important;
  border:0 !important;
}

/* ===== runtime-modes-like-advanced-settings-style ===== */
/* SJEDNOCENÍ ROZBALOVACÍHO POLE:
   „Výdrž baterie v různých režimech provozu [h]“
   má stejný vzhled otevřeno/zavřeno jako „Pokročilé nastavení systému“. */

.runtime-modes-box{
  border:1px solid var(--line) !important;
  border-radius:16px !important;
  padding:10px 12px !important;
  margin-top:10px !important;
  background:var(--card-soft,#f8fafc) !important;
  box-shadow:none !important;
}

.runtime-modes-box summary{
  display:block !important;
  padding:0 !important;
  margin:0 !important;
  cursor:pointer !important;
  list-style:none !important;
  color:inherit !important;
  font-size:inherit !important;
  font-weight:inherit !important;
}

.runtime-modes-box summary::-webkit-details-marker{
  display:none !important;
}

.runtime-modes-box summary::before,
.runtime-modes-box summary::after{
  content:none !important;
  display:none !important;
}

.runtime-toggle-btn{
  display:flex !important;
  align-items:center !important;
  justify-content:space-between !important;
  gap:12px !important;
  width:100% !important;
  box-sizing:border-box !important;
  border:1px solid var(--line) !important;
  border-radius:14px !important;
  padding:10px 12px !important;
  font-size:13px !important;
  line-height:1.2 !important;
  font-weight:800 !important;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif !important;
  background:#dbeafe !important;
  color:#111827 !important;
  text-align:left !important;
  min-width:0 !important;
  cursor:pointer !important;
  -webkit-font-smoothing:antialiased !important;
  text-rendering:optimizeLegibility !important;
}

.runtime-toggle-btn::before{
  content:'Výdrž baterie v různých režimech provozu [h]' !important;
  overflow:hidden !important;
  text-overflow:ellipsis !important;
  white-space:nowrap !important;
}

.runtime-toggle-btn::after{
  content:'▼' !important;
  font-size:14px !important;
  line-height:1 !important;
  color:currentColor !important;
  opacity:.9 !important;
  margin-left:auto !important;
  flex:0 0 auto !important;
}

.runtime-modes-box[open] .runtime-toggle-btn::after{
  content:'▲' !important;
}

/* Obsah výdrže zůstává čitelný,
ale bez odlišného modrého „jiného pole“. */
.runtime-modes-grid{
  display:grid !important;
  gap:6px !important;
  margin-top:10px !important;
}

.runtime-mode-row{
  display:grid !important;
  grid-template-columns:minmax(0,1fr) auto !important;
  gap:10px !important;
  align-items:center !important;
  padding:8px 0 !important;
  border-top:1px solid rgba(148,163,184,.28) !important;
}

.runtime-mode-row span{
  color:var(--muted) !important;
  font-weight:500 !important;
}

.runtime-mode-row b{
  font-size:18px !important;
  color:var(--blue) !important;
  white-space:nowrap !important;
  font-weight:700 !important;
}

@media(max-width:700px){
.runtime-toggle-btn{
    font-size:13px !important;
    padding:10px 12px !important;
  }

.runtime-toggle-btn::before{
    white-space:normal !important;
  }
}

@media print{
.runtime-modes-box{
    border:1px solid #ccc !important;
    background:#fff !important;
    padding:5px !important;
    margin-top:4px !important;
  }

.runtime-modes-box summary{
    display:none !important;
  }

.runtime-mode-row{
    padding:2px 0 !important;
  }

.runtime-mode-row span,
.runtime-mode-row b{
    font-size:8px !important;
    color:#000 !important;
  }
}

/* ===== global-unified-font-like-advanced-settings ===== */
/* GLOBÁLNÍ SJEDNOCENÍ PÍSMA PODLE:
   „Pokročilé nastavení systému“ */

html,
body,
input,
select,
textarea,
button,
label,
.small,
.card,
table,
td,
th,
div,
span,
summary,
details,
.calc-label,
.calc-value,
.metric,
.cable-value,
.month-value,
.month-label,
.runtime-mode-row,
.runtime-mode-row span,
.runtime-mode-row b,
.protocol-table,
.protocol-box,
.workflow-grid,
.workflow-inline-grid,
.advanced-losses-details,
.advanced-toggle-btn,
.runtime-toggle-btn{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif !important;
  -webkit-font-smoothing:antialiased !important;
  -moz-osx-font-smoothing:grayscale !important;
  text-rendering:optimizeLegibility !important;
  letter-spacing:0 !important;
}

/* Stejná tloušťka jako „Pokročilé nastavení systému“ */
body,
input,
select,
textarea,
button,
label,
.small,
.card,
table,
td,
th,
div,
span{
  font-weight:500 !important;
}

/* Nadpisy a hlavní prvky */
h1,
h2,
h3,
summary,
.advanced-toggle-btn,
.runtime-toggle-btn,
.calc-value,
.metric{
  font-weight:700 !important;
}

/* Inputy a selecty stejně čitelné */
input,
select,
textarea{
  font-size:16px !important;
  line-height:1.25 !important;
}

/* ===== runtime-exact-font-like-advanced-final ===== */
/* PŘESNÉ SJEDNOCENÍ PÍSMA:
   Výdrž baterie = Pokročilé nastavení systému
   hlavní řádek i vnitřní obsah */

#batteryRuntimeModes,
#batteryRuntimeModes *,
#batteryRuntimeModes summary,
#batteryRuntimeModes .runtime-toggle-btn,
#batteryRuntimeModes .runtime-modes-grid,
#batteryRuntimeModes .runtime-mode-row,
#batteryRuntimeModes .runtime-mode-row span,
#batteryRuntimeModes .runtime-mode-row b,
#batteryRuntimeModes .small{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif !important;
  -webkit-font-smoothing:antialiased !important;
  -moz-osx-font-smoothing:grayscale !important;
  text-rendering:optimizeLegibility !important;
  letter-spacing:0 !important;
}

/* hlavní zavřené/otevřené pole přesně jako Pokročilé nastavení systému */
#batteryRuntimeModes summary{
  display:block !important;
  padding:0 !important;
  margin:0 !important;
  cursor:pointer !important;
  list-style:none !important;
  font-size:13px !important;
  font-weight:800 !important;
  line-height:1.2 !important;
}

#batteryRuntimeModes summary::-webkit-details-marker{
  display:none !important;
}

#batteryRuntimeModes summary::before,
#batteryRuntimeModes summary::after{
  content:none !important;
  display:none !important;
}

#batteryRuntimeModes .runtime-toggle-btn{
  display:flex !important;
  align-items:center !important;
  justify-content:space-between !important;
  gap:12px !important;
  width:100% !important;
  box-sizing:border-box !important;
  border:1px solid var(--line) !important;
  border-radius:14px !important;
  padding:10px 12px !important;
  font-size:13px !important;
  font-weight:800 !important;
  line-height:1.2 !important;
  background:#dbeafe !important;
  color:#111827 !important;
  text-align:left !important;
  min-width:0 !important;
  cursor:pointer !important;
}

#batteryRuntimeModes .runtime-toggle-btn::before{
  content:'Výdrž baterie v různých režimech provozu [h]' !important;
  font-size:13px !important;
  font-weight:800 !important;
  line-height:1.2 !important;
  overflow:hidden !important;
  text-overflow:ellipsis !important;
  white-space:nowrap !important;
}

#batteryRuntimeModes .runtime-toggle-btn::after{
  content:'▼' !important;
  font-size:14px !important;
  font-weight:800 !important;
  line-height:1 !important;
  color:currentColor !important;
  opacity:.9 !important;
  margin-left:auto !important;
  flex:0 0 auto !important;
}

#batteryRuntimeModes[open] .runtime-toggle-btn::after{
  content:'▲' !important;
}

/* vnitřní stránka / obsah po otevření:
   stejné písmo,
stejná velikost a stejná tloušťka jako pokročilé nastavení */
#batteryRuntimeModes .runtime-modes-grid{
  margin-top:10px !important;
  gap:6px !important;
}

#batteryRuntimeModes .runtime-mode-row{
  font-size:13px !important;
  font-weight:500 !important;
  line-height:1.35 !important;
}

#batteryRuntimeModes .runtime-mode-row span{
  font-size:13px !important;
  font-weight:500 !important;
  line-height:1.35 !important;
  color:var(--muted) !important;
}

#batteryRuntimeModes .runtime-mode-row b{
  font-size:13px !important;
  font-weight:500 !important;
  line-height:1.35 !important;
  color:var(--text) !important;
  white-space:nowrap !important;
}

#batteryRuntimeModes .small{
  font-size:13px !important;
  font-weight:500 !important;
  line-height:1.35 !important;
  color:var(--muted) !important;
}

@media(max-width:700px){
#batteryRuntimeModes .runtime-toggle-btn,
#batteryRuntimeModes .runtime-toggle-btn::before{
    font-size:13px !important;
    font-weight:800 !important;
    line-height:1.2 !important;
  }

#batteryRuntimeModes .runtime-toggle-btn::before{
    white-space:normal !important;
  }
}

/* ===== runtime-toggle-fontweight-fix ===== */
/* OPRAVA: tloušťka hlavního textu musí být stejná jako Pokročilé nastavení systému */
#batteryRuntimeModes summary,
#batteryRuntimeModes .runtime-toggle-btn,
#batteryRuntimeModes .runtime-toggle-btn::before{
  font-weight:700 !important;
}

/* ===== pwm-allowed-system-voltage-style ===== */
/* PWM: zakázaná systémová napětí jsou vizuálně neaktivní */
#voltageMode option:disabled{
  color:#9ca3af !important;
}

#pwmVoltageLockNote{
  margin-top:6px;
  padding:7px 9px;
  border:1px solid rgba(180,83,9,.35);
  border-radius:10px;
  background:rgba(251,191,36,.12);
  color:var(--warn);
  font-size:12px;
  font-weight:700;
}

/* ===== regulator-card-pwm-field-audit-style ===== */
/* PWM: MPPT pracovní okno se u PWM nepoužívá,
proto ho při PWM schováme. */
.pwm-hidden-field{
  display:none !important;
}

#pwmFieldAuditNote{
  margin-top:8px;
  padding:8px 10px;
  border:1px solid rgba(37,99,235,.24);
  border-radius:12px;
  background:rgba(37,99,235,.08);
  color:var(--text);
  font-size:12px;
  font-weight:600;
  line-height:1.35;
}

/* ===== pv-power-empty-state-final ===== */
/* KROK 2W: Zadaný výkon FV pole má při prázdném konfigurátoru stejný čekací stav jako ostatní automatické hodnoty. */
#pvTotalField{
  font-weight:700 !important;
}

#enteredPvPower,
input#enteredPvPower{
  opacity:1 !important;
  text-shadow:none !important;
  filter:none !important;
  mix-blend-mode:normal !important;
  -webkit-appearance:none !important;
  appearance:none !important;
}

html #enteredPvPower,
html input#enteredPvPower{
  background:#ffffff !important;
  background-color:#ffffff !important;
  color:#111827 !important;
  -webkit-text-fill-color:#111827 !important;
  caret-color:#111827 !important;
  border:1px solid #d1d5db !important;
}

#enteredPvPower::placeholder,
input#enteredPvPower::placeholder{
  color:#64748b !important;
  -webkit-text-fill-color:#64748b !important;
  opacity:1 !important;
}

html #pvTotalField,
html input#pvTotalField{
  background:#ffffff !important;
  background-color:#ffffff !important;
  color:#111827 !important;
  -webkit-text-fill-color:#111827 !important;
}

/* ===== pv-total-empty-filled-color-final ===== */

html #pvTotalField.pv-empty-auto,
html input#pvTotalField.pv-empty-auto{
  background:#ffffff !important;
  background-color:#ffffff !important;
  color:#6b7280 !important;
  -webkit-text-fill-color:#6b7280 !important;
}

html #pvTotalField.pv-filled-auto,
html input#pvTotalField.pv-filled-auto{
  background:#ffffff !important;
  background-color:#ffffff !important;
  color:#000000 !important;
  -webkit-text-fill-color:#000000 !important;
}

html #dodDisplay,
html input#dodDisplay{
  background:#f8fafc !important;
  background-color:#f8fafc !important;
  color:#000000 !important;
  -webkit-text-fill-color:#000000 !important;
  opacity:1 !important;
}

/* ===== version-4-final-stability-marker ===== */
/* FVE konfigurátor verze 4 – finální stabilizační značka.
   Výpočtová logika,
feed{
  background:#ffffff !important;
  color:#000000 !important;
  border-color:#cbd5e1 !important;
}

/* ===== profi-engine-full-css ===== */
.profi-main-evaluation{margin-top:12px;padding-top:12px;border-top:1px solid var(--line)}

.profi-detail-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px;margin-top:10px}

.profi-detail-card{border:1px solid var(--line);border-radius:14px;padding:10px;background:var(--card-soft,#f8fafc)}

.profi-detail-card h4{margin:0 0 8px;font-size:14px}

.profi-detail-card table{font-size:12px}

.profi-detail-card td{padding:4px 2px}

.profi-pill{display:inline-block;border-radius:999px;padding:3px 8px;border:1px solid currentColor;font-weight:800;font-size:11px}

.profi-recommendations{margin-top:10px;padding:10px;border-radius:14px;border:1px solid var(--line);background:var(--card-soft,#f8fafc)}

.profi-recommendations ul{margin:6px 0 0 18px;padding:0}

.profi-recommendations li{margin:3px 0}

@media print{
.profi-detail-grid{grid-template-columns:1fr 1fr!important;gap:5px!important}

.profi-detail-card,
.profi-recommendations{padding:5px!important;border-radius:6px!important}

.profi-detail-card h4{font-size:9px!important}

.profi-detail-card table{font-size:8px!important}

.profi-pill{font-size:8px!important;padding:1px 4px!important}
}

/* ===== deduplicated-details-style ===== */
/* ===== component-feed-pickers-final ===== */
/* Výběr komponent z XML katalogu – stejný princip jako regulátor:
   bílá plocha,
barvou pracuje hlavně rámeček/stav. */
.component-feed-picker{
  margin-top:12px;
  padding:10px;
  border:1px solid var(--line,#d1d5db);
  border-radius:14px;
  background:#ffffff!important;
  color:#000000!important;
  box-shadow:none!important;
}

.component-feed-picker label{font-weight:700;color:#111827!important;}

.component-feed-picker select{
  background:#ffffff!important;
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
  border:1px solid #9ca3af!important;
  border-radius:14px!important;
  min-height:46px!important;
  font-weight:700!important;
  text-align:center!important;
  text-align-last:center!important;
  box-shadow:none!important;
  opacity:1!important;
}

.component-feed-picker select:focus{
  outline:none!important;
  border-color:var(--blue,#2563eb)!important;
  box-shadow:0 0 0 3px rgba(37,99,235,.16)!important;
}

.component-feed-picker select.component-feed-loaded{border-color:#cbd5e1!important;}

.component-feed-picker select.component-feed-empty{border-color:#9ca3af!important;}

.component-feed-picker select.component-feed-warn{border-color:var(--warn,#b45309)!important;}

.component-feed-card{
  display:grid;
  grid-template-columns:86px minmax(0,1fr);
  gap:10px;
  margin-top:10px;
  padding:10px;
  border:1px solid var(--ok,#047857);
  border-radius:14px;
  background:#ffffff!important;
  color:#000000!important;
  box-shadow:none!important;
}

.component-feed-img{
  width:86px;height:86px;
  border:1px solid #e5e7eb;
  border-radius:12px;
  display:flex;align-items:center;justify-content:center;
  background:#ffffff!important;
  overflow:hidden;
}

.component-feed-img img{max-width:100%;max-height:100%;object-fit:contain;}

.component-feed-title{font-weight:800;line-height:1.2;margin-bottom:4px;color:#000000!important;}

.component-feed-meta{font-size:12px;color:#4b5563!important;line-height:1.25;margin-bottom:6px;}

.component-feed-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:6px;}

.component-feed-param{border:1px solid #e5e7eb;border-radius:10px;padding:6px;background:#ffffff!important;}

.component-feed-param span{display:block;font-size:11px;color:#64748b!important;}

.component-feed-param b{display:block;font-size:13px;color:#000000!important;}

.component-feed-picker .small{color:#4b5563!important;}

@media(max-width:700px){
.component-feed-card{grid-template-columns:1fr}

.component-feed-img{width:100%;height:120px}
}

/* ===== delayed-warning-colors-final ===== */
/* Finální pravidlo:
   Modré/zelené zvýraznění průvodce zůstává.
   Červené/žluté varovné zbarvení vstupních polí/karet nad vyhodnocením systému
   se zobrazí až po vyplnění všech viditelných vstupních hodnot. */
body:not(.print-protocol):not(.all-inputs-complete) input.warn,
body:not(.print-protocol):not(.all-inputs-complete) input.warning,
body:not(.print-protocol):not(.all-inputs-complete) input.bad,
body:not(.print-protocol):not(.all-inputs-complete) input.error,
body:not(.print-protocol):not(.all-inputs-complete) input.invalid,
body:not(.print-protocol):not(.all-inputs-complete) input.calc-error-field,
body:not(.print-protocol):not(.all-inputs-complete) select.warn,
body:not(.print-protocol):not(.all-inputs-complete) select.warning,
body:not(.print-protocol):not(.all-inputs-complete) select.bad,
body:not(.print-protocol):not(.all-inputs-complete) select.error,
body:not(.print-protocol):not(.all-inputs-complete) select.invalid,
body:not(.print-protocol):not(.all-inputs-complete) select.calc-error-field,
body:not(.print-protocol):not(.all-inputs-complete) textarea.warn,
body:not(.print-protocol):not(.all-inputs-complete) textarea.warning,
body:not(.print-protocol):not(.all-inputs-complete) textarea.bad,
body:not(.print-protocol):not(.all-inputs-complete) textarea.error,
body:not(.print-protocol):not(.all-inputs-complete) textarea.invalid,
body:not(.print-protocol):not(.all-inputs-complete) textarea.calc-error-field{
  background:inherit!important;
  border-color:var(--line)!important;
  box-shadow:none!important;
  outline:none!important;
}

/* Po kompletním vyplnění: neplatná pole červeně včetně pozadí. */
body:not(.print-protocol).all-inputs-complete input.calc-error-field,
body:not(.print-protocol).all-inputs-complete select.calc-error-field,
body:not(.print-protocol).all-inputs-complete textarea.calc-error-field,
body:not(.print-protocol).all-inputs-complete input.invalid,
body:not(.print-protocol).all-inputs-complete select.invalid,
body:not(.print-protocol).all-inputs-complete textarea.invalid,
body:not(.print-protocol).all-inputs-complete input.error,
body:not(.print-protocol).all-inputs-complete select.error,
body:not(.print-protocol).all-inputs-complete textarea.error,
body:not(.print-protocol).all-inputs-complete input.bad,
body:not(.print-protocol).all-inputs-complete select.bad,
body:not(.print-protocol).all-inputs-complete textarea.bad{
  background:rgba(220,38,38,.12)!important;
  border-color:var(--bad)!important;
  box-shadow:0 0 0 2px rgba(220,38,38,.18)!important;
}

/* Po kompletním vyplnění: varovná pole žlutě,
pokud je používá výpočet. */
body:not(.print-protocol).all-inputs-complete input.warn,
body:not(.print-protocol).all-inputs-complete input.warning,
body:not(.print-protocol).all-inputs-complete select.warn,
body:not(.print-protocol).all-inputs-complete select.warning,
body:not(.print-protocol).all-inputs-complete textarea.warn,
body:not(.print-protocol).all-inputs-complete textarea.warning{
  background:rgba(245,158,11,.13)!important;
  border-color:var(--warn)!important;
  box-shadow:0 0 0 2px rgba(245,158,11,.18)!important;
}

/* Bezpečná oprava: hodnoty výdrže baterie jako běžné input písmo */
#batteryRuntime .metric,
#batteryRuntime .calc-value,
.battery-runtime-card .metric,
.battery-runtime-card .calc-value,
[class*="runtime"] .metric,
[class*="runtime"] .calc-value,
[class*="vydrz"] .metric,
[class*="vydrz"] .calc-value{
  font-size:16px !important;
  font-weight:400 !important;
  font-family:Arial, sans-serif !important;
  line-height:1.25 !important;
  letter-spacing:0 !important;
  color:#000000 !important;
  -webkit-text-fill-color:#000000 !important;
}

/* FINÁLNÍ OPRAVA: hodnoty výdrže baterie stejně jako input 200 */
details:has(summary),
details:has(summary) *{
  box-sizing:border-box;
}

details:has(summary) summary{
  font-weight:700!important;
}

/* Sekce podle textu výdrže baterie – hodnoty vpravo */
details:has(summary) table td,
details:has(summary) table th,
details:has(summary) .metric,
details:has(summary) .value,
details:has(summary) b,
details:has(summary) strong{
  font-size:16px!important;
  font-weight:400!important;
  font-family:Arial,sans-serif!important;
  line-height:1.2!important;
  letter-spacing:0!important;
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
}

/* Pokud jsou výsledky vykreslené jako pravý sloupec řádků */
details:has(summary) div,
details:has(summary) span{
  font-size:16px!important;
}

/* Konkrétní textové hodnoty výdrže – cílení na ID,
pokud existují */
#runtimeFull,
#runtimeNormal,
#runtimeNight,
#runtimeEmergency,
#batteryRuntimeFull,
#batteryRuntimeNormal,
#batteryRuntimeNight,
#batteryRuntimeEmergency,
[id*="runtime" i],
[id*="vydrz" i],
[id*="výdrž" i],
[class*="runtime" i],
[class*="vydrz" i],
[class*="výdrž" i]{
  font-size:16px!important;
  font-weight:400!important;
  font-family:Arial,sans-serif!important;
  line-height:1.2!important;
  letter-spacing:0!important;
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
}

/* Hodnoty v pravém sloupci nesmí být tučné */
[id*="runtime" i] *,
[id*="vydrz" i] *,
[id*="výdrž" i] *,
[class*="runtime" i] *,
[class*="vydrz" i] *,
[class*="výdrž" i] *{
  font-size:16px!important;
  font-weight:400!important;
  font-family:Arial,sans-serif!important;
  line-height:1.2!important;
  letter-spacing:0!important;
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
}

/* ===== fix-small-text-same-as-label ===== */
/* Oprava: spodní informační text má stejnou barvu a tloušťku jako horní popisky polí. */
.small{
  font-size:13px!important;
  color:var(--muted)!important;
  font-weight:500!important;
  line-height:1.35!important;
}

/* Verze 4: bílé pozadí rozkliknuté tabulky zboží */
#selectedRegulatorCard,
#selectedRegulatorCard .card,
.feed-product-card,
.regulator-product-card{
  background:#ffffff !important;
  background-color:#ffffff !important;
}

/* Typ systému – hlavní pole i rozbalovací položky: bílé pozadí,
černý text */
#systemType,
#systemMode,
#systemVoltage,
#dcVoltage,
#batteryVoltage,
select[name="systemType"],
select[name="systemMode"],
select[id*="system" i],
select[name*="system" i],
select[id*="voltage" i],
select[name*="voltage" i],
select[id*="napeti" i],
select[name*="napeti" i],
select[id*="napětí" i],
select[name*="napětí" i]{
  background:#ffffff !important;
  background-color:#ffffff !important;
  color:#000000 !important;
  -webkit-text-fill-color:#000000 !important;
  border:2px solid #9ca3af !important;
  text-align:left !important;
  text-align-last:left !important;
  opacity:1 !important;
  appearance:auto !important;
  -webkit-appearance:menulist !important;
}

#systemType option,
#systemMode option,
#systemVoltage option,
#dcVoltage option,
#batteryVoltage option,
select[name="systemType"] option,
select[name="systemMode"] option,
select[id*="system" i] option,
select[name*="system" i] option,
select[id*="voltage" i] option,
select[name*="voltage" i] option,
select[id*="napeti" i] option,
select[name*="napeti" i] option,
select[id*="napětí" i] option,
select[name*="napětí" i] option{
  background:#ffffff !important;
  background-color:#ffffff !important;
  color:#000000 !important;
  -webkit-text-fill-color:#000000 !important;
}

/* Dvě hlavní pole – nikdy bílé písmo */
#fvPower,
#dailyConsumption,
#invPower,
input[name="fvPower"],
input[name="dailyConsumption"],
input[name="invPower"],
input[placeholder="Zadejte výkon měniče"],
input[value="Zadejte výkon měniče"]{
  background:#ffffff !important;
  background-color:#ffffff !important;
  color:#000000 !important;
  -webkit-text-fill-color:#000000 !important;
  caret-color:#000000 !important;
  border:2px solid #9ca3af !important;
  opacity:1 !important;
  text-shadow:none !important;
  filter:none !important;
}

#fvPower::placeholder,
#dailyConsumption::placeholder,
#invPower::placeholder,
input[placeholder="Zadejte výkon měniče"]::placeholder{
  color:#374151 !important;
  -webkit-text-fill-color:#374151 !important;
  opacity:1 !important;
}


html input,
html select,
html textarea{
  color:#111827 !important;
  -webkit-text-fill-color:#111827 !important;
  opacity:1 !important;
}

html input::placeholder,
html textarea::placeholder{
  color:#6b7280 !important;
  -webkit-text-fill-color:#6b7280 !important;
  opacity:1 !important;
}

/* ==========================================================
   FIX 7 – tvrdá oprava nečitelných polí bez závislosti na tématu
   Důvod: některé starší přepisy / inline styly přebíjely tematicka pravidla.
   Cíleně nastavujeme konkrétní problémové prvky podle ID.
   ========================================================== */

/* Automaticky zvolené systémové napětí podle výkonu měniče:
   vždy bílé pole a černé písmo,
aby hodnota 12/24/48 V byla čitelná. */
#systemVoltageAutoDisplay,
input#systemVoltageAutoDisplay,
input#systemVoltageAutoDisplay.auto-calculated,
#systemVoltageAutoDisplayWrap input#systemVoltageAutoDisplay,
.system-voltage-card #systemVoltageAutoDisplayWrap input#systemVoltageAutoDisplay{
  background:#ffffff !important;
  background-color:#ffffff !important;
  color:#000000 !important;
  -webkit-text-fill-color:#000000 !important;
  caret-color:#000000 !important;
  border:1px solid #94a3b8 !important;
  opacity:1 !important;
  text-shadow:none !important;
  filter:none !important;
  mix-blend-mode:normal !important;
  box-shadow:none !important;
  -webkit-appearance:none !important;
  appearance:none !important;
}

#systemVoltageAutoDisplay::placeholder,
input#systemVoltageAutoDisplay::placeholder{
  color:#374151 !important;
  -webkit-text-fill-color:#374151 !important;
  opacity:1 !important;
}

html input#dodDisplay,
html #dodDisplay{
    background:#f8fafc !important;
    background-color:#f8fafc !important;
    color:#000000 !important;
    -webkit-text-fill-color:#000000 !important;
    opacity:1 !important;
}

/* ===== dod-border-match-battery-type-final ===== */
/* DoD pole – stejné jemné ohraničení jako horní select Typ baterie */
#dodDisplay{
  border:1px solid #cbd5e1 !important;
  border-radius:18px !important;
  box-shadow:none !important;
}

/* ===== restore-design-linked-fields-vertical-final ===== */
/* Vrácení původního rozložení: Denní spotřeba a Výkon FV pole jsou pod sebou */
.design-linked-inputs{
  display:grid !important;
  grid-template-columns:1fr !important;
  gap:10px !important;
  margin:10px 0 12px !important;
}

#dailyWhWrap,
#fieldManualWrap{
  width:100% !important;
  max-width:100% !important;
}

/* Uvnitř Denní spotřeby zůstane vstup + jednotka ve stabilní řádce */
#dailyWhWrap .daily-consumption-control-row{
  display:grid !important;
  grid-template-columns:minmax(0,1fr) 125px !important;
  gap:8px !important;
  align-items:center !important;
}

@media(max-width:700px){
#dailyWhWrap .daily-consumption-control-row{
    grid-template-columns:minmax(0,1fr) 112px !important;
    gap:7px !important;
  }
}

/* ===== final-regulator-category-browser-style ===== */
#regulatorTypeBrowser{margin-top:10px;border:1px solid var(--line);border-radius:16px;background:var(--card-soft,#f8fafc);padding:10px}

.reg-browser-head{display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between;margin-bottom:8px}

.reg-browser-tabs{display:flex;gap:8px;flex-wrap:wrap}

.reg-browser-tab{width:auto!important;margin:0!important;padding:8px 12px!important;min-height:34px!important;border-radius:999px!important;font-size:13px!important;background:#e5e7eb!important;color:#111827!important;border:1px solid #cbd5e1!important;box-shadow:none!important}

.reg-browser-tab.active{background:#ecfdf5!important;color:#047857!important;border-color:#059669!important}

.reg-browser-list{display:grid;grid-template-columns:1fr;gap:6px;max-height:280px;overflow:auto;padding-right:2px}

.reg-browser-item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;border:1px solid rgba(148,163,184,.35);border-radius:12px;background:rgba(255,255,255,.6);padding:8px 10px;cursor:pointer}

.reg-browser-item:hover{border-color:#2563eb;background:rgba(37,99,235,.07)}

.reg-browser-title{font-weight:800;font-size:13px;line-height:1.25;overflow-wrap:anywhere}

.reg-browser-meta{font-size:11px;color:var(--muted);margin-top:2px}

.reg-browser-pill{font-size:11px;font-weight:900;border-radius:999px;padding:4px 7px;border:1px solid currentColor;white-space:nowrap}

.pill-mppt{color:#2563eb}

.pill-pwm{color:#b45309}

/* ===== final-no-extra-regulator-table-style ===== */
/* Finální oprava: žádná spodní tabulka/prohlížeč regulátorů – jen jeden select s optgroup MPPT/PWM. */
#regulatorTypeBrowser{display:none!important}

/* ===== regulator-current-white-surface-border-only-final ===== */
/* Proud zvoleného regulátoru [A]: při validaci zůstává plocha vždy bílá,
mění se pouze barva rámečku. */
#regulatorCurrentA{
  background:#ffffff !important;
  background-color:#ffffff !important;
  color:#000000 !important;
  -webkit-text-fill-color:#000000 !important;
  opacity:1 !important;
}

/* ===== component-feed-same-as-regulator-final ===== */
.component-feed-picker{
  border:1px solid var(--line,#d1d5db)!important;
  border-radius:16px!important;
  background:#ffffff!important;
  color:#000000!important;
  padding:10px!important;
}

.component-feed-picker label{
  color:#111827!important;
  font-weight:800!important;
}

.component-feed-picker select{
  background:#ffffff!important;
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
  border:1px solid #9ca3af!important;
  border-radius:14px!important;
  min-height:46px!important;
  font-weight:800!important;
  text-align:center!important;
  text-align-last:center!important;
  box-shadow:none!important;
  opacity:1!important;
}

.component-feed-picker select.component-feed-loaded{border-color:#cbd5e1!important;}

.component-feed-picker select.component-feed-warn{border-color:var(--warn,#b45309)!important;}

.component-feed-picker select.component-feed-empty{border-color:#9ca3af!important;}

.component-feed-picker select option{background:#ffffff!important;color:#000000!important;}

.component-feed-picker .small{
  color:#4b5563!important;
  margin-top:7px!important;
  line-height:1.35!important;
}

.component-feed-card{
  display:grid!important;
  grid-template-columns:92px minmax(0,1fr)!important;
  gap:10px!important;
  margin-top:10px!important;
  padding:10px!important;
  border:1px solid #cbd5e1!important;
  border-radius:14px!important;
  background:#ffffff!important;
  color:#000000!important;
  box-shadow:none!important;
}

.component-feed-card.component-feed-card-ok{border-color:var(--ok,#047857)!important;}

.component-feed-card.component-feed-card-warn{border-color:var(--warn,#b45309)!important;}

.component-feed-img{width:92px!important;height:92px!important;background:#ffffff!important;border:1px solid #e5e7eb!important;border-radius:12px!important;}

.component-feed-title{font-weight:900!important;color:#000000!important;line-height:1.2!important;}

.component-feed-meta{font-size:12px!important;color:#4b5563!important;line-height:1.25!important;margin:4px 0 7px!important;}

.component-feed-grid{display:grid!important;grid-template-columns:repeat(auto-fit,minmax(118px,1fr))!important;gap:6px!important;}

.component-feed-param{border:1px solid #e5e7eb!important;border-radius:10px!important;padding:6px!important;background:#ffffff!important;}

.component-feed-param span{display:block!important;font-size:11px!important;color:#64748b!important;}

.component-feed-param b{display:block!important;font-size:13px!important;color:#000000!important;}

.component-feed-status{
  margin-top:8px!important;
  padding:8px 10px!important;
  border-radius:999px!important;
  border:1px solid currentColor!important;
  font-weight:900!important;
  text-align:center!important;
}

.component-feed-status-ok{color:var(--ok,#047857)!important;background:rgba(4,120,87,.06)!important;}

.component-feed-status-warn{color:var(--warn,#b45309)!important;background:rgba(180,83,9,.06)!important;}

@media(max-width:700px){
.component-feed-card{grid-template-columns:1fr!important}

.component-feed-img{width:100%!important;height:120px!important}
}

/* ===== component-feed-left-and-regulator-card-final ===== */
