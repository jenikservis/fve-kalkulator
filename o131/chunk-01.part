.system-type-wrap,
.typ-systemu-wrap{
  justify-content:flex-start!important;
  text-align:left!important;
  align-items:flex-start!important;
  background:#ffffff!important;
}

.system-type-wrap *,
.typ-systemu-wrap *{
  text-align:left!important;
}

/* Bílé pozadí plochy Typ systému */
select[id*="system"],
select[name*="system"]{
  background:#ffffff!important;
  color:#000000!important;
}

/* Typ systému – zarovnání textu v poli i v rozbalené nabídce vlevo */
#systemType,
#systemMode,
select[name="systemType"],
select[name="systemMode"],
select[id*="system" i],
select[name*="system" i]{
  text-align:left!important;
  text-align-last:left!important;
  padding-left:14px!important;
  background:#ffffff!important;
  color:#000000!important;
  appearance:auto!important;
  -webkit-appearance:menulist!important;
}

#systemType option,
#systemMode option,
select[name="systemType"] option,
select[name="systemMode"] option,
select[id*="system" i] option,
select[name*="system" i] option{
  text-align:left!important;
  background:#ffffff!important;
  color:#000000!important;
}

/* Modal pro export projektu */
.project-export-grid{
  display:grid;
  gap:10px;
}

.project-export-grid label{
  margin-top:0;
}

.project-export-actions{
  display:flex;
  gap:10px;
  justify-content:flex-end;
  margin-top:12px;
}

.project-export-actions button{
  width:auto;
  min-width:150px;
}

.project-export-note{
  margin-top:8px;
  padding:9px 10px;
  border:1px solid var(--line);
  border-radius:12px;
  background:var(--card-soft,#f8fafc);
}

@media(max-width:700px){
.project-export-actions{display:grid;grid-template-columns:1fr;}

.project-export-actions button{width:100%;}
}


html input,
html select,
html textarea{
  color:#111827 !important;
  -webkit-text-fill-color:#111827 !important;
  opacity:1 !important;
}

.profi-main-evaluation{margin-top:12px;padding-top:12px;border-top:1px solid var(--line);}

.profi-main-evaluation .calc-highlight{margin-bottom:8px!important;}

@media print{
.profi-main-evaluation{margin-top:5px!important;padding-top:5px!important;border-top:1px solid #ccc!important;}
}

/* Přehledné uspořádání rozklikávacích Podrobností systému */
.system-details-layout{
  display:grid;
  grid-template-columns:1fr;
  gap:14px;
}

.details-section{
  background:var(--card,#fff);
  border:1px solid var(--line,#d1d5db);
  border-radius:18px;
  padding:14px;
  box-shadow:0 6px 18px rgba(15,23,42,.06);
}

.details-section h3{
  margin:0 0 10px!important;
  font-size:16px;
  letter-spacing:-.01em;
}

.details-kpi-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(170px,1fr));
  gap:10px;
}

.details-kpi{
  border:1px solid var(--line,#d1d5db);
  border-radius:15px;
  padding:10px 12px;
  background:linear-gradient(180deg,var(--card,#fff),var(--card-soft,#f8fafc));
}

.details-kpi span{
  display:block;
  font-size:12px;
  color:var(--muted,#4b5563);
  margin-bottom:5px;
  font-weight:700;
}

.details-kpi b{
  display:block;
  font-size:20px;
  line-height:1.15;
  color:var(--text,#111827);
  overflow-wrap:anywhere;
}

.details-table{
  width:100%;
  border-collapse:separate!important;
  border-spacing:0!important;
  border:1px solid var(--line,#d1d5db)!important;
  border-radius:14px!important;
  overflow:hidden;
  table-layout:fixed;
}

.details-table td{
  padding:10px 12px!important;
  border-bottom:1px solid var(--line-soft,#e5e7eb)!important;
  vertical-align:top;
}

.details-table tr:last-child td{border-bottom:none!important;}

.details-table td:first-child{
  width:42%;
  color:var(--muted,#4b5563);
  font-weight:700;
  text-align:left!important;
}

.details-table td:last-child{
  text-align:right!important;
  font-weight:800;
  color:var(--text,#111827);
}

.details-message-box{
  border:1px solid var(--line,#d1d5db);
  border-radius:14px;
  padding:10px 12px;
  background:var(--card-soft,#f8fafc);
  min-height:42px;
  line-height:1.4;
}

.details-message-box ul{margin:0;padding-left:18px;}

@media(max-width:700px){
.details-section{padding:11px;border-radius:15px;}

.details-kpi-grid{grid-template-columns:1fr 1fr;gap:8px;}

.details-kpi{padding:9px;}

.details-kpi b{font-size:16px;}

.details-table td{display:block;width:100%!important;text-align:left!important;padding:8px 10px!important;}

.details-table td:last-child{padding-top:0!important;}
}

@media print{
.system-details-layout{gap:6px!important;}

.details-section{box-shadow:none!important;border:1px solid #ccc!important;padding:6px!important;border-radius:6px!important;}

.details-kpi-grid{grid-template-columns:repeat(4,1fr)!important;gap:4px!important;}

.details-kpi{padding:5px!important;border-radius:5px!important;background:#fff!important;}

.details-kpi span{font-size:7.5px!important;color:#333!important;}

.details-kpi b{font-size:10px!important;color:#000!important;}

.details-table td{font-size:8px!important;padding:3px!important;display:table-cell!important;}
}

/* Kompaktní rozložení Podrobností systému */
.customer-summary-compact-note{
  margin-top:8px;
  padding:8px 10px;
  border:1px solid var(--line,#d1d5db);
  border-radius:12px;
  background:var(--card-soft,#f8fafc);
}

.details-compact-section{
  padding:12px!important;
}

.details-compact-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:10px;
  align-items:start;
}

.details-mini-table td{
  padding:7px 10px!important;
}

.details-mini-table td:first-child{
  width:46%!important;
  font-size:12px!important;
}

.details-mini-table td:last-child{
  font-size:13px!important;
  font-weight:850!important;
}

.details-compact-note{
  margin-top:8px;
  padding:7px 9px;
  border-radius:10px;
  background:rgba(148,163,184,.10);
}

@media(max-width:700px){
.details-compact-grid{grid-template-columns:1fr;gap:8px;}

.details-mini-table td{display:table-cell!important;width:auto!important;text-align:left!important;padding:7px 8px!important;}

.details-mini-table td:last-child{text-align:right!important;padding-top:7px!important;}
}

@media print{
.details-compact-grid{grid-template-columns:1fr 1fr!important;gap:4px!important;}

.details-mini-table td{display:table-cell!important;padding:3px!important;font-size:8px!important;}

.customer-summary-compact-note{display:none!important;}
}


.pvgis-pulse,
.pvgis-pulse-glow,
.pvgis-feed-pulse,
.pvgis-loading-pulse{
  animation-duration:2.8s!important;
  animation-timing-function:ease-in-out!important;
}

.pvgis-pulse.finished,
.pvgis-pulse.idle,
.pvgis-feed-pulse.finished,
.pvgis-feed-pulse.idle,
.pvgis-loading-pulse.finished,
.pvgis-loading-pulse.idle{
  box-shadow:0 8px 20px rgba(0,0,0,.30),0 0 13px rgba(127,29,29,.42)!important;
  filter:saturate(.62)!important;
}

/* FINÁLNÍ OPRAVA – celý software */
.pvgis-pulse,
.pvgis-pulse-glow,
.pvgis-feed-pulse,
.pvgis-loading-pulse{
  animation-duration:2.8s!important;
  animation-timing-function:ease-in-out!important;
}

.pvgis-pulse.finished,
.pvgis-pulse.idle,
.pvgis-feed-pulse.finished,
.pvgis-feed-pulse.idle,
.pvgis-loading-pulse.finished,
.pvgis-loading-pulse.idle{
  box-shadow:0 8px 20px rgba(0,0,0,.30),0 0 13px rgba(127,29,29,.42)!important;
  filter:saturate(.62)!important;
}

/* Oprava: ve světlém režimu po doběhnutí mezicyklu zůstává černý text v bílém poli */
html .pvgis-pulse.finished,
html .pvgis-pulse.idle,
html .pvgis-feed-pulse.finished,
html .pvgis-feed-pulse.idle,
html .pvgis-loading-pulse.finished,
html .pvgis-loading-pulse.idle{
  color:#000000!important;
}

html .pvgis-pulse.finished *,
html .pvgis-pulse.idle *,
html .pvgis-feed-pulse.finished *,
html .pvgis-feed-pulse.idle *,
html .pvgis-loading-pulse.finished *,
html .pvgis-loading-pulse.idle *{
  color:#000000!important;
}

/* ===== final-map-fix ===== */
.protocol-map-img,
.protocol-map-frame,
.protocol-map-static{
  height:240px!important;
  max-height:240px!important;
}

@media print{
body.print-protocol #printProtocolPage .protocol-map-img,
body.print-protocol #printProtocolPage .protocol-map-frame,
body.print-protocol #printProtocolPage .protocol-map-static,
#printProtocolPreviewClone .protocol-map-img,
#printProtocolPreviewClone .protocol-map-frame,
#printProtocolPreviewClone .protocol-map-static{
    height:240px!important;
    max-height:240px!important;
  }
}

/* ===== protocol-2page-fix ===== */
@media print{
  body.print-protocol #printProtocolPage{
    height:auto!important;
    overflow:visible!important;
  }

  body.print-protocol .protocol-box,
  body.print-protocol .protocol-chart-card,
  body.print-protocol .protocol-charts{
    break-inside:auto!important;
    page-break-inside:auto!important;
  }

  body.print-protocol .protocol-chart-img{
    display:block!important;
    width:100%!important;
    height:auto!important;
    min-height:260px!important;
    max-height:none!important;
    object-fit:contain!important;
  }

  body.print-protocol .chart-box,
  body.print-protocol canvas{
    max-height:none!important;
  }
}

/* ===== restore-original-chart-size ===== */
.protocol-charts{
  display:grid!important;
  grid-template-columns:1fr 1fr!important;
  gap:12px!important;
}

.protocol-chart-card{
  min-height:320px!important;
  padding:10px!important;
}

.protocol-chart-img{
  width:100%!important;
  min-height:260px!important;
  max-height:none!important;
  object-fit:contain!important;
}

@media print{
body.print-protocol .protocol-charts{
    grid-template-columns:1fr 1fr!important;
    gap:10px!important;
  }

body.print-protocol .protocol-chart-card{
    min-height:320px!important;
    padding:8px!important;
  }

body.print-protocol .protocol-chart-img{
    width:100%!important;
    min-height:260px!important;
    max-height:none!important;
    object-fit:contain!important;
  }
}

/* ===== final-protocol-layout-fix ===== */
/* mapa v protokolu */
.protocol-map-img,
.protocol-map-frame,
.protocol-map-static{
  height:240px!important;
  max-height:240px!important;
}

/* protokol může mít více stran */
@media print{
  body.print-protocol .protocol-box,
  body.print-protocol .protocol-chart-card,
  body.print-protocol .protocol-charts{
    break-inside:auto!important;
    page-break-inside:auto!important;
  }
}

/* velikost grafů jako původní software */
.protocol-charts{
  display:grid!important;
  grid-template-columns:1fr 1fr!important;
  gap:8px!important;
  align-items:start!important;
}

.protocol-chart-card{
  border:1px solid #cccccc!important;
  border-radius:6px!important;
  padding:6px!important;
  background:#ffffff!important;
  min-height:auto!important;
}

.protocol-chart-img{
  display:block!important;
  width:100%!important;
  height:auto!important;
  min-height:0!important;
  max-height:none!important;
  object-fit:contain!important;
}

@media print{
body.print-protocol .protocol-charts{
    display:grid!important;
    grid-template-columns:1fr 1fr!important;
    gap:8px!important;
  }

body.print-protocol .protocol-chart-card{
    padding:6px!important;
    min-height:auto!important;
  }

body.print-protocol .protocol-chart-img{
    width:100%!important;
    height:auto!important;
    min-height:0!important;
    max-height:none!important;
    object-fit:contain!important;
  }
}

/* ===== graphs-directly-under-cables-print-fix ===== */
@media print{
  /* Grafy mají v protokolu následovat hned po bloku Kabely a jištění, bez nuceného zalomení na další stranu. */
  body.print-protocol #printProtocolPage .protocol-graphs-box,
  body.print-protocol #printProtocolPage .protocol-graphs-page{
    page-break-before:auto!important;
    break-before:auto!important;
    margin-top:0!important;
  }

  body.print-protocol #printProtocolPage .protocol-graphs-box .protocol-charts,
  body.print-protocol #printProtocolPage .protocol-graphs-page .protocol-charts{
    page-break-before:auto!important;
    break-before:auto!important;
    margin-top:0!important;
  }

  body.print-protocol #printProtocolPage .protocol-graphs-box,
  body.print-protocol #printProtocolPage .protocol-graphs-box .protocol-chart-card,
  body.print-protocol #printProtocolPage .protocol-graphs-page,
  body.print-protocol #printProtocolPage .protocol-graphs-page .protocol-chart-card{
    break-inside:auto!important;
    page-break-inside:auto!important;
  }

  body.print-protocol #printProtocolPage .protocol-graphs-box .protocol-chart-img,
  body.print-protocol #printProtocolPage .protocol-graphs-page .protocol-chart-img{
    width:100%!important;
    height:auto!important;
    max-height:none!important;
    object-fit:contain!important;
  }
}

/* ===== bms-only-lifepo-style ===== */
.bms-hidden-for-non-lifepo{
  display:none!important;
}

/* ===== v5-clean-heading-style ===== */
/* Verze 1 – čisté sjednocené zvýraznění nadpisů bez duplicitních CSS bloků.
   Výsledky a Podrobnosti systému jsou bez boční odrážky podle posledního zadání. */
body > h2,
.card > h2,
.card > h3,
.merged-card-section > h3,
.subpage-header > h2,
#monthBlock > h3,
#cableOut h4,
.month-card-title,
.protocol-box h3{
  border-left:4px solid #000000!important;
  padding-left:10px!important;
  font-weight:850!important;
  -webkit-print-color-adjust:exact!important;
  print-color-adjust:exact!important;
}

body > h2,
.card > h2,
.card > h3,
.merged-card-section > h3,
.subpage-header > h2,
#monthBlock > h3,
.protocol-box h3{
  background:rgba(244,246,248,.96)!important;
  color:#000000!important;
  border-radius:8px!important;
  padding-top:7px!important;
  padding-bottom:7px!important;
}

.protocol-box h3{
  border-bottom:1px solid #cbd5e1!important;
  margin:0 0 7px 0!important;
  font-size:12px!important;
  letter-spacing:.01em!important;
}

.protocol-title{
  padding:5px 0 7px!important;
  border-bottom:2px solid #111827!important;
  margin-bottom:7px!important;
}

/* Výjimka podle zadání: hlavní nadpis Výsledky bez boční odrážky. */
#resultsTitle{
  border-left:none!important;
  padding-left:0!important;
  background:transparent!important;
  color:var(--text,#111827)!important;
  border-radius:0!important;
}

/* Vnitřní nadpisy Regulátor / Baterie / Měnič / Kabely ve výsledkové tabulce zůstávají zvýrazněné. */
#regOut table th[colspan="2"]{
  background:rgba(244,246,248,.96)!important;
  color:#000000!important;
  border-left:4px solid #000000!important;
  text-align:left!important;
  font-weight:900!important;
  font-size:14px!important;
  padding:8px 10px!important;
  letter-spacing:.01em!important;
}

@media print{
body > h2,
.card > h2,
.card > h3,
.merged-card-section > h3,
.subpage-header > h2,
#monthBlock > h3,
#cableOut h4,
.month-card-title,
.protocol-box h3,
#regOut table th[colspan="2"]{
    border-left:3px solid #000000!important;
    background:#f3f4f6!important;
    color:#000000!important;
    border-radius:4px!important;
    -webkit-print-color-adjust:exact!important;
    print-color-adjust:exact!important;
  }

#resultsTitle{
    border-left:none!important;
    background:transparent!important;
    color:#000000!important;
    border-radius:0!important;
    padding-left:0!important;
  }

body.print-protocol #printProtocolPage .protocol-title{
    border-bottom:2px solid #000000!important;
    margin-bottom:5px!important;
  }
}

/* Verze 1 – sjednocený jemný vzhled akčních/otevíracích tlačítek
   Cíl: stejný font a klidný styl jako u tlačítka „Otevřít SOC baterie a graf nabití“.
   Platí i pro tlačítka v náhledu Tisk/PDF. */
.action-light-btn,
button.action-light-btn,
a.action-light-btn,
.open-panel-btn,
.subpage-close-btn,
.soc-open-btn button.secondary,
a[href*="pvg_tools"].buttonlink,
button[onclick="autoDesignStrings()"],
button[onclick="autoBattery()"],
#pdfPreviewModal .modal-actions button,

.open-panel-btn,
.subpage-close-btn{
  margin:0!important;
}

.action-light-btn:hover,
button.action-light-btn:hover,
a.action-light-btn:hover,
.open-panel-btn:hover,
.subpage-close-btn:hover,
.soc-open-btn button.secondary:hover,
a[href*="pvg_tools"].buttonlink:hover,
button[onclick="autoDesignStrings()"]:hover,
button[onclick="autoBattery()"]:hover,
#pdfPreviewModal .modal-actions button:hover,

html .action-light-btn,
html button.action-light-btn,
html a.action-light-btn,
html .open-panel-btn,
html .subpage-close-btn,
html .soc-open-btn button.secondary,
html a[href*="pvg_tools"].buttonlink,
html button[onclick="autoDesignStrings()"],
html button[onclick="autoBattery()"],
html #pdfPreviewModal .modal-actions button,
body.print-preview-open #pdfPreviewModal .modal-actions button{
  background:#ffffff!important;
  color:#111827!important;
  border-color:#d1d5db!important;
  box-shadow:0 2px 8px rgba(15,23,42,.08)!important;
}

html .action-light-btn:hover,
html button.action-light-btn:hover,
html a.action-light-btn:hover,
html .open-panel-btn:hover,
html .subpage-close-btn:hover,
html .soc-open-btn button.secondary:hover,
html a[href*="pvg_tools"].buttonlink:hover,
html button[onclick="autoDesignStrings()"]:hover,
html button[onclick="autoBattery()"]:hover,
html #pdfPreviewModal .modal-actions button:hover,
body.print-preview-open #pdfPreviewModal .modal-actions button:hover{
  background:#f8fafc!important;
  color:#111827!important;
  border-color:#cbd5e1!important;
}

