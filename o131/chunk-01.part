#printCustomerStep,
html #printCustomerStep{
  background:#ffffff !important;
  color:#000000 !important;
  border:1px solid #cbd5e1 !important;
  border-radius:14px !important;
  padding:12px !important;
  box-shadow:none !important;
}

#printCustomerStep *,
html #printCustomerStep *{
  color:#000000 !important;
  text-shadow:none !important;
}

#printCustomerStep h3{
  color:#000000 !important;
  border-bottom:1px solid #111827 !important;
  padding-bottom:8px !important;
  margin:0 0 10px 0 !important;
  font-size:18px !important;
}

#printCustomerStep label,
#printCustomerStep p,
#printCustomerStep .small{
  color:#334155 !important;
}

#printCustomerStep .print-customer-grid{
  display:grid !important;
  grid-template-columns:1fr 1fr !important;
  gap:12px !important;
  background:#ffffff !important;
}

#printCustomerStep .print-customer-grid .full-row{
  grid-column:1 / -1 !important;
}

#printCustomerStep input,
html #printCustomerStep input{
  background:#ffffff !important;
  background-color:#ffffff !important;
  color:#000000 !important;
  -webkit-text-fill-color:#000000 !important;
  border:1px solid #cbd5e1 !important;
  border-radius:8px !important;
  box-shadow:none !important;
  outline:none !important;
  caret-color:#000000 !important;
}

#printCustomerStep input::placeholder{
  color:#64748b !important;
  opacity:1 !important;
  -webkit-text-fill-color:#64748b !important;
}

#printCustomerStep input[type="checkbox"]{
  appearance:none !important;
  -webkit-appearance:none !important;
  width:18px !important;
  height:18px !important;
  min-width:18px !important;
  min-height:18px !important;
  margin:0 !important;
  padding:0 !important;
  background:#ffffff !important;
  background-color:#ffffff !important;
  border:1px solid #94a3b8 !important;
  border-radius:6px !important;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.75) !important;
  outline:none !important;
  cursor:pointer !important;
  position:relative !important;
}

#printCustomerStep input[type="checkbox"]:checked{
  background:#ffffff !important;
  background-color:#ffffff !important;
  border-color:#64748b !important;
}

#printCustomerStep input[type="checkbox"]:checked::after{
  content:'' !important;
  position:absolute !important;
  left:4px !important;
  top:5px !important;
  width:9px !important;
  height:5px !important;
  background:transparent !important;
  border-left:1.45px solid #111827 !important;
  border-bottom:1.45px solid #111827 !important;
  border-radius:1.5px !important;
  transform:rotate(-45deg) !important;
  transform-origin:center !important;
}

#printCustomerStep .print-customer-toggle{
  display:flex !important;
  align-items:center !important;
  gap:8px !important;
  color:#000000 !important;
  margin:8px 0 12px 0 !important;
}

/* celé modální okno Tisk/PDF nesmí přebarvit zákaznickou tabulku do tmavemu rezimu */
#pdfPreviewModal .modal{
  background:#ffffff !important;
  color:#000000 !important;
}

@media(max-width:700px){
#printCustomerStep .print-customer-grid{
    grid-template-columns:1fr !important;
  }
}

/* Layout konfigurátoru – požadované pořadí */
.custom-config-layout{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.custom-top-row{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:14px;
  align-items:start;
}

.custom-top-row > .card{
  margin-bottom:0!important;
}

.custom-config-layout > .card{
  width:100%;
}

@media(max-width:1200px){
.custom-top-row{
    grid-template-columns:1fr;
  }
}

/* Měnič: tabulka a výběr z feedu vedle sebe */
.inverter-inline-layout{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) minmax(320px,0.72fr)!important;
  gap:14px!important;
  align-items:start!important;
}

.inverter-feed-panel{
  border:1px solid var(--line)!important;
  border-radius:14px!important;
  padding:12px!important;
  background:var(--card-soft,#f8fafc)!important;
}

@media(max-width:1100px){
.inverter-inline-layout{
    grid-template-columns:1fr!important;
  }
}

/* Systémové napětí přesunuté pod tabulku Měnič */
.inverter-main-panel > .card{
  margin-top:14px!important;
  margin-bottom:0!important;
}

/* OPRAVA ROZLOŽENÍ: FV pole / Baterie / Regulátor – výběr z feedu vpravo ve stejné řadě
   a se STEJNOU ŠÍŘKOU jako výběr z feedu u měniče */
.component-inline-card > .component-inline-layout{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) minmax(320px,0.72fr)!important;
  gap:14px!important;
  align-items:start!important;
}

.component-inline-card .component-main-panel,
.component-inline-card .component-feed-panel{
  min-width:0!important;
}

.component-inline-card .component-feed-panel{
  border:1px solid var(--line)!important;
  border-radius:14px!important;
  padding:12px!important;
  background:var(--card-soft,#f8fafc)!important;
  box-sizing:border-box!important;
}

.component-inline-card .component-feed-panel .component-feed-picker{
  margin-top:0!important;
}

.component-inline-card .component-feed-picker label:first-child{
  margin-top:0!important;
}

.component-inline-card .component-feed-picker select{
  width:100%!important;
}

@media(max-width:1100px){
.component-inline-card > .component-inline-layout{
    grid-template-columns:1fr!important;
  }
}

@media print{
.component-inline-card > .component-inline-layout{
    display:block!important;
  }

.component-inline-card .component-feed-panel{
    border:0!important;
    padding:0!important;
    background:#fff!important;
  }
}

/* ===== FINAL FIX: výběr z feedu – regulátor bez dvojitých rámečků a nižší výška =====
   Regulátor měl navíc starší vlastní rámečky na #regulatorFeedPicker a #feedRegulatorSelect.
   Tady se přebije jen regulátorový výběr,
aby vypadal stejně čistě jako ostatní výběry z feedu. */
