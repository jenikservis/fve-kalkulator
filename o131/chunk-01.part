<style id="fve-krok-51-restore-original-cable-page-style">
/* KROK 51: původní rozkrývací tabulky kabelů a jištění obnovené jako samostatný panel. */
html body:not(.print-protocol) #cablePage{
  position:fixed!important;
  inset:0!important;
  z-index:10050!important;
