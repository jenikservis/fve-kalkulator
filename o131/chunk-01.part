/* VERZE 275: přehledné severity validace */
.validation-errors-box,
.validation-warnings-box,
.validation-recommendations-box{
  border-left:4px solid var(--line);
}
.validation-errors-box{border-left-color:var(--bad)!important;}
.validation-warnings-box{border-left-color:var(--warn)!important;}
.validation-recommendations-box{border-left-color:var(--ok)!important;}
.validation-status-pill{
  display:inline-block;
  margin-top:6px;
  padding:5px 9px;
  border-radius:999px;
  border:1px solid currentColor;
  font-size:12px;
  font-weight:800;
}
.calc-value.warn{color:var(--warn)!important}
.customer-summary-note .validation-status-pill{margin-right:6px;}
</style>
<!-- VERZE 38: návrat na stabilní jádro verze 35; opraven startovací dialog a přístup k MENU bez agresivního čištění CSS. -->
<!-- FINAL FIX 2026-06-01: verze 5 - Tisk/PDF nesmi zablokovat start-lock a validacni bunky musi zustat barevne -->
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>FVE konfigurátor K7L – funkční centrální feed okno</title>
<!-- VERZE 66: oprava syntaktických chyb ve vložených skriptech a sjednocení označení verze. -->
<meta content="#f4f6f8" name="theme-color"/>
<meta content="yes" name="apple-mobile-web-app-capable"/>
<meta content="default" name="apple-mobile-web-app-status-bar-style"/>
<meta content="FVE konfigurátor" name="apple-mobile-web-app-title"/>
<script id="static-light-theme-only">
(function(){
  document.documentElement.removeAttribute('data-theme');
  document.documentElement.style.colorScheme = 'light';
  document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#f4f6f8');
})();
</script>
<!-- Oprava: v hlavní kartě Vyhodnocení systému nejsou duplicitně zobrazené KPI hodnoty; zůstávají jen v rozklikávacích Podrobnostech systému. -->
<!-- Finální upravená verze: údaje zákazníka v Tisk/PDF nad mapou, sjednocené hlavičky protokolu. -->
<!-- Úprava: pokročilé technické hodnoty jsou viditelné v UI; SOC a řízení baterie zůstávají dostupné v sekci Baterie. -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
<script>
if (window.Chart) {
  Chart.defaults.elements.bar.borderRadius = 0;
  Chart.defaults.elements.bar.borderSkipped = false;
}
</script>
<link href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" rel="stylesheet"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-image@0.4.0/leaflet-image.js"></script>
<script id="complete-graphs-section-second-page-runtime">
function markProtocolGraphsPage(){
  document.querySelectorAll('.protocol-box').forEach(function(box){
    var title = (box.querySelector('h3') || box.querySelector('h2'));
    if(title && title.textContent.trim().toLowerCase() === 'grafy'){
      box.classList.add('protocol-graphs-page');
    }
    if(box.querySelector('.protocol-charts')){
      box.classList.add('protocol-graphs-page');
    }
  });
}
document.addEventListener('DOMContentLoaded', markProtocolGraphsPage);
window.addEventListener('beforeprint', markProtocolGraphsPage);
</script>
<script id="poloha-prvni-krok-js">
function focusMapForLocation(){
  const wrap=document.getElementById('mapWrap');
  const map=document.getElementById('map');
  if(wrap){
    wrap.scrollIntoView({behavior:'smooth',block:'center'});
    wrap.classList.remove('guide-map-pulse');
    void wrap.offsetWidth;
    wrap.classList.add('guide-map-pulse');
    setTimeout(()=>wrap.classList.remove('guide-map-pulse'),3400);
  }else if(map){
    map.scrollIntoView({behavior:'smooth',block:'center'});
  }
}
</script>
<!-- PWM AUDIT:
Profesionální logika PWM:
1) proud regulátoru = Isc panelu × paralelní stringy × 1,25;
2) Voc za mrazu nesmí překročit max. Voc regulátoru;
3) Vmp stringu musí být přizpůsobeno baterii, ne MPPT oknu;
4) měsíční výroba PWM je krácena koeficientem batt.regulatorV / VmpString;
5) doporučení stringu používá pro PWM ideální poměr Vmp/absorpční napětí cca 1,25.
-->
<!-- Údržba 2026-05-17: oprava labelu feedu, validní umístění stylu v head, robustnější parser čísel, doplněné souhrnné KPI prvky a workflow info. -->
<!-- FINAL DARK MODE READABILITY OVERRIDE – oprava nečitelných přepisů -->
<!-- Čistá verze: regulátorová pole nejsou předvyplněná; feed se načítá až ručním importem. -->
<!-- ULTRA PROTOKOL UPGRADE -->
<script>
