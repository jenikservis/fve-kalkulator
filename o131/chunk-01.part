<style id="fve-krok-57-results-reorder-and-summary-fix">
/* KROK 57: výsledkové karty bez číslování, nové pořadí a opravené Vyhodnocení systému. */
html body:not(.print-protocol) :is(#customerSummaryCard,#wWaterEvaluation){
  display:block!important;
  margin:14px 0 10px!important;
  padding:14px 16px!important;
  border:1px solid #c46a1c!important;
  border-left:6px solid #c46a1c!important;
  border-radius:18px!important;
  background:#ffffff!important;
  box-shadow:none!important;
  font-family:Arial,sans-serif!important;
}

html body:not(.print-protocol) #customerSummaryCard.summary-warn{
  border-color:#b45309!important;
  border-left-color:#b45309!important;
}

html body:not(.print-protocol) #customerSummaryCard.summary-bad{
  border-color:#b91c1c!important;
  border-left-color:#b91c1c!important;
}

