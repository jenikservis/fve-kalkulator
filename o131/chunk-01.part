  box-shadow:none!important;
}

.standalone-feed-card-regulator-inline-card #regulatorFeedPicker{
  margin:0!important;
  padding:0!important;
  border:0!important;
  border-radius:0!important;
  background:transparent!important;
  box-shadow:none!important;
  color:var(--text,#111827)!important;
  -webkit-text-fill-color:currentColor!important;
}

.standalone-feed-card-regulator-inline-card #regulatorFeedPicker label{
  margin:0 0 4px 0!important;
  color:var(--muted,#4b5563)!important;
  -webkit-text-fill-color:var(--muted,#4b5563)!important;
  font-size:13px!important;
  font-weight:700!important;
  line-height:1.15!important;
}

.standalone-feed-card-regulator-inline-card #feedRegulatorSelect,
.standalone-feed-card-regulator-inline-card #regulatorFeedPicker #feedRegulatorSelect{
  width:100%!important;
  min-height:38px!important;
  height:38px!important;
  margin:0!important;
  padding:6px 10px!important;
  border:1px solid #9ca3af!important;
  border-radius:12px!important;
  background:#ffffff!important;
  background-color:#ffffff!important;
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
  box-shadow:none!important;
  font-size:14px!important;
  font-weight:800!important;
  line-height:1.15!important;
  text-align:left!important;
  text-align-last:left!important;
  appearance:auto!important;
  -webkit-appearance:menulist!important;
}

.standalone-feed-card-regulator-inline-card #feedRegulatorSelect option{
  background:#ffffff!important;
  color:#000000!important;
  -webkit-text-fill-color:#000000!important;
}

.standalone-feed-card-regulator-inline-card #selectedRegulatorCard{
