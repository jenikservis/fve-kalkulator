<style id="logical-detailed-results-layout-final-style">
.logical-results-grid{align-items:start!important;}
.logical-result-card h3{margin-top:0!important;}
.logical-result-card table th[colspan="2"]{background:#f8fafc!important;color:#111827!important;font-weight:800!important;text-align:left!important;}
.logical-result-card .calc-highlight{margin-bottom:8px!important;}
.result-battery-card .calc-metric::before{background:linear-gradient(90deg,var(--ok),rgba(4,120,87,.18))!important;}
.result-inverter-card .calc-metric::before{background:linear-gradient(90deg,var(--blue),rgba(37,99,235,.18))!important;}
.result-cables-card{margin-top:0!important;}
