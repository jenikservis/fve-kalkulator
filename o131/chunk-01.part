<style id="v65-clean-start-choice-base-css">
/* VERZE 65: čistý stabilní start bez starých anti-flicker/modal přepisů */
html,body{scroll-behavior:auto!important;}
#feedChoiceModal,#feedChoiceModal *,#feedChoiceModal *::before,#feedChoiceModal *::after{animation:none!important;transition:none!important;}
#feedChoiceModal{color-scheme:light!important;}
body.feed-start-locked{overflow:hidden!important;}
</style>
<style id="fve-clean-input-neutral-authority-css">
/* Čisté zadávání: vstupní pole nemají technickou validaci ani po přepočtu. */
html body:not(.print-protocol) input,
html body:not(.print-protocol) select,
html body:not(.print-protocol) textarea{
  border-color:#d1d5db!important;
  box-shadow:none!important;
  outline:0!important;
}
html body:not(.print-protocol) input:focus,
html body:not(.print-protocol) select:focus,
html body:not(.print-protocol) textarea:focus{
  border-color:#2563eb!important;
  box-shadow:none!important;
  outline:0!important;
}
</style>
<style id="fve-clean-start-unlock-css">
html:not(.fve-hard-booting) body > *{visibility:visible!important;opacity:1!important;pointer-events:auto!important;}
html:not(.fve-hard-booting) #fveStartupOverlay{display:none!important;}
body:not(.print-protocol) #feedChoiceModal:not(.v65-open){display:none!important;}
</style>
<style id="fve-clean-map-visual-visibility-css">
/* Čistá obnova vzhledu mapy a vizualizace bez validačních barev vstupů */
#mapWrap,#map,.energy-flow,.flow-box,.diagram-box,.chart-box{display:block;visibility:visible;}
.energy-flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;}
#map{min-height:330px;}
</style>
<style id="fve-remove-feed-filter-toolbar-final">
/* FINÁLNÍ ČISTKA: feed filtr/řazení se nesmí zobrazovat.
   Zůstává jen seznam/karty produktů, bez staré horní lišty. */
#feedCategory,
#feedSearch,
#feedSort,
.feed-toolbar,
.product-feed-toolbar,
.feed-filter-toolbar,
.feed-sort-toolbar{
  display:none!important;
