  min-height:0!important;
  max-height:0!important;
  margin:0!important;
  padding:0!important;
  border:0!important;
  overflow:hidden!important;
  pointer-events:none!important;
}
</style>
<style id="fve-14u-step5-blue-info-fields-css">
/* Krok 5: modrá informační pole jsou pouze textové/info bloky, bez validačního významu. */
