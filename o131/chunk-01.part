@media print{.logical-results-grid{grid-template-columns:1fr 1fr!important;gap:4px!important}.logical-result-card{break-inside:avoid!important;}}
</style>
<style id="fve-results-thin-validation-font-fix">
/* KROK 43: pouze výsledková část – sjednocené jemné písmo i pro barevně validované hodnoty.
